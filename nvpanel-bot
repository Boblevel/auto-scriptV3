def do_monitor(chat):
    up, ram, load = sys_info()
    ip = read_file("/etc/nvpanel/ip") or "?"
    dom = read_file("/etc/nvpanel/domain") or "non configur\u00e9"
    ssh = count_db("ssh"); vm = count_db("vmess"); vl = count_db("vless")
    tr = count_db("trojan"); ss = count_db("shadowsocks"); wg = count_db("wireguard")
    l2 = count_db("l2tp"); pp = count_db("pptp"); st = count_db("sstp")
    hy_ct = count_db("hysteria")
    total = ssh + vm + vl + tr + ss + wg + l2 + pp + st + hy_ct

    on_ssh = ssh_online()
    # Vmess/Vless/Trojan partagent la même façade nginx (Xray ne voit que
    # 127.0.0.1 en interne) : un seul total de clients uniques pour les
    # trois, comme dans le panel. Compté seulement si des comptes existent,
    # sinon un simple scan internet sur le port public compterait comme un
    # faux client.
    on_xray = xray_online() if (vm + vl + tr) > 0 else 0
    on_ss = port_online(8388) if ss > 0 else 0
    on_wg = wg_online()
    on_l2 = _int(ppp("online", "l2tp")); on_pp = _int(ppp("online", "pptp"))
    on_st = _int(ppp("online", "sstp"))
    # Hysteria2 (QUIC) : pas de comptage par session fiable, volontairement
    # exclu ici aussi (comme dans le panel) plutôt que d'afficher un faux
    # chiffre.
    total_on = on_ssh + on_xray + on_ss + on_wg + on_l2 + on_pp + on_st

    # Comptes verrouillés sur TOUS les protocoles, pas seulement SSH —
    # sinon ce total ne correspondait pas à celui du panel dès qu'un compte
    # d'un autre protocole était verrouillé.
    blocked = (ssh_blocked() + blocked_count("vmess") + blocked_count("vless")
               + blocked_count("trojan") + blocked_count("shadowsocks")
               + blocked_count("l2tp") + blocked_count("pptp") + blocked_count("sstp"))

    osn = os_name(); cpu = cores()
    hier, auj, mois = conso_raw()

    # La ligne de fermeture est ajoutée APRÈS coup (+=), jamais collée dans
    # le même tuple qu'un "* 23" : en Python, des littéraux adjacents comme
    # "...</code>\n\n" "\u2550" * 23 sont d'abord fusionnés en un seul
    # texte AVANT que "* 23" ne s'applique — ce qui répétait tout le bloc
    # (avec la balise </code>) 23 fois, du HTML invalide que Telegram
    # rejetait silencieusement : le bouton semblait ne "rien faire".
    txt = (
        "\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\n"
        "  \U0001F4CA <b>SURVEILLANCE</b>\n"
        "\u255A\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255D\n\n"
        "\U0001F5A5 <b>Serveur</b>\n"
        "<code>"
        "\u251C OS       %s\n"
        "\u251C IP       %s\n"
        "\u251C Domaine  %s\n"
        "\u251C Uptime   %s\n"
        "\u251C RAM      %s\n"
        "\u251C Core     %s\n"
        "\u2570 Charge   %s"
        "</code>\n\n"
        "\U0001F465 <b>Comptes</b>\n"
        "<code>"
        "\u251C Total     %d\n"
        "\u251C En ligne  %d\n"
        "\u2570 Bloqu\u00e9s   %d"
        "</code>\n\n"
        "\U0001F4CA <b>Consommation</b>\n"
        "<code>"
        "\u251C Hier         %s\n"
        "\u251C Aujourd'hui  %s\n"
        "\u2570 Ce mois      %s"
        "</code>\n\n"
    ) % (esc(osn), ip, dom, up, ram, cpu, load, total, total_on, blocked,
         hr(hier), hr(auj), hr(mois))
    txt += "\u2550" * 23
    send(chat, txt)

def do_list(chat):
    out = cli("list")
    rows = [l.split("|") for l in out.splitlines() if l.count("|") == 4] if out else []
    if not rows:
        send(chat, "\U0001F4CB <b>Comptes SSH</b>\n\n<i>Aucun compte pour le moment.</i>"); return
    blocks = []
    for p in rows:
        user, exp, dev, quota, etat = p[0], p[1], p[2], p[3], p[4]
        badge = "\U0001F534" if etat.startswith("verrou") else "\U0001F7E2"
        q = "illimit\u00e9" if quota in ("0", "") else quota + " Go"
        ct = conn_time(user)
        lignes = [
            "\u251C Expire     %s" % esc(fmt_date(exp)),
            "\u251C Appareils  %s" % dev,
            "\u251C Bandwidth  %s" % q,
        ]
        if ct:
            lignes.append("\u251C \u00c9tat       %s %s" % (badge, etat))
            lignes.append("\u2570 Connect\u00e9   %s" % esc(ct))
        else:
            lignes.append("\u2570 \u00c9tat       %s %s" % (badge, etat))
        blocks.append("\U0001F464 <b>%s</b>\n<code>%s</code>" % (esc(user), "\n".join(lignes)))
    send(chat, "\U0001F4CB <b>COMPTES SSH</b>  \u00b7  %d\n\n%s" % (len(rows), "\n\n".join(blocks)))

def do_xlist(chat, proto):
    out = cli("xlist", proto)
    rows = [l.split("|") for l in out.splitlines() if "|" in l] if (out and not out.startswith("ERR")) else []
    if not rows:
        send(chat, "\U0001F4CB <b>%s</b>\n\n<i>Aucun client pour le moment.</i>" % proto.upper(),
             kb=proto_kb(proto)); return
    blocks = []
    for p in rows:
        name = p[0]; exp = p[1] if len(p) > 1 else "?"
        etat = p[2] if len(p) > 2 else "actif"
        # 4e champ de xlist : durée d'activité mesurée via l'API de stats
        # Xray (échantillonnage du trafic par compte, pas des processus —
        # possible même si Xray multiplexe tout en 127.0.0.1). "\u2014" si
        # le compte est verrouillé ou inactif, exactement comme le panel.
        ct = p[3] if len(p) > 3 else "\u2014"
        badge = "\U0001F534" if etat.startswith("verrou") else "\U0001F7E2"
        lignes = ["\u251C Expire     %s" % esc(fmt_date(exp))]
        if ct and ct != "\u2014":
            lignes.append("\u251C \u00c9tat       %s %s" % (badge, etat))
            lignes.append("\u2570 Connect\u00e9   %s" % esc(ct))
        else:
            lignes.append("\u2570 \u00c9tat       %s %s" % (badge, etat))
        blocks.append("\U0001F464 <b>%s</b>\n<code>%s</code>" % (esc(name), "\n".join(lignes)))
    send(chat, "\U0001F4CB <b>%s</b>  \u00b7  %d\n\n%s" % (proto.upper(), len(rows), "\n\n".join(blocks)),
         kb=proto_kb(proto))

def handle_callback(chat, data):
    # Toute pression sur un bouton annule une action texte en attente,
    # où qu'on aille dans le menu — pas seulement via "Annuler" ou
    # "Menu". Les branches qui enchaînent sur une nouvelle action
    # (ex. "pa:", "hya"...) redéfinissent STATE[chat] juste après, donc
    # rien n'est perdu pour elles.
    STATE.pop(chat, None)
    if data == "menu":
        show_menu(chat); return
    if data == "cancel":
        send(chat, "\u274C Action annul\u00e9e.")
        return
    if data == "monitor":
        do_monitor(chat); return
    if data == "trial":
        send(chat, "<b>\U0001F381 Compte test 24 h</b>\nChoisis le protocole :", kb=trial_kb()); return
    if data == "purge":
        send(chat, "<b>\U0001F9F9 Purger les comptes expir\u00e9s</b>\nChoisis le protocole :", kb=purge_kb()); return
    if data.startswith("t:"):
        p = data[2:]
        if p == "ssh":
            n, pw = rand_name(), rand_pass()
            out = cli("create", n, pw, "1", "1", "0")
        elif p in ("l2tp", "pptp", "sstp"):
            n, pw = rand_name(), rand_pass()
            out = ppp("add", p, n, pw, "1")
        else:
            out = cli("xadd", p, rand_name(), "1")
        if out.startswith("OK"):
            _box, _key = split_dns_key("\n".join(out.split("\n")[1:]))
            send(chat, "<b>\u2705 Compte test 24 h cr\u00e9\u00e9</b>\n<pre>%s</pre>%s"
                 % (esc(_box), dns_key_line(_key)))
        else:
            send(chat, "\u274C \u00c9chec : <code>%s</code>" % esc(out))
        return
    if data.startswith("g:"):
        p = data[2:]
        out = ppp("purge", p, "expired") if p in ("l2tp", "pptp", "sstp") else cli("purge", p, "expired")
        n = out.split()[1] if out.startswith("OK") and len(out.split()) > 1 else "0"
        send(chat, "\U0001F9F9 <b>%s</b> : %s compte(s) expir\u00e9(s) supprim\u00e9(s)." % (p.upper(), n)); return
    if data.startswith("pp:"):
        p = data[3:]
        send(chat, "<b>%s</b> \u2014 choisis :" % p.upper(), kb=ppp_kb(p)); return
    if data.startswith("pl2:"):
        p = data[4:]
        rows = ppp("list", p)
        lignes = []
        for r in rows.split("\n"):
            if "|" not in r:
                continue
            nm, ex = r.split("|")[:2]
            lignes.append("%-16s %s" % (nm, fmt_date(ex)))
        send(chat, "<b>\U0001F4CB %s</b>\n<pre>%s</pre>" % (p.upper(), esc("\n".join(lignes) or "aucun compte"))); return
    if data.startswith("pa2:"):
        STATE[chat] = {"action": "pppadd", "proto": data[4:]}
        send(chat, "Envoie : <code>utilisateur motdepasse jours</code>", kb=cancel_kb()); return
    if data.startswith("pd2:"):
        STATE[chat] = {"action": "pppdel", "proto": data[4:]}
        send(chat, "Envoie le <b>nom</b> du compte \u00e0 supprimer :", kb=cancel_kb()); return
    if data.startswith("wg:"):
        try:
            with open("/etc/nvpanel/db/wireguard") as f:
                rows = [l.split() for l in f if l.startswith("### ")]
            lignes = []
            for r in rows:
                if len(r) <= 4:
                    continue
                ct = wg_time(r[2]) or "\u2014"
                lignes.append("%-16s %-14s %-12s %s" % (r[1], r[3], fmt_date(r[4]), ct))
            txt = "\n".join(lignes)
        except Exception:
            txt = ""
        send(chat, "<b>\U0001F6E1 WireGuard</b>\n<pre>%s</pre>" % esc(txt or "aucun client")); return
    if data == "hy:menu":
        send(chat, "<b>\u26A1 Hysteria2</b> \u2014 choisis :", kb=hy_kb()); return
    if data == "hyl":
        rows = hy("list")
        lignes = []
        for r in rows.split("\n"):
            if "|" not in r:
                continue
            nm, ex = r.split("|")[:2]
            lignes.append("%-16s %s" % (nm, fmt_date(ex)))
        send(chat, "<b>\U0001F4CB Hysteria2</b>\n<pre>%s</pre>" % esc("\n".join(lignes) or "aucun compte"), kb=hy_kb()); return
    if data == "hya":
        STATE[chat] = {"action": "hyadd"}
        send(chat, "Envoie : <code>utilisateur motdepasse jours</code>", kb=cancel_kb()); return
    if data == "hyd":
        STATE[chat] = {"action": "hydel"}
        send(chat, "Envoie le <b>nom</b> du compte \u00e0 supprimer :", kb=cancel_kb()); return
    if data == "list":
        do_list(chat); return
    if data == "status":
        send(chat, "<b>\U0001F5A5 \u00c9tat du serveur</b>\n<code>%s</code>" % cli("status")); return
    if data.startswith("p:"):
        p = data[2:]; send(chat, "<b>%s</b> - choisis :" % p.upper(), kb=proto_kb(p)); return
    if data.startswith("pl:"):
        do_xlist(chat, data[3:]); return
    if data.startswith("pa:"):
        STATE[chat] = {"action": "xadd", "proto": data[3:]}
        send(chat, "Envoie : <code>nom jours</code>  (ex : <code>client1 30</code>)", kb=cancel_kb()); return
    if data.startswith("pd:"):
        STATE[chat] = {"action": "xdel", "proto": data[3:]}
        send(chat, "Envoie le <b>nom</b> du client \u00e0 supprimer :", kb=cancel_kb()); return
    # Ces actions demandent d'abord SUR QUEL PROTOCOLE elles s'appliquent.
    if data in ("lock", "unlock", "renew"):
        titre = {"lock": "\U0001F512 Verrouiller un compte",
                 "unlock": "\U0001F513 D\u00e9verrouiller un compte",
                 "renew": "\u267B\uFE0F Prolonger un compte"}[data]
        pref = {"lock": "lk", "unlock": "ul", "renew": "rn"}[data]
        send(chat, "<b>%s</b>\n\nChoisis le protocole \U0001F447" % titre,
             kb=proto_choice_kb(pref)); return
    if data.startswith(("lk:", "ul:", "rn:")):
        act, _, proto = data.partition(":")
        nom = PROTO_NAME.get(proto, proto.upper())
        if act == "rn":
            STATE[chat] = {"action": "renewdo", "proto": proto}
            send(chat, "<b>\u267B\uFE0F Prolonger \u2014 %s</b>\n\n"
                       "Envoie : <code>nom jours</code>\nex : <code>client1 30</code>" % nom,
                 kb=cancel_kb())
        else:
            STATE[chat] = {"action": "lockdo" if act == "lk" else "unlockdo", "proto": proto}
            verbe = "verrouiller" if act == "lk" else "d\u00e9verrouiller"
            send(chat, "<b>%s \u2014 %s</b>\n\nEnvoie le <b>nom</b> du compte \u00e0 %s :"
                 % ("\U0001F512 Verrouiller" if act == "lk" else "\U0001F513 D\u00e9verrouiller", nom, verbe),
                 kb=cancel_kb())
        return

    prompts = {
        "create": "<b>Nouveau compte SSH</b>\n\n<code>nom motdepasse jours [appareils] [bandwidthGo]</code>\n\nex : <code>client1 pass123 30 2 50</code>\n<i>bandwidth en Go, 0 = illimit\u00e9</i>",
        "delete": "Nom du compte SSH \u00e0 supprimer :",
    }
    if data in prompts:
        STATE[chat] = {"action": data}
        send(chat, prompts[data], kb=cancel_kb())

def handle_text(chat, text):
    if text.strip().lower() in ("annuler", "cancel", "/annuler", "/cancel"):
        STATE.pop(chat, None)
        send(chat, "\u274C Action annul\u00e9e.")
        return
    st = STATE.pop(chat, None)
    if not st:
        show_menu(chat); return
    a = st["action"]; parts = text.split()
    if a == "create":
        if len(parts) < 3: send(chat, "Format : <code>nom motdepasse jours [appareils] [bandwidthGo]</code>"); return
        r = cli("create", *parts[:5])
        if r.startswith("OK"):
            # La fiche est reprise telle quelle du panel : même présentation
            # dans le bot et dans le terminal. esc() protège les caractères
            # spéciaux d'un mot de passe (<, >, &) qui casseraient l'affichage.
            box, key = split_dns_key("\n".join(r.splitlines()[1:]))
            send(chat, "\u2705 <b>Compte SSH cr\u00e9\u00e9</b>\n<pre>%s</pre>%s"
                 % (esc(box), dns_key_line(key)))
        else:
            send(chat, "\u274C %s" % r)
    elif a == "renewdo":
        # Prolongation, quel que soit le protocole choisi juste avant.
        p = st.get("proto", "ssh")
        if len(parts) < 2:
            send(chat, "Format : <code>nom jours</code>"); return
        if p == "ssh":
            r = cli("renew", parts[0], parts[1])
        elif p in ("l2tp", "pptp", "sstp"):
            r = ppp("renew", p, parts[0], parts[1])
        else:
            r = cli("xrenew", p, parts[0], parts[1])
        nom = PROTO_NAME.get(p, p.upper())
        if r.startswith("OK"):
            send(chat, "\u2705 <b>%s</b> \u2014 %s prolong\u00e9 jusqu'au %s"
                 % (nom, esc(parts[0]), esc(fmt_date(r.split()[-1]))))
        else:
            send(chat, "\u274C <b>%s</b> \u2014 %s" % (nom, esc(r)))
    elif a in ("lockdo", "unlockdo"):
        p = st.get("proto", "ssh")
        verrou = (a == "lockdo")
        if p == "ssh":
            r = cli("lock" if verrou else "unlock", parts[0])
        elif p in ("l2tp", "pptp", "sstp"):
            r = ppp("lock" if verrou else "unlock", p, parts[0])
        else:
            r = cli("xlock" if verrou else "xunlock", p, parts[0])
        nom = PROTO_NAME.get(p, p.upper())
        if r.startswith("OK"):
            send(chat, "%s <b>%s</b> \u2014 %s %s"
                 % ("\U0001F512" if verrou else "\U0001F513", nom, esc(parts[0]),
                    "verrouill\u00e9" if verrou else "d\u00e9verrouill\u00e9"))
        else:
            send(chat, "\u274C <b>%s</b> \u2014 %s" % (nom, esc(r)))
    elif a == "delete":
        r = cli("delete", parts[0])
        send(chat, ("\u2705 %s supprim\u00e9" % esc(parts[0])) if r.startswith("OK") else ("\u274C %s" % esc(r)))
    elif a == "pppadd":
        p = st["proto"]
        if len(parts) < 2:
            send(chat, "Format : utilisateur motdepasse jours"); return
        days = parts[2] if len(parts) > 2 else "30"
        r = ppp("add", p, parts[0], parts[1], days)
        if r.startswith("OK"):
            send(chat, "\u2705 Compte %s cr\u00e9\u00e9\n<pre>%s</pre>" % (p.upper(), esc("\n".join(r.splitlines()[1:]))))
        else:
            send(chat, "\u274C %s" % esc(r))
    elif a == "pppdel":
        r = ppp("del", st["proto"], parts[0])
        send(chat, ("\u2705 %s supprim\u00e9" % parts[0]) if r.startswith("OK") else ("\u274C %s" % esc(r)))
    elif a == "hyadd":
        if len(parts) < 2:
            send(chat, "Format : utilisateur motdepasse jours"); return
        days = parts[2] if len(parts) > 2 else "30"
        r = hy("add", parts[0], parts[1], days)
        if r.startswith("OK"):
            send(chat, "\u2705 Compte Hysteria2 cr\u00e9\u00e9\n<pre>%s</pre>" % esc("\n".join(r.splitlines()[1:])))
        else:
            send(chat, "\u274C %s" % esc(r))
    elif a == "hydel":
        r = hy("del", parts[0])
        send(chat, ("\u2705 %s supprim\u00e9" % esc(parts[0])) if r.startswith("OK") else ("\u274C %s" % esc(r)))
    elif a == "xadd":
        proto = st["proto"]
        if len(parts) < 1: send(chat, "Format : nom jours"); return
        days = parts[1] if len(parts) > 1 else "30"
        out = cli("xadd", proto, parts[0], days)
        first = out.splitlines()[0] if out else "ERR"
        if first.startswith("OK"):
            box = "\n".join(out.splitlines()[1:])
            send(chat, "\u2705 <b>Client %s cr\u00e9\u00e9</b>\n<pre>%s</pre>" % (proto.upper(), esc(box)))
        else:
            send(chat, "\u274C %s" % first)
    elif a == "xdel":
        r = cli("xdel", st["proto"], parts[0])
        send(chat, "\u2705 Supprime" if r.startswith("OK") else ("\u274C %s" % r))

def authorized(uid):
    return str(uid) == ADMIN

def main():
    global OFFSET
    while True:
        upd = api("getUpdates", offset=OFFSET, timeout=50)
        if not upd.get("ok"):
            time.sleep(3); continue
        for u in upd["result"]:
            OFFSET = u["update_id"] + 1
            if "callback_query" in u:
                cq = u["callback_query"]; uid = cq["from"]["id"]; chat = cq["message"]["chat"]["id"]
                api("answerCallbackQuery", callback_query_id=cq["id"])
                if not authorized(uid): api("sendMessage", chat_id=chat, text="\u26D4 Non autorise"); continue
                handle_callback(chat, cq["data"])
            elif "message" in u:
                m = u["message"]; uid = m["from"]["id"]; chat = m["chat"]["id"]
                if not authorized(uid): api("sendMessage", chat_id=chat, text="\u26D4 Non autorise"); continue
                txt = m.get("text", "")
                if txt in ("/start", "/menu"): STATE.pop(chat, None); show_menu(chat)
                else: handle_text(chat, txt)

if __name__ == "__main__":
    if not TOKEN or not ADMIN:
        raise SystemExit("bot.conf incomplet (TOKEN / ADMIN)")
    # Purge des mises à jour restées en attente côté Telegram (24 h de
    # rétention). Sans elle, chaque démarrage du service rejouait les anciens
    # /start et le menu apparaissait plusieurs fois d'affilée.
    try:
        _old = api("getUpdates", offset=-1, timeout=0).get("result") or []
        if _old:
            OFFSET = _old[-1]["update_id"] + 1
            api("getUpdates", offset=OFFSET, timeout=0)
    except Exception:
        pass
    if ADMIN:
        api("sendMessage", chat_id=ADMIN, text=MENU_TXT, parse_mode="HTML", reply_markup=main_kb())
    while True:
        try: main()
        except Exception: time.sleep(5)
