import json, subprocess, urllib.request, urllib.parse, time, shlex

CONF = "/etc/nvpanel/bot.conf"

def load_conf():
    c = {}
    with open(CONF) as f:
        for ln in f:
            ln = ln.strip()
            if "=" in ln and not ln.startswith("#"):
                k, v = ln.split("=", 1); c[k.strip()] = v.strip()
    return c

