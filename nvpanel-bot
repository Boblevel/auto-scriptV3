def conn_time(u):
    """Durée de connexion d'un compte SSH — identique à _conn_time() du
    panel (durée du plus vieux processus appartenant à l'utilisateur).
    Retourne "" si pas connecté (aucune donnée fiable de ce type n'existe
    pour les autres protocoles : voir wg_time pour WireGuard, le seul
    autre protocole où c'est possible)."""
    out = sh("ps -o etimes= -u %s 2>/dev/null | tr -d ' ' | sort -rn | head -1" % shlex.quote(u))
    try:
        et = int(out)
    except Exception:
        return ""
    if et < 5:
        return ""
    if et >= 86400:
        return "%dj %dh" % (et // 86400, (et % 86400) // 3600)
    if et >= 3600:
        return "%dh %02dmin" % (et // 3600, (et % 3600) // 60)
    return "%dmin" % (et // 60)

def wg_time(pub):
    """Ancienneté de la dernière poignée de main WireGuard pour cette clé
    publique — identique à _wg_time() du panel. Retourne "" si le client
    n'a jamais négocié ou si sa dernière poignée de main date de plus de
    3 minutes (considéré comme déconnecté)."""
    hs = sh("wg show wg0 latest-handshakes 2>/dev/null | awk -v p=%s '$1==p{print $2}'" % shlex.quote(pub))
    try:
        hs = int(hs)
    except Exception:
        return ""
    if hs == 0:
        return ""
    d = int(time.time()) - hs
    if d > 180 or d < 0:
        return ""
    if d >= 3600:
        return "%dh %02dmin" % (d // 3600, (d % 3600) // 60)
    return "%dmin" % (d // 60)

