def split_dns_key(box):
    """Sépare la clé DNS du reste de la fiche.

    Dans un bloc <pre>, Telegram renvoie la ligne à ~33 caractères sur
    téléphone : une clé de 64 caractères y est donc coupée en deux, et la
    copie donne une clé invalide. On la retire du bloc pour la présenter
    seule en <code>, que Telegram copie intégralement d'un seul appui.
    """
    kept, key = [], ""
    for line in box.splitlines():
        st = line.strip()
        if len(st) == 64 and all(c in "0123456789abcdefABCDEF" for c in st):
            key = st
            if kept and kept[-1].rstrip().endswith(":"):
                kept.pop()          # on retire aussi son libellé devenu orphelin
            continue
        kept.append(line)
    return "\n".join(kept), key

def dns_key_line(key=""):
    """Clé DNS dans un bloc <code> : Telegram la copie entièrement d'un appui,
    sans le retour à la ligne que provoque l'affichage du terminal."""
    k = key or read_file("/etc/nvpanel/slowdns/server.pub")
    if not k:
        return ""
    return "\n\n\U0001F510 <b>Cl\u00e9 DNS</b> (appuie pour copier) :\n<code>%s</code>" % esc(k)

