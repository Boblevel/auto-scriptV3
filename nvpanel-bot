def api(method, **params):
    data = urllib.parse.urlencode(
        {k: (json.dumps(v) if isinstance(v, (dict, list)) else v) for k, v in params.items()}
    ).encode()
    try:
        with urllib.request.urlopen(API + method, data=data, timeout=60) as r:
            return json.load(r)
    except Exception:
        return {}

def esc(t):
    """Échappe les caractères réservés par le HTML de Telegram."""
    return (str(t).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))

def cli(*args):
    try:
        return subprocess.run(["nvpanel-cli", *args], capture_output=True, text=True, timeout=40).stdout.strip()
    except Exception as e:
        return "ERR %s" % e

def read_file(p):
    try:
        with open(p) as f: return f.read().strip()
    except Exception:
        return ""

def count_db(name):
    try:
        with open("/etc/nvpanel/db/" + name) as f:
            return sum(1 for l in f if l.startswith("### "))
    except Exception:
        return 0

def sys_info():
    up = ram = load = "?"
    try:
        s = float(read_file("/proc/uptime").split()[0])
        d = int(s // 86400); h = int((s % 86400) // 3600); m = int((s % 3600) // 60)
        up = ("%dj %dh %dm" % (d, h, m)) if d else ("%dh %dm" % (h, m))
    except Exception:
        pass
    try:
        mem = {}
        for ln in open("/proc/meminfo"):
            k, v = ln.split(":"); mem[k] = int(v.strip().split()[0])
        tot = mem["MemTotal"] // 1024; avail = mem.get("MemAvailable", 0) // 1024
        ram = "%d/%d Mo" % (tot - avail, tot)
    except Exception:
        pass
    try:
        load = " ".join(read_file("/proc/loadavg").split()[:3])
    except Exception:
        pass
    return up, ram, load

def os_name():
    """Nom du système, identique à ce que le panel affiche (PRETTY_NAME de
    /etc/os-release)."""
    return sh('. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}"') or "Linux"

def cores():
    """Nombre de cœurs CPU, identique au panel (nproc)."""
    return sh("nproc 2>/dev/null") or "?"

def hr(b):
    """Format lisible (o/Ko/Mo/Go...), identique à _hr() du panel."""
    try:
        b = float(b)
    except Exception:
        b = 0.0
    for u in ("o", "Ko", "Mo", "Go", "To", "Po"):
        if b < 1024:
            return "%.1f %s" % (b, u)
        b /= 1024
    return "%.1f Po" % b

def fmt_date(d):
    """Convertit une date AAAA-MM-JJ (format renvoyé par les scripts) en
    JJ-MM-AAAA pour l'affichage — identique à _fmtd() du panel. Le bot ne
    stocke ni ne compare jamais de dates, uniquement de l'affichage : rien
    d'autre n'est concerné par cette conversion."""
    if not d:
        return d
    try:
        y, m, day = d.strip().split("-")
        if len(y) == 4:
            return "%s-%s-%s" % (day, m, y)
    except Exception:
        pass
    return d

def conso_raw():
    """hier|auj|mois en octets — délègue à nvpanel-conso, exactement la
    même source de données que le panel (_conso_raw dans ui.sh)."""
    try:
        out = subprocess.run(["nvpanel-conso", "read"], capture_output=True,
                              text=True, timeout=15).stdout.strip()
        parts = out.split("|")
        if len(parts) == 3:
            return parts
    except Exception:
        pass
    return ("0", "0", "0")

def sh(cmd):
    try:
        return subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, timeout=15).stdout.strip()
    except Exception:
        return ""

def _int(s):
    try:
        return int(str(s).strip())
    except Exception:
        return 0

def ssh_online():
    return _int(sh("ps -eo user,comm | awk '$2 ~ /sshd|dropbear/{print $1}' | sort -u | "
                   "while read u; do grep -q \"^### $u \" /etc/nvpanel/db/ssh 2>/dev/null && echo 1; done | wc -l"))

def ssh_blocked():
    return _int(sh("c=0; while read _ u _; do [ -z \"$u\" ] && continue; "
                   "s=$(passwd -S \"$u\" 2>/dev/null | awk '{print $2}'); "
                   "[ \"$s\" = L ] && c=$((c+1)); done < /etc/nvpanel/db/ssh 2>/dev/null; echo $c"))

def port_online(p):
    # Clients UNIQUES (par IP source), jamais un simple nombre de connexions
    # établies : une application peut ouvrir plusieurs flux TCP en parallèle
    # (multiplexage), ce qui gonflait ce chiffre bien au-delà du nombre réel
    # de personnes connectées (ex. observé : 3 comptes Vless affichés comme
    # 145 « en ligne »). Identique à _online_uniq_port() dans le panel.
    return _int(sh("ss -tnH state established '( sport = :%s )' 2>/dev/null "
                   "| awk '{print $4}' | sed -E 's/:[0-9]+$//' | sort -u | wc -l" % p))

def xray_online():
    # Identique à _xray_online() du panel : Vmess/Vless/Trojan partagent la
    # même façade nginx, et côté Xray toute connexion arrive en 127.0.0.1 —
    # impossible de séparer par protocole à ce niveau. Le seul chiffre
    # honnête est le nombre de clients uniques sur le port PUBLIC de nginx ;
    # il est donc partagé pour les trois protocoles, comme dans le panel.
    xport = read_file("/etc/nvpanel/xport") or "443"
    return port_online(xport)

def blocked_count(name):
    # Comptes verrouillés (colonne 5 = L) pour un protocole donné. Le bot ne
    # comptait jusqu'ici que les comptes SSH verrouillés : le total
    # « Bloqués » ne correspondait donc pas à celui du panel dès qu'un
    # compte d'un autre protocole était verrouillé.
    return _int(sh("awk '/^### /{if($5==\"L\")c++} END{print c+0}' /etc/nvpanel/db/%s 2>/dev/null" % name))

def wg_online():
    return _int(sh("wg show wg0 latest-handshakes 2>/dev/null | "
                   "awk -v n=$(date +%s) '$2>0 && (n-$2)<180{c++} END{print c+0}'"))

