#!/bin/bash
# ============================================================
#  RHAFF SERVICE · installation PPTP   (install-pptp [auto])
# ============================================================
source /etc/nvpanel/lib/ui.sh
[ "$EUID" -ne 0 ] && { err "Lance en root."; exit 1; }
umask 077
AUTO=0; [ "$1" = "auto" ] && AUTO=1
NET=10.20.20
IFACE=$(ip route 2>/dev/null | awk '/default/{print $5; exit}')

[ "$AUTO" = 1 ] || { banner; center " INSTALLATION PPTP " "${BOLD}${WHT}"; line; printf "${CYN}➜${NC} Installation…\n"; }
export DEBIAN_FRONTEND=noninteractive
echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections 2>/dev/null
echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections 2>/dev/null
apt-get install -y pptpd ppp iptables iptables-persistent >/dev/null 2>&1 || {
  [ "$AUTO" = 0 ] && { err "Installation des paquets PPTP échouée."; pause; }
  exit 1
}
[ -n "$IFACE" ] || { [ "$AUTO" = 0 ] && { err "Interface réseau par défaut introuvable."; pause; }; exit 1; }
PPTPD_BIN=$(command -v pptpd 2>/dev/null)

if [ -n "$PPTPD_BIN" ]; then
cat > /etc/pptpd.conf <<EOF
option /etc/ppp/pptpd-options
logwtmp
localip $NET.1
remoteip $NET.10-200
EOF

cat > /etc/ppp/pptpd-options <<'EOF'
name pptpd
refuse-pap
refuse-chap
refuse-mschap
require-mschap-v2
require-mppe-128
ms-dns 1.1.1.1
ms-dns 8.8.8.8
proxyarp
nodefaultroute
lock
nobsdcomp
novj
novjccomp
nologfd
EOF
fi

# routage + NAT
sed -i '/^net.ipv4.ip_forward/d' /etc/sysctl.conf
echo 'net.ipv4.ip_forward=1' >> /etc/sysctl.conf
sysctl -p >/dev/null 2>&1
_fw_ok=1
[ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" = 1 ] || _fw_ok=0
if [ -n "$IFACE" ]; then
  iptables -t nat -C POSTROUTING -s $NET.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null || \
    iptables -t nat -A POSTROUTING -s $NET.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null || _fw_ok=0
fi
iptables -C FORWARD -s $NET.0/24 -j ACCEPT 2>/dev/null || iptables -I FORWARD -s $NET.0/24 -j ACCEPT 2>/dev/null || _fw_ok=0
iptables -C FORWARD -d $NET.0/24 -j ACCEPT 2>/dev/null || iptables -I FORWARD -d $NET.0/24 -j ACCEPT 2>/dev/null || _fw_ok=0
iptables -C INPUT -p tcp --dport 1723 -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport 1723 -j ACCEPT 2>/dev/null || _fw_ok=0
iptables -C INPUT -p gre -j ACCEPT 2>/dev/null || iptables -I INPUT -p gre -j ACCEPT 2>/dev/null || _fw_ok=0
iptables -C FORWARD -p tcp --syn -s $NET.0/24 -j TCPMSS --set-mss 1356 2>/dev/null || \
  iptables -I FORWARD -p tcp --syn -s $NET.0/24 -j TCPMSS --set-mss 1356 2>/dev/null || _fw_ok=0
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi active; then
  ufw allow 1723/tcp >/dev/null 2>&1 || _fw_ok=0
  ufw allow proto gre from any >/dev/null 2>&1 || _fw_ok=0
fi
if [ "$_fw_ok" -ne 1 ] \
   || ! command -v netfilter-persistent >/dev/null 2>&1 \
   || ! netfilter-persistent save >/dev/null 2>&1; then
  [ "$AUTO" = 0 ] && { err "Routage ou pare-feu PPTP non applicable sur ce VPS."; pause; }
  exit 1
fi

if [ -n "$PPTPD_BIN" ]; then
  systemctl enable pptpd >/dev/null 2>&1
  systemctl restart pptpd >/dev/null 2>&1
  sleep 1
fi
OK=0; systemctl is-active --quiet pptpd && OK=1
LIS=0
{ ss -lnt 2>/dev/null || netstat -lnt 2>/dev/null; } | grep -q ':1723' && LIS=1
[ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1

if [ "$AUTO" = 1 ]; then
  if [ "$OK" = 1 ] && [ "$LIS" = 1 ]; then printf "  ${GRN}✔${NC} PPTP prêt.\n"; exit 0; fi
  printf "  ${YLW}!${NC} PPTP non activé.\n"; exit 1
fi
clear; banner
if [ "$OK" = 1 ] && [ "$LIS" = 1 ]; then
  center " ✔  PPTP OPÉRATIONNEL " "${BOLD}${GRN}"; line
  ok "Service actif, port 1723 en écoute."
  printf "   ${GRY}Crée un compte depuis le menu PPTP, puis connecte-toi avec${NC}\n"
  printf "   ${GRY}l'adresse du serveur, l'utilisateur et le mot de passe.${NC}\n"
elif [ -z "$PPTPD_BIN" ]; then
  center " ✘  PPTP NON ACTIVÉ " "${BOLD}${RED}"; line
  err "Le paquet pptpd n'a pas pu s'installer."
  printf "   ${GRY}Le dépôt configuré sur ce VPS ne fournit pas pptpd.${NC}\n"
  printf "   ${GRY}Utilise plutôt L2TP ou SSTP sur ce serveur.${NC}\n"
else
  center " ✘  PPTP NON ACTIVÉ " "${BOLD}${RED}"; line
  err "Le service PPTP n'a pas démarré."
  printf "   ${GRY}Certains hébergeurs bloquent le protocole GRE, requis par PPTP.${NC}\n"
  printf "   ${GRY}Dans ce cas, utilise plutôt L2TP ou SSTP.${NC}\n"
fi
pause
