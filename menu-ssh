#!/bin/bash
# ============================================================
#  nvpanel · gestion SSH (+ SlowDNS, UDP, limite, quota)
#  commande : menu-ssh
# ============================================================
source /etc/nvpanel/lib/ui.sh
ui_enter; trap ui_leave EXIT INT TERM HUP
[ "$EUID" -ne 0 ] && { err "Lance en root."; exit 1; }

DB=/etc/nvpanel/db/ssh
LIMDB=/etc/nvpanel/db/limit
QDB=/etc/nvpanel/db/quota
mkdir -p /etc/nvpanel/db; touch "$DB" "$LIMDB" "$QDB"
IP=$(cat /etc/nvpanel/ip 2>/dev/null)
DOMAIN=$(cat /etc/nvpanel/domain 2>/dev/null || echo "$IP")

header(){ banner; _edge "┏" "┓" "GESTION SSH / SLOWDNS / UDP"; proto_dash ssh ssh ssh_bundle; bot; }

# Sélecteur : liste les comptes SSH gérés et renvoie celui choisi par numéro.
# Résultat dans la variable PICK. Retour 1 si annulé / aucun compte.
pick_user() {
  PICK=""
  mapfile -t _users < <(awk '/^### /{print $2}' "$DB" 2>/dev/null)
  if [ "${#_users[@]}" -eq 0 ]; then err "Aucun compte SSH."; pause; return 1; fi
  local page=0 size=6 total=${#_users[@]} pages start end i u exp st today _ct n
  pages=$(( (total + size - 1) / size )); today=$(date +%F)
  while true; do
    header
    printf "   ${GRY}Comptes disponibles · page %d/%d :${NC}\n" "$((page+1))" "$pages"
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      u="${_users[$i]}"; exp=$(awk -v x="$u" '$2==x{print $3}' "$DB")
      if passwd -S "$u" 2>/dev/null | awk '{exit !($2=="L")}'; then
        st="${RED}verrou${NC}"
      elif [ -n "$exp" ] && { [ "$exp" \< "$today" ] || [ "$exp" = "$today" ]; }; then
        st="${RED}expiré${NC}"
      else
        st="${GRN}actif${NC}"
      fi
      _ct=$(_conn_time "$u")
      printf "   ${WHT}%2d${NC}) %-16s ${GRY}exp %s${NC}  %b  ${CYN}%s${NC}\n" "$((i+1))" "$u" "$(_fmtd "${exp:-?}")" "$st" "${_ct:+⏱ $_ct}"
    done
    echo
    if [ "$pages" -gt 1 ]; then
      ask "   ➤ N° | n suivante | p précédente | 0 retour : " n
      case "${n,,}" in n) [ "$page" -lt $((pages-1)) ] && page=$((page+1)); continue ;; p) [ "$page" -gt 0 ] && page=$((page-1)); continue ;; esac
    else
      ask "   ➤ Numéro (0 = annuler) : " n
    fi
    [[ "$n" =~ ^[0-9]+$ ]] || { err "Invalide"; sleep 1; continue; }
    [ "$n" -eq 0 ] && return 1
    [ "$n" -ge 1 ] && [ "$n" -le "$total" ] || { err "Hors liste"; sleep 1; continue; }
    PICK="${_users[$((n-1))]}"; return 0
  done
}

create_account() {
  # Sans argument : saisie interactive. Avec arguments : création automatique
  # (utilisée par le compte test 24 h).
  local user pass days lim gb out
  if [ -n "$1" ]; then
    user="$1"; pass="$2"; days="${3:-1}"; lim="${4:-1}"; gb="${5:-0}"
  else
    header
    ask " Utilisateur : " user
    [ -z "$user" ] && { err "Nom vide"; pause; return; }
    id "$user" &>/dev/null && { err "Existe déjà"; pause; return; }
    ask " Mot de passe : " pass
    ask " Durée (jours) : " days;   [[ "$days" =~ ^[0-9]+$ ]] || days=30
    ask " Limite d'appareils (0 = illimité) : " lim; [[ "$lim" =~ ^[0-9]+$ ]] || lim=0
    ask " Bandwidth en Go (0 = illimité) : " gb; [[ "$gb" =~ ^[0-9]+$ ]] || gb=0
  fi
  out=$(nvpanel-cli create "$user" "$pass" "$days" "$lim" "$gb")
  clear; header
  if echo "$out" | head -1 | grep -q '^OK'; then
    ok "Compte SSH créé"
    echo
    printf "${GRN}"; echo "$out" | tail -n +2; printf "${NC}"
  else
    case "$out" in
      *shortpass*) err "Mot de passe trop court : 4 caractères minimum." ;;
      *exists*)    err "Ce nom d'utilisateur existe déjà." ;;
      *)           err "Échec : $(echo "$out" | head -1)" ;;
    esac
  fi
  pause

}

list_accounts() {
  local page=0 size=4 total pages start end i u exp st st_color ct sessions n today lim limtxt connfmt
  mapfile -t _rows_ssh < <(awk '/^### /{print $2"|"$3}' "$DB" 2>/dev/null)
  total=${#_rows_ssh[@]}; [ "$total" -eq 0 ] && { header; warn "Aucun compte SSH."; pause; return; }
  pages=$(( (total + size - 1) / size )); sessions=$(_ssh_sessions); today=$(date +%F)
  while true; do
    header
    table_top
    printf "${CYN}┃${NC} ${WHT}%-16s %-12s %-8s %s${NC}" "COMPTE" "EXPIRE" "ÉTAT" "CONNECTÉ DEPUIS"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    table_sep
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r u exp <<< "${_rows_ssh[$i]}"
      if passwd -S "$u" 2>/dev/null | awk '{exit !($2=="L")}'; then
        st="verrou"; st_color="$RED"
      elif [ -n "$exp" ] && { [ "$exp" \< "$today" ] || [ "$exp" = "$today" ]; }; then
        st="expiré"; st_color="$RED"
      else
        st="actif"; st_color="$GRN"
      fi
      ct=$(_conn_time "$u"); n=$(printf '%s\n' "$sessions" | grep -c "^$u|")
      lim=$(awk -v x="$u" '$1==x{print $2; exit}' "$LIMDB" 2>/dev/null); lim=${lim:-0}
      [ "$lim" -gt 0 ] 2>/dev/null && limtxt="$lim" || limtxt="∞"
      connfmt="${ct:-—} · ${n}/${limtxt} IP"
      printf "${CYN}┃${NC} %-16s %-12s ${st_color}%-8s${NC} %s" "$u" "$(_fmtd "${exp:-?}")" "$st" "$connfmt"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
      [ "$i" -lt $((end-1)) ] && table_sep
    done
    table_bot
    if [ "$pages" -le 1 ]; then pause; return; fi
    ask "   ➤ n suivante | p précédente | 0 retour : " n
    case "${n,,}" in n) [ "$page" -lt $((pages-1)) ] && page=$((page+1)) ;; p) [ "$page" -gt 0 ] && page=$((page-1)) ;; 0|'') return ;; *) warn "Invalide"; sleep 1 ;; esac
  done
}

renew_account() {
  header; pick_user || return; user="$PICK"
  ask " Ajouter (jours) : " days; [[ "$days" =~ ^[0-9]+$ ]] || { err "Invalide"; pause; return; }
  out=$(nvpanel-cli renew "$user" "$days")
  echo "$out" | grep -q '^OK' && ok "$user prolongé (compteur Bandwidth remis à zéro)" || err "Échec : $out"
  pause
}

delete_account() {
  header; pick_user || return; user="$PICK"
  printf "   ${YLW}Supprimer '%s' ? (o/n) : ${NC}" "$user"; ask "" c
  confirm "$c" || { pause; return; }
  out=$(nvpanel-cli delete "$user")
  echo "$out" | grep -q '^OK' && ok "$user supprimé (connexion coupée)" || err "Échec : $out"
  pause
}


# Génère un compte de démonstration valable 24 h (identifiants aléatoires).
_rand_name(){ printf 'test%s' "$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c4)"; }
_rand_pass(){ tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c8; }

trial_account() {
  banner; top; center " 🎁  COMPTE TEST 24 H " "${BOLD}${WHT}"; bot
  local n p
  n=$(_rand_name); p=$(_rand_pass)
  printf "   ${GRY}Génération d'un compte valable 24 heures…${NC}\n"
  create_account "$n" "$p" 1 1 0
}

lock_toggle() {
  header; pick_user || return; user="$PICK"
  if passwd -S "$user" 2>/dev/null | awk '{exit !($2=="L")}'; then
    nvpanel-cli unlock "$user" >/dev/null; ok "$user déverrouillé"
  else
    nvpanel-cli lock "$user" >/dev/null; ok "$user verrouillé (connexion coupée)"
  fi
  pause
}

blocked_accounts() {
  local label="${1:-SSH}" today page=0 size=6 total pages start end i n u exp out
  today=$(date +%F)
  mapfile -t _blocked_ssh < <(
    while read -r _ u exp; do
      [ -n "$u" ] || continue
      { [ -z "$exp" ] || [ "$exp" \> "$today" ]; } || continue
      passwd -S "$u" 2>/dev/null | awk '{exit !($2=="L")}' && printf '%s|%s\n' "$u" "$exp"
    done < "$DB"
  )
  total=${#_blocked_ssh[@]}
  if [ "$total" -eq 0 ]; then
    header; warn "Aucun compte $label bloqué / verrouillé."; pause; return
  fi
  pages=$(( (total + size - 1) / size ))
  while true; do
    header
    printf "   ${GRY}Comptes $label bloqués · page %d/%d :${NC}\n" "$((page+1))" "$pages"
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r u exp <<< "${_blocked_ssh[$i]}"
      printf "   ${WHT}%2d${NC}) %-16s ${GRY}exp %s${NC}  ${RED}verrouillé${NC}\n" "$((i+1))" "$u" "$(_fmtd "${exp:-?}")"
    done
    echo
    if [ "$pages" -gt 1 ]; then
      ask "   ➤ N° à déverrouiller | n suivante | p précédente | 0 retour : " n
    else
      ask "   ➤ N° à déverrouiller (0 = retour) : " n
    fi
    case "${n,,}" in
      n) [ "$pages" -gt 1 ] && [ "$page" -lt $((pages-1)) ] && page=$((page+1)); continue ;;
      p) [ "$pages" -gt 1 ] && [ "$page" -gt 0 ] && page=$((page-1)); continue ;;
    esac
    [[ "$n" =~ ^[0-9]+$ ]] || { warn "Invalide"; sleep 1; continue; }
    [ "$n" -eq 0 ] && return
    [ "$n" -ge 1 ] && [ "$n" -le "$total" ] || { warn "Hors liste"; sleep 1; continue; }
    u="${_blocked_ssh[$((n-1))]%%|*}"
    out=$(nvpanel-cli unlock "$u" 2>&1)
    if echo "$out" | grep -q '^OK'; then ok "$u déverrouillé"; else err "Échec : $out"; fi
    pause; return
  done
}

view_account() {
  header; pick_user || return; user="$PICK"
  out=$(nvpanel-cli info "$user")
  clear; header
  if echo "$out" | head -1 | grep -q '^OK'; then
    printf "${GRN}"; echo "$out" | tail -n +2; printf "${NC}"
  else
    err "Introuvable : $out"
  fi
  pause
}

slowdns_menu() {
  header
  if systemctl is-active --quiet nvpanel-slowdns; then
    ok "SlowDNS actif"
    printf "   NS  : ${WHT}%s${NC}\n" "$(cat /etc/nvpanel/slowdns/ns 2>/dev/null)"
    # La clé fait 64 caractères : on la place seule sur sa ligne, sinon le
    # terminal la coupe en plein milieu et la copie devient inutilisable.
    printf "   Pub :\n${WHT}%s${NC}\n" "$(cat /etc/nvpanel/slowdns/server.pub 2>/dev/null)"
  else
    warn "SlowDNS non installé."
  fi
  echo; entry "1" "⬇️" "Installer / réinstaller"
  entry "2" "🗑️" "Désinstaller"
  entry "0" "⬅️" "Retour"; line
  ask "$(printf " ${WHT}➤ Choix :${NC} ")" s
  case "$s" in
    1) install-slowdns ;;
    2) uninstall_slowdns ;;
  esac
}

uninstall_slowdns() {
  banner; center " 🗑️  DÉSINSTALLER SLOWDNS " "${BOLD}${RED}"; line
  warn "SlowDNS sera retiré. Les comptes SSH ne sont pas touchés."
  printf "   ${RED}➤ Confirmer ? (o/n) : ${NC}"; ask "" r
  confirm "$r" || { warn "Annulé."; pause; return; }
  systemctl disable --now nvpanel-slowdns >/dev/null 2>&1
  rm -f /etc/systemd/system/nvpanel-slowdns.service
  iptables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300 2>/dev/null
  iptables -D INPUT -p udp --dport 5300 -j ACCEPT 2>/dev/null
  rm -rf /etc/nvpanel/slowdns
  systemctl daemon-reload >/dev/null 2>&1
  command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1
  ok "SlowDNS a été désinstallé."; pause
}

udp_status() {
  local custom=0 custom_port=22 on=0 p listen=0 state
  if [ -f /etc/systemd/system/nvpanel-udp-custom.service ] || [ -f /etc/nvpanel/udp/config.json ]; then
    custom=1
  fi
  if [ -f /etc/nvpanel/udp/config.json ]; then
    p=$(sed -n 's/.*"listen"[[:space:]]*:[[:space:]]*"[^"]*:\([0-9][0-9]*\)".*/\1/p' /etc/nvpanel/udp/config.json 2>/dev/null | head -1)
    [[ "$p" =~ ^[0-9]+$ ]] && custom_port="$p"
  fi

  header
  if [ "$custom" = 1 ]; then
    _edge "┏" "┓" "UDP CUSTOM"
    if systemctl is-active --quiet nvpanel-udp-custom 2>/dev/null; then
      state="${GRN}actif${NC}"
    else
      state="${RED}arrêté${NC}"
    fi
    printf "${CYN}┃${NC} ${GRY}● Service :${NC} %b" "$state"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    box_sep
    printf "${CYN}┃${NC} ${GRY}● Port UDP :${NC} ${WHT}%s${NC}" "$custom_port"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    box_sep
    printf "${CYN}┃${NC} ${GRY}● Comptes  :${NC} ${WHT}SSH / SlowDNS / UDP Custom${NC}"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    bot
  else
    _edge "┏" "┓" "UDP (UDPGW)"
    for p in 7100 7200 7300; do
      if systemctl is-active --quiet nvpanel-badvpn-$p 2>/dev/null; then
        printf "${CYN}┃${NC} ${GRN}● actif${NC}   UDPGW port %s" "$p"; on=$((on+1))
      else
        printf "${CYN}┃${NC} ${RED}○ arrêté${NC}  ${GRY}UDPGW port %s${NC}" "$p"
      fi
      printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
      [ "$p" != 7300 ] && box_sep
    done
    bot
    if command -v ss >/dev/null 2>&1; then
      ss -lnt 2>/dev/null | grep -q '127.0.0.1:7300' && listen=1
    elif command -v netstat >/dev/null 2>&1; then
      netstat -lnt 2>/dev/null | grep -q '127.0.0.1:7300' && listen=1
    fi
    if [ "$listen" = 1 ]; then
      ok "Port 7300 vérifié : l'UDP passe."
    elif [ "$on" -gt 0 ]; then
      warn "Services UDPGW actifs mais le port 7300 ne répond pas."
    else
      warn "UDPGW non installé."
    fi
  fi

  menu_box_top
  compact_menu_entry "1" "⬇️" "Installer UDP Custom"
  compact_menu_entry "2" "🗑️" "Désinstaller"
  compact_menu_entry "0" "⬅️" "Retour"
  menu_box_bot
  ask "$(printf " ${WHT}➤ Choix :${NC} ")" s
  case "$s" in
    1) install-udp ;;
    2) uninstall_udp ;;
  esac
}

uninstall_udp() {
  banner; center " 🗑️  DÉSINSTALLER UDP " "${BOLD}${RED}"; line
  warn "Le module UDP sera retiré. Les comptes SSH ne sont pas touchés."
  printf "   ${RED}➤ Confirmer ? (o/n) : ${NC}"; ask "" r
  confirm "$r" || { warn "Annulé."; pause; return; }
  for p in 7100 7200 7300; do
    systemctl disable --now nvpanel-badvpn-$p >/dev/null 2>&1
    rm -f /etc/systemd/system/nvpanel-badvpn-$p.service
  done
  systemctl disable --now nvpanel-udp-custom >/dev/null 2>&1
  rm -f /etc/systemd/system/nvpanel-udp-custom.service
  iptables -D INPUT -p udp --dport 36712 -j ACCEPT 2>/dev/null
  iptables -D INPUT -p udp --dport 22 -j ACCEPT 2>/dev/null
  command -v ufw >/dev/null 2>&1 && ufw --force delete allow 22/udp >/dev/null 2>&1
  rm -rf /etc/nvpanel/udp
  systemctl daemon-reload >/dev/null 2>&1
  command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1
  [ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1
  ok "Le module UDP a été désinstallé."; pause
}

cleanup_menu() {
  while true; do
    banner; _edge "┏" "┓" "NETTOYAGE DES COMPTES SSH"
    local tot exp today c r out
    today=$(date +%F)
    tot=$(grep -c '^### ' "$DB" 2>/dev/null); tot=${tot:-0}
    exp=$(awk -v d="$today" '/^### /{ if ($3!="" && $3<=d) c++ } END{print c+0}' "$DB" 2>/dev/null)
    printf "${CYN}┃${NC} ${GRY}Comptes au total :${NC} ${WHT}%s${NC}    ${GRY}dont expirés :${NC} ${RED}%s${NC}" "$tot" "$exp"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    box_sep
    compact_menu_entry "1" "🧽" "Supprimer les comptes expirés"
    compact_menu_entry "2" "💥" "Supprimer TOUS les comptes"
    compact_menu_entry "0" "⬅️" "Retour"
    bot
    ask "$(printf " ${WHT}➤ Choix :${NC} ")" c
    case "$c" in
      1) [ "$exp" -eq 0 ] && { warn "Aucun compte expiré."; pause; continue; }
         printf "   ${YLW}Supprimer les %s compte(s) expiré(s) ? (o/n) : ${NC}" "$exp"; ask "" r
         confirm "$r" || continue
         out=$(nvpanel-cli purge ssh expired)
         ok "$(echo "$out" | awk '{print $2+0}') compte(s) supprimé(s)."; pause ;;
      2) [ "$tot" -eq 0 ] && { warn "Aucun compte."; pause; continue; }
         warn "Cela supprimera les $tot comptes SSH. Action irréversible."
         printf "   ${RED}➤ Confirmer la suppression totale ? (o/n) : ${NC}"; ask "" r
         confirm "$r" || { warn "Annulé."; pause; continue; }
         out=$(nvpanel-cli purge ssh all)
         ok "$(echo "$out" | awk '{print $2+0}') compte(s) supprimé(s)."; pause ;;
      0) break ;;
      *) warn "Invalide"; sleep 1 ;;
    esac
  done
}

hy_header(){
  local total blocked expired online today service
  today=$(date +%F)
  total=$(grep -c '^### ' /etc/nvpanel/db/hysteria 2>/dev/null); total=${total:-0}
  blocked=$(awk '/^### /{if($5=="L")c++} END{print c+0}' /etc/nvpanel/db/hysteria 2>/dev/null); blocked=${blocked:-0}
  expired=$(awk -v d="$today" '/^### /{if($5!="L" && $4!="" && $4<=d)c++} END{print c+0}' /etc/nvpanel/db/hysteria 2>/dev/null); expired=${expired:-0}
  online=$(/usr/local/bin/nvpanel-hysteria online 2>/dev/null); online=${online:-0}
  if systemctl is-active --quiet hysteria-server 2>/dev/null; then
    service="${GRN}actif${NC}"
  elif [ -f /etc/hysteria/config.yaml ]; then
    service="${YLW}arrêté${NC}"
  else
    service="${RED}non installé${NC}"
  fi
  banner
  _edge "┏" "┓" "HYSTERIA UDP"
  printf "${CYN}┃${NC} ${GRY}📦 Comptes:${NC} ${WHT}%s${NC}   ${GRY}👥 En ligne:${NC} ${GRN}%s${NC}   ${GRY}⛔ Bloqué:${NC} ${RED}%s${NC}" "$total" "$online" "$blocked"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
  printf "${CYN}┃${NC} ${GRY}⌛ Expirés:${NC} ${RED}%s${NC}   ${GRY}⚡ Service:${NC} %b   ${GRY}UDP:${NC} ${WHT}443${NC}" "$expired" "$service"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
  bot
}

hysteria_menu() {
  while true; do
    hy_header
    menu_box_top
    compact_menu_entry "1" "➕" "Créer un compte"
    compact_menu_entry "2" "📋" "Lister les comptes"
    compact_menu_entry "3" "🔓" "Verrouiller / déverrouiller"
    compact_menu_entry "4" "🗑️" "Supprimer un compte"
    compact_menu_entry "5" "⬇️" "Installer / réinstaller"
    compact_menu_entry "6" "🗑️" "Désinstaller"
    compact_menu_entry "0" "⬅️" "Retour"
    bot
    ask "$(printf " ${WHT}Choix :${NC} ")" h || break
    case "$h" in
      1) hy_create ;; 2) hy_list ;; 3) hy_blocked ;; 4) hy_delete ;;
      # Sans ce test, quand le composant n'était pas présent sur le serveur la
      # commande échouait en silence : l'option semblait « refuser » de lancer
      # l'installation, sans le moindre message.
      5) if [ -x /usr/local/bin/install-hysteria ]; then
           /usr/local/bin/install-hysteria
         else
           err "Composant d'installation absent. Tape « update » puis réessaie."
           pause
         fi ;;
      6) hy_uninstall ;;
      0) break ;; *) warn "Invalide"; sleep 1 ;;
    esac
  done
}

hy_blocked(){
  local page=0 size=6 total pages start end i choice u exp st color out
  mapfile -t _blocked_hy < <(/usr/local/bin/nvpanel-hysteria list 2>/dev/null)
  total=${#_blocked_hy[@]}
  if [ "$total" -eq 0 ]; then hy_header; warn "Aucun compte Hysteria."; pause; return; fi
  pages=$(( (total + size - 1) / size ))
  while true; do
    hy_header
    printf "   ${GRY}Comptes Hysteria · page %d/%d :${NC}\n" "$((page+1))" "$pages"
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r u exp st <<< "${_blocked_hy[$i]}"
      case "$st" in verrou|expiré) color="$RED" ;; *) color="$GRN" ;; esac
      printf "   ${WHT}%2d${NC}) %-16s ${GRY}exp %s${NC}  ${color}%s${NC}\n" "$((i+1))" "$u" "$(_fmtd "${exp:-?}")" "$st"
    done
    echo
    if [ "$pages" -gt 1 ]; then ask "   ➤ N° à verrouiller / déverrouiller | n suivante | p précédente | 0 retour : " choice
    else ask "   ➤ N° à verrouiller / déverrouiller (0 = retour) : " choice; fi
    case "${choice,,}" in
      n) [ "$pages" -gt 1 ] && [ "$page" -lt $((pages-1)) ] && page=$((page+1)); continue ;;
      p) [ "$pages" -gt 1 ] && [ "$page" -gt 0 ] && page=$((page-1)); continue ;;
    esac
    [[ "$choice" =~ ^[0-9]+$ ]] || { warn "Invalide"; sleep 1; continue; }
    [ "$choice" -eq 0 ] && return
    [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ] || { warn "Hors liste"; sleep 1; continue; }
    IFS='|' read -r u exp st <<< "${_blocked_hy[$((choice-1))]}"
    if [ "$st" = "verrou" ]; then
      out=$(/usr/local/bin/nvpanel-hysteria unlock "$u" 2>&1)
      if echo "$out" | grep -q '^OK'; then ok "$u déverrouillé"; else err "Échec : $out"; fi
    else
      out=$(/usr/local/bin/nvpanel-hysteria lock "$u" 2>&1)
      if echo "$out" | grep -q '^OK'; then ok "$u verrouillé"; else err "Échec : $out"; fi
    fi
    pause; return
  done
}

hy_create(){
  hy_header; center " ➕ NOUVEAU COMPTE HYSTERIA UDP " "${BOLD}${WHT}"; line
  ask " Nom d'utilisateur : " u
  ask " Mot de passe (vide = généré) : " p
  [ -z "$p" ] && p=$(openssl rand -hex 6)
  ask " Durée en jours [30] : " d; d=${d:-30}
  if [ ! -x /usr/local/bin/nvpanel-hysteria ]; then
    err "Hysteria UDP n'est pas installé sur ce serveur (option 4)."; pause; return
  fi
  local out; out=$(/usr/local/bin/nvpanel-hysteria add "$u" "$p" "$d" 2>&1)
  if echo "$out" | grep -q "^OK"; then
    echo "$out" | tail -n +2
    ok "Compte créé."
  else
    # Un message unique pour trois causes très différentes rendait tout
    # diagnostic impossible : un simple service arrêté s'affichait comme
    # « utilisateur déjà pris ».
    case "$out" in
      *"ERR exists"*) err "Ce nom d'utilisateur est déjà pris." ;;
      *"ERR notls"*)  err "Domaine ou certificat TLS absent (Paramètres → 1 puis 2)." ;;
      *"ERR args"*)   err "Nom d'utilisateur ou mot de passe vide." ;;
      *"ERR username"*) err "Nom invalide (lettres, chiffres, _ et - uniquement)." ;;
      *"ERR password"*) err "Mot de passe invalide (4 caractères minimum, sans espace)." ;;
      *"ERR service"*) err "Le service Hysteria2 n'a pas pu démarrer." ;;
      *)              err "Création impossible pour l'instant." ;;
    esac
  fi
  pause
}

hy_list(){
  local page=0 size=4 total pages start end i u e s color choice connfmt devices live
  mapfile -t _rows_hy < <(/usr/local/bin/nvpanel-hysteria list)
  total=${#_rows_hy[@]}; [ "$total" -eq 0 ] && { hy_header; top; center " 📋 COMPTES HYSTERIA UDP " "${BOLD}${WHT}"; bot; warn "Aucun compte."; pause; return; }
  live=$(/usr/local/bin/nvpanel-hysteria online all-detail 2>/dev/null)
  pages=$(( (total + size - 1) / size ))
  while true; do
    hy_header; top; center " 📋 COMPTES HYSTERIA UDP " "${BOLD}${WHT}"; bot
    table_top
    printf "${CYN}┃${NC} ${WHT}%-16s %-12s %-8s %s${NC}" "COMPTE" "EXPIRE" "ÉTAT" "CONNECTÉ"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    table_sep
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r u e s <<< "${_rows_hy[$i]}"; case "$s" in verrou|expiré) color="$RED" ;; *) color="$GRN" ;; esac
      devices=$(printf '%s\n' "$live" | awk -F'|' -v n="$u" '$1==n{print $2+0; exit}'); devices=${devices:-0}
      [ "$s" = "actif" ] && connfmt="$devices app." || connfmt="—"
      printf "${CYN}┃${NC} %-16s %-12s ${color}%-8s${NC} %s" "$u" "$(_fmtd "$e")" "$s" "$connfmt"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
      [ "$i" -lt $((end-1)) ] && table_sep
    done
    table_bot
    if [ "$pages" -le 1 ]; then pause; return; fi
    ask "   ➤ n suivante | p précédente | 0 retour : " choice
    case "${choice,,}" in n) [ "$page" -lt $((pages-1)) ] && page=$((page+1)) ;; p) [ "$page" -gt 0 ] && page=$((page-1)) ;; 0|'') return ;; *) warn "Invalide"; sleep 1 ;; esac
  done
}

hy_delete(){
  hy_header; center " 🗑️ SUPPRIMER UN COMPTE HYSTERIA UDP " "${BOLD}${WHT}"; line
  ask " Utilisateur à supprimer : " u
  local out; out=$(/usr/local/bin/nvpanel-hysteria del "$u" 2>&1)
  if echo "$out" | grep -q "^OK"; then
    ok "Compte supprimé."
  else
    case "$out" in
      *"ERR nouser"*)   err "Utilisateur introuvable." ;;
      *"ERR username"*) err "Nom d'utilisateur invalide." ;;
      *"ERR busy"*)     err "Une autre modification Hysteria est en cours." ;;
      *"ERR service"*)  err "Suppression annulée : le service Hysteria n'a pas pu être rechargé." ;;
      *)                 err "Suppression impossible pour l'instant." ;;
    esac
  fi
  pause
}

hy_uninstall(){
  hy_header; center " 🗑️ DÉSINSTALLER HYSTERIA UDP " "${BOLD}${WHT}"; line
  printf "   ${RED}➤ Supprimer Hysteria UDP et tous ses comptes ? (o/n) : ${NC}"; ask "" r
  confirm "$r" || { warn "Annulé."; pause; return; }
  systemctl disable --now hysteria-server >/dev/null 2>&1
  if id hysteria >/dev/null 2>&1; then
    if command -v setfacl >/dev/null 2>&1; then
      setfacl -R -x u:hysteria /etc/letsencrypt/live /etc/letsencrypt/archive 2>/dev/null
      find /etc/letsencrypt/live /etc/letsencrypt/archive -type d \
        -exec setfacl -x d:u:hysteria {} + 2>/dev/null
    fi
    userdel -r hysteria >/dev/null 2>&1
  fi
  rm -f /etc/nvpanel/db/hysteria /usr/local/bin/hysteria \
        /etc/systemd/system/hysteria-server.service /etc/systemd/system/hysteria-server@.service
  rm -rf /etc/hysteria /etc/systemd/system/hysteria-server.service.d \
         /etc/systemd/system/hysteria-server@.service.d
  systemctl daemon-reload >/dev/null 2>&1
  iptables -D INPUT -p udp --dport 443 -j ACCEPT 2>/dev/null
  command -v ufw >/dev/null 2>&1 && ufw --force delete allow 443/udp >/dev/null 2>&1
  command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1
  ok "Hysteria UDP désinstallé."
  pause
}

