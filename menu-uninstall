#!/bin/bash
# ============================================================
#  RHAFF SERVICE · désinstallation / réinitialisation complète
#  (commande : menu-uninstall  ·  alias : uninstall)
#  Supprime TOUT : panel, bot, services, comptes, Xray,
#  WireGuard, règles réseau, nginx et données.
# ============================================================
source /etc/nvpanel/lib/ui.sh 2>/dev/null || { RED='\033[0;31m'; GRN='\033[0;32m'; YLW='\033[0;33m'; NC='\033[0m'; }
[ "$EUID" -ne 0 ] && { echo "Lance en root."; exit 1; }

# réponse affirmative insensible à la casse (oui/OUI/Oui/o/O/y/yes…)
_yes(){ case "${1,,}" in oui|o|y|yes) return 0;; *) return 1;; esac; }

clear
printf "${RED}"
cat <<'ART'
   ┌───────────────────────────────────────────────────────┐
   │     DESINSTALLATION DE  R H A F F   S E R V I C E     │
   └───────────────────────────────────────────────────────┘
ART
printf "${NC}\n"
echo " Cette action supprime et réinitialise TOUT :"
echo " panel, bot, services, comptes SSH, Xray, WireGuard,"
echo " règles réseau, configs nginx et toutes les données."
echo
ask " Confirmer la désinstallation complète ? (tape OUI) : " c
_yes "$c" || { echo "Annulé."; exit 0; }

echo; printf "${RED}➜ Suppression complète en cours…${NC}\n"

# 1) Comptes SSH gérés
# IMPORTANT : couper la session AVANT userdel. Sur Debian, userdel refuse
# ou échoue silencieusement à supprimer un compte qui a une session active
# (systemd-logind la garde ouverte), même avec -f. Sans ce pkill, tout
# compte connecté au moment de la désinstallation survivait comme
# utilisateur fantôme : invisible du panel (base remise à zéro à la
# réinstallation) mais toujours détecté par `id`, d'où « Existe déjà »
# lors de la recréation d'un compte pourtant absent du tableau de bord.
if [ -f /etc/nvpanel/db/ssh ]; then
  while read -r _ u _; do
    [ -n "$u" ] || continue
    pkill -KILL -u "$u" 2>/dev/null
    userdel -f "$u" 2>/dev/null
  done < /etc/nvpanel/db/ssh
fi
# 2) Services systemd
for s in nvpanel-slowdns nvpanel-udp-custom nvpanel-limit nvpanel-xlimit nvpanel-bot \
         nvpanel-badvpn-7100 nvpanel-badvpn-7200 nvpanel-badvpn-7300 wg-quick@wg0; do
  systemctl stop "$s" >/dev/null 2>&1
  systemctl disable "$s" >/dev/null 2>&1
  rm -f "/etc/systemd/system/$s.service"
done
systemctl daemon-reload >/dev/null 2>&1
# Le bot Telegram doit cesser de répondre : on s'assure qu'aucun processus
# ne survit au retrait du service, et on efface son jeton.
pkill -f 'nvpanel-bot' 2>/dev/null
rm -f /etc/nvpanel/bot.conf 2>/dev/null
# on rétablit le message d'accueil du serveur
rm -f /root/.hushlogin 2>/dev/null

# 3) Tâches cron
( crontab -l 2>/dev/null | grep -v -E 'nvpanel-clean|nvpanel-quota|nvpanel-conso|nvpanel-cli xsample|rhaff-backup' ) | crontab - 2>/dev/null

# 4) Règles iptables + configs nginx
iptables -F NVPANEL_QUOTA 2>/dev/null
iptables -D OUTPUT -j NVPANEL_QUOTA 2>/dev/null
iptables -X NVPANEL_QUOTA 2>/dev/null
# protocoles PPP (L2TP / PPTP / SSTP)
for u in xl2tpd pptpd nvpanel-sstp strongswan-starter strongswan hysteria-server; do
  systemctl disable --now "$u" >/dev/null 2>&1
done
# Hysteria2 : son service et sa configuration survivaient à la désinstallation
# et occupaient encore le port UDP 443 lors de la réinstallation suivante.
if id hysteria >/dev/null 2>&1; then
  if command -v setfacl >/dev/null 2>&1; then
    setfacl -R -x u:hysteria /etc/letsencrypt/live /etc/letsencrypt/archive 2>/dev/null
    find /etc/letsencrypt/live /etc/letsencrypt/archive -type d \
      -exec setfacl -x d:u:hysteria {} + 2>/dev/null
  fi
  userdel -r hysteria >/dev/null 2>&1
fi
rm -rf /etc/hysteria
rm -rf /etc/systemd/system/hysteria-server.service.d /etc/systemd/system/hysteria-server@.service.d
rm -f /usr/local/bin/hysteria /etc/systemd/system/hysteria-server.service \
      /etc/systemd/system/hysteria-server@.service /etc/systemd/system/nvpanel-sstp.service
SSTP_PORT=$(cat /etc/nvpanel/sstp_port 2>/dev/null); SSTP_PORT=${SSTP_PORT:-4443}
XPORT=$(cat /etc/nvpanel/xport 2>/dev/null); XPORT=${XPORT:-443}
rm -f /etc/pptpd.conf /etc/ipsec.conf /etc/ipsec.secrets /etc/xl2tpd/xl2tpd.conf
rm -f /etc/ppp/options.xl2tpd /etc/ppp/options.sstpd /etc/ppp/pptpd-options
rm -f /etc/ppp/ip-up.d/90-nvpanel-device-limit /etc/ppp/ip-down.d/90-nvpanel-device-limit
rm -rf /etc/nvpanel/sstp /etc/nvpanel/l2tp_psk /etc/nvpanel/sstp_port \
       /opt/nvpanel-sstp /opt/nvpanel-sstp-tools /opt/nvpanel-sstp-python
for SSTP_OLD in /opt/.nvpanel-sstp-old.*; do [ -d "$SSTP_OLD" ] && rm -rf "$SSTP_OLD"; done
for SSTP_FAILED in /opt/.nvpanel-sstp-failed.*; do [ -d "$SSTP_FAILED" ] && rm -rf "$SSTP_FAILED"; done
sed -i '/[[:space:]]\(l2tpd\|pptpd\|sstpd\)[[:space:]]/d' /etc/ppp/chap-secrets 2>/dev/null
[ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso remove 2>/dev/null
iptables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300 2>/dev/null
iptables -D INPUT -p udp --dport 5300 -j ACCEPT 2>/dev/null
iptables -D INPUT -p udp --dport 22 -j ACCEPT 2>/dev/null
iptables -D INPUT -p udp --dport 36712 -j ACCEPT 2>/dev/null
iptables -D INPUT -p udp --dport 443 -j ACCEPT 2>/dev/null
iptables -D INPUT -p tcp --dport 8388 -j ACCEPT 2>/dev/null
iptables -D INPUT -p udp --dport 8388 -j ACCEPT 2>/dev/null
iptables -D INPUT -p udp --dport 51820 -j ACCEPT 2>/dev/null
iptables -D INPUT -p tcp --dport 1723 -j ACCEPT 2>/dev/null
iptables -D INPUT -p gre -j ACCEPT 2>/dev/null
iptables -D INPUT -p esp -j ACCEPT 2>/dev/null
iptables -D INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null
iptables -D INPUT -p tcp --dport "$XPORT" -j ACCEPT 2>/dev/null
for p in 500 4500 1701; do iptables -D INPUT -p udp --dport "$p" -j ACCEPT 2>/dev/null; done
iptables -D INPUT -p tcp --dport "$SSTP_PORT" -j ACCEPT 2>/dev/null
IFACE=$(ip route 2>/dev/null | awk '/default/{print $5; exit}')
for net in 10.10.10 10.20.20 10.30.30; do
  [ -n "$IFACE" ] && iptables -t nat -D POSTROUTING -s "$net.0/24" -o "$IFACE" -j MASQUERADE 2>/dev/null
  iptables -D FORWARD -s "$net.0/24" -j ACCEPT 2>/dev/null
  iptables -D FORWARD -d "$net.0/24" -j ACCEPT 2>/dev/null
done
[ -n "$IFACE" ] && iptables -t nat -D POSTROUTING -s 10.66.66.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null
iptables -D FORWARD -i wg0 -j ACCEPT 2>/dev/null
iptables -D FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null
iptables -D FORWARD -p tcp --syn -s 10.20.20.0/24 -j TCPMSS --set-mss 1356 2>/dev/null
command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1
if command -v ufw >/dev/null 2>&1; then
  for rule in 22/udp 443/udp 8388/tcp 8388/udp 51820/udp 1723/tcp "$SSTP_PORT/tcp" 500/udp 4500/udp 1701/udp; do
    ufw --force delete allow "$rule" >/dev/null 2>&1
  done
  ufw --force delete allow 80/tcp >/dev/null 2>&1
  ufw --force delete allow "$XPORT/tcp" >/dev/null 2>&1
  ufw --force delete allow proto gre from any >/dev/null 2>&1
  ufw --force delete allow proto esp from any >/dev/null 2>&1
fi
rm -f /etc/nginx/conf.d/nvpanel.conf /etc/nginx/conf.d/rhaff-http.conf \
      /etc/nginx/conf.d/rhaff-tls.conf /etc/nginx/conf.d/rhaff.conf /etc/nginx/nvpanel-ws.conf
systemctl reload nginx 2>/dev/null

# 5) WireGuard (config créée par le script)
rm -f /etc/wireguard/wg0.conf

# 6) Cœur Xray installé par le panel
if command -v xray >/dev/null 2>&1; then
  printf "${YLW}➜ Suppression du cœur Xray…${NC}\n"
fi
systemctl disable --now xray >/dev/null 2>&1
rm -f /etc/systemd/system/xray.service /etc/systemd/system/xray@.service
rm -rf /etc/systemd/system/xray.service.d /usr/local/etc/xray /usr/local/share/xray /var/log/xray
rm -f /usr/local/bin/xray /etc/logrotate.d/nvpanel-xray
rm -f /etc/letsencrypt/renewal-hooks/deploy/nvpanel-reload
systemctl daemon-reload >/dev/null 2>&1

# 7) Binaires, raccourcis et données
rm -f /usr/local/bin/{menu,acc,dgh,menu-ssh,menu-xray,menu-ss,menu-wg,menu-bot,menu-settings,menu-uninstall,uninstall,update} \
      /usr/local/bin/{nvpanel-cli,nvpanel-bot,nvpanel-limit,nvpanel-quota,nvpanel-clean,nvpanel-conso,nvpanel-ppp} \
      /usr/local/bin/{install-slowdns,install-udp,install-xray,install-tls} \
      /usr/local/bin/{menu-ppp,install-l2tp,install-pptp,install-sstp} \
      /usr/local/bin/{install-hysteria,nvpanel-hysteria}
rm -rf /etc/nvpanel

# On quitte l'écran séparé AVANT le message final, sinon il serait effacé
# en même temps que l'affichage du panel.
type ui_screen_off >/dev/null 2>&1 && ui_screen_off
clear
printf "${GRN}✔ RHAFF SERVICE a été entièrement supprimé et réinitialisé.${NC}\n"
echo "  (les paquets système de base comme nginx/dropbear ne sont pas touchés)"
echo
