#!/bin/bash
# ============================================================
#  nvpanel · limite d'appareils par compte (multi-login)
#  Tourne en boucle (service). Base : /etc/nvpanel/db/limit
#  Format d'une ligne :  utilisateur  nombre_max
# ============================================================
DB=/etc/nvpanel/db/limit
umask 077
[ -f "$DB" ] || touch "$DB"
chmod 600 "$DB" 2>/dev/null

# Liste « pid adresse » des connexions ENTRANTES appartenant à un compte,
# les plus anciennes d'abord.
#
# Deux pièges, tous deux rencontrés en conditions réelles :
#
# 1) On ne compte pas les processus. Une seule application cliente ouvre
#    plusieurs connexions SSH en parallèle — canaux, redirections,
#    reconnexions. Un appareil = une adresse distante.
#
# 2) On ne retient QUE les connexions dont le port local est un port SSH.
#    Le processus sshd d'un client ouvre aussi toutes les connexions du
#    tunnel VERS Internet, et elles lui appartiennent : chaque site visité
#    apparaissait donc comme un appareil supplémentaire, avec une adresse
#    différente à chaque fois. Un client ouvrant une simple page web
#    fabriquait des dizaines d'appareils en quelques secondes et se faisait
#    déconnecter à chaque passage de la boucle. C'est la cause des coupures
#    toutes les 20 secondes.
ssh_ports() {
  local dp
  dp=$(awk -F= '/^DROPBEAR_PORT=/{gsub(/["[:space:]]/,"",$2); p=$2} END{print p}' /etc/default/dropbear 2>/dev/null)
  case "$dp" in ''|*[!0-9]*) dp="" ;; esac
  printf '22 143 %s' "${dp:-}"
}

sessions_of() {
  local ports wanted_uid; ports=" $(ssh_ports) "
  wanted_uid=$(id -u "$1" 2>/dev/null) || return 0

  # Un seul instantané ESTABLISHED est utilisé par appel. Pour SlowDNS, une
  # connexion localhost n'est retenue que si son autre extrémité appartient
  # réellement à dns-server : aucun ancien log, cache ou socket locale d'un
  # autre proxy ne peut être interprété comme un appareil SlowDNS connecté.
  ss -Htnp state established 2>/dev/null | awk -v p="$ports" '
    {
      local_ep=$3
      endpoint=$4
      lport=local_ep
      rport=endpoint
      sub(/^.*:/,"",lport)
      sub(/^.*:/,"",rport)

      # Côté dnstt : mémorise uniquement les endpoints localhost qui sont
      # connectés MAINTENANT vers un des ports SSH réellement utilisés.
      if($0 ~ /users:\(\("dns-server"/ && index(p," " rport " ")>0) {
        slowdns_ep[local_ep]=1
      }

      if(index(p," " lport " ")==0 || $0 !~ /pid=/) next

      peer=endpoint
      if(peer ~ /^\[/) {
        sub(/^\[/,"",peer)
        sub(/\]:[0-9]+$/,"",peer)
      } else {
        sub(/:[0-9]+$/,"",peer)
      }

      line=$0
      while(match(line,/pid=[0-9]+/)) {
        pid=substr(line,RSTART+4,RLENGTH-4)
        n++
        row[n]=pid"|"peer"|"endpoint
        line=substr(line,RSTART+RLENGTH)
      }
    }
    END {
      for(i=1;i<=n;i++) {
        split(row[i],f,"|")
        ip=f[2]; endpoint=f[3]
        if((ip=="127.0.0.1" || ip=="::1") && !slowdns_ep[endpoint]) continue
        print row[i]
      }
    }' | sort -u | while IFS='|' read -r pid ip endpoint; do
      owner_uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status" 2>/dev/null)
      [ "$owner_uid" = "$wanted_uid" ] || continue

      # SSH/Dropbear direct : une IP distante = un appareil.
      # SlowDNS arrive réellement dans sshd depuis 127.0.0.1 ; dnstt ne fournit
      # pas l'IP Internet du client à sshd. On compte donc chaque endpoint local
      # distinct comme une session/appareil SlowDNS au lieu de fusionner tous
      # les utilisateurs sous la fausse "IP client" 127.0.0.1.
      case "$ip" in
        127.0.0.1|::1) key="slowdns:${endpoint}" ;;
        *) key="$ip" ;;
      esac
      printf '%s %s\n' "$pid" "$key"
    done
}

while true; do
  while read -r user max; do
    [ -z "$user" ] && continue
    [[ "$max" =~ ^[0-9]+$ ]] || continue
    [ "$max" -le 0 ] && continue

    list=$(sessions_of "$user")
    [ -z "$list" ] && continue

    devices=$(printf '%s\n' "$list" | awk '{a[$2]=1} END{for(k in a)n++; print n+0}')
    [ "${devices:-0}" -gt "$max" ] 2>/dev/null || continue

    # Dépassement réel : verrouillage COMPLET immédiat. nvpanel-cli applique
    # aussi les effets associés au compte SSH (UDP credential clear) et coupe
    # toutes ses sessions : il ne peut plus se reconnecter avant déverrouillage.
    if /usr/local/bin/nvpanel-cli lock "$user" >/dev/null 2>&1; then
      printf '%s|ssh|%s|%s|%s\n' "$(date '+%F %T')" "$user" "$max" "$devices" \
        >> /var/log/nvpanel-device-lock.log 2>/dev/null || true
    fi
  done < "$DB"

  # Réaction quasi immédiate sans attendre les anciennes 20 secondes.
  sleep 1
done
