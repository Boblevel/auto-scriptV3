#!/bin/bash
# ============================================================
#  nvpanel · limite d'appareils par compte (multi-login)
#  Tourne en boucle (service). Base : /etc/nvpanel/db/limit
#  Format d'une ligne :  utilisateur  nombre_max
# ============================================================
DB=/etc/nvpanel/db/limit
[ -f "$DB" ] || touch "$DB"

# Liste « pid adresse » des connexions ENTRANTES appartenant à un compte,
# les plus anciennes d'abord.
#
# Deux pièges, tous deux rencontrés en conditions réelles :
#
# 1) On ne compte pas les processus. Une seule application cliente ouvre
#    plusieurs connexions SSH en parallèle — canaux, redirections,
#    reconnexions. Un appareil = une adresse distante.
#
# 2) On ne retient QUE les connexions dont le port local est un port SSH.
#    Le processus sshd d'un client ouvre aussi toutes les connexions du
#    tunnel VERS Internet, et elles lui appartiennent : chaque site visité
#    apparaissait donc comme un appareil supplémentaire, avec une adresse
#    différente à chaque fois. Un client ouvrant une simple page web
#    fabriquait des dizaines d'appareils en quelques secondes et se faisait
#    déconnecter à chaque passage de la boucle. C'est la cause des coupures
#    toutes les 20 secondes.
ssh_ports() {
  local dp
  dp=$(grep -oP '^DROPBEAR_PORT=\K[0-9]+' /etc/default/dropbear 2>/dev/null | tail -n1)
  printf '22 143 %s' "${dp:-}"
}

sessions_of() {
  local ports; ports=" $(ssh_ports) "
  ss -tnp state established 2>/dev/null | awk -v p="$ports" '
    /pid=/ {
      local_ep = $3; peer = $4
      lport = local_ep; sub(/^.*:/, "", lport)
      if (index(p, " " lport " ") == 0) next
      if (match($0, /pid=[0-9]+/)) {
        pid = substr($0, RSTART + 4, RLENGTH - 4)
        sub(/:[0-9]+$/, "", peer)
        print pid, peer
      }
    }' | sort -n | while read -r pid ip; do
      owner=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')
      [ "$owner" = "$1" ] || continue
      # SlowDNS termine son tunnel sur SSH en localhost : dans ce cas l'IP
      # publique du téléphone n'est plus visible au niveau SSH. On limite donc
      # honnêtement le nombre de SESSIONS authentifiées (une identité par PID)
      # au lieu de considérer 127.0.0.1 comme un faux appareil unique.
      case "$ip" in 127.0.0.1|::1|\[::1\]) ip="session:$pid" ;; esac
      printf '%s %s\n' "$pid" "${ip:-session:$pid}"
    done
}

while true; do
  while read -r user max; do
    [ -z "$user" ] && continue
    [[ "$max" =~ ^[0-9]+$ ]] || continue
    [ "$max" -le 0 ] && continue
    list=$(sessions_of "$user")
    [ -z "$list" ] && continue
    # les « max » premières adresses vues sont conservées, les suivantes
    # correspondent à des appareils en trop et sont déconnectées
    kept=""; n=0
    while read -r pid ip; do
      [ -z "$pid" ] && continue
      case " $kept " in
        *" $ip "*) ;;
        *) if [ "$n" -lt "$max" ]; then kept="$kept $ip"; n=$((n+1)); else kill -9 "$pid" 2>/dev/null; fi ;;
      esac
    done <<< "$list"
  done < "$DB"
  sleep 20
done
