#!/bin/bash
# ============================================================
#  RHAFF SERVICE · comptes L2TP / PPTP / SSTP
#  Ces trois protocoles reposent tous sur PPP : les comptes
#  vivent dans /etc/ppp/chap-secrets, l'expiration est suivie
#  dans /etc/nvpanel/db/<proto>.
#  Usage : nvpanel-ppp add|list|del|renew|info|purge <proto> ...
# ============================================================
SECRETS=/etc/ppp/chap-secrets
DBDIR=/etc/nvpanel/db
PLIM="$DBDIR/ppp_limit"
PSTATE=/run/nvpanel-ppp-sessions
mkdir -p "$DBDIR" /etc/ppp; touch "$SECRETS" "$PLIM"; chmod 600 "$SECRETS"

_srv(){ case "$1" in l2tp) echo l2tpd ;; pptp) echo pptpd ;; sstp) echo sstpd ;; *) return 1 ;; esac; }
_db(){ echo "$DBDIR/$1"; }
_clean(){ printf '%s' "$1" | tr -d '\r\n\t '; }
# Affichage uniquement (JJ-MM-AAAA) — les dates restent stockées en AAAA-MM-JJ
# partout ailleurs, les comparaisons de tri en dépendent.
_fmtd(){ [ -n "$1" ] && date -d "$1" +"%d-%m-%Y" 2>/dev/null || printf '%s' "$1"; }


_limit_get(){ awk -F'|' -v p="$1" -v u="$2" '$1==p&&$2==u{v=$3} END{print v+0}' "$PLIM" 2>/dev/null; }
_limit_set(){
  local p="$1" u="$2" l="$3" t
  case "$l" in ''|*[!0-9]*) l=0 ;; esac
  t=$(mktemp) || return 1
  awk -F'|' -v p="$p" -v u="$u" '!($1==p&&$2==u)' "$PLIM" 2>/dev/null > "$t"
  printf '%s|%s|%s\n' "$p" "$u" "$l" >> "$t"; mv "$t" "$PLIM"
}
_limit_del(){ local p="$1" u="$2" t; t=$(mktemp) || return 0; awk -F'|' -v p="$p" -v u="$u" '!($1==p&&$2==u)' "$PLIM" 2>/dev/null > "$t"; mv "$t" "$PLIM"; }

# PPP appelle automatiquement ip-up/ip-down à chaque vraie session. Ces deux
# hooks enregistrent compte + interface + IP distante et coupent uniquement la
# nouvelle session qui dépasserait la limite configurée pour CE compte.
_ensure_hooks(){
  local up=/etc/ppp/ip-up.d/90-nvpanel-device-limit down=/etc/ppp/ip-down.d/90-nvpanel-device-limit
  mkdir -p /etc/ppp/ip-up.d /etc/ppp/ip-down.d
  if ! grep -q 'RHAFF_PPP_LIMIT_V2' "$up" 2>/dev/null; then
    cat > "$up" <<'EOF'
#!/bin/sh
# RHAFF_PPP_LIMIT_V2
LIM=/etc/nvpanel/db/ppp_limit
STATE=/run/nvpanel-ppp-sessions
user=${PEERNAME:-}
iface=${IFNAME:-$1}
ip=${IPREMOTE:-$5}
pid=${PPPD_PID:-$PPID}
[ -n "$user" ] && [ -n "$iface" ] || exit 0
proto=""
args=$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
case "$args $PPP_IPPARAM $6" in
  *options.xl2tpd*|*l2tp*) proto=l2tp ;;
  *pptpd-options*|*pptp*) proto=pptp ;;
  *options.sstpd*|*sstp*) proto=sstp ;;
esac
if [ -z "$proto" ]; then
  c=0
  for p in l2tp pptp sstp; do
    if awk -v u="$user" '$1=="###"&&$2==u{f=1} END{exit !f}' "/etc/nvpanel/db/$p" 2>/dev/null; then proto=$p; c=$((c+1)); fi
  done
  [ "$c" -eq 1 ] || exit 0
fi
mkdir -p /run; touch "$STATE"
tmp=$(mktemp /run/nvppp.XXXXXX) || exit 0
while IFS='|' read -r p u f rip first rpid; do
  [ -n "$f" ] && [ -d "/sys/class/net/$f" ] && printf '%s|%s|%s|%s|%s|%s\n' "$p" "$u" "$f" "$rip" "$first" "$rpid" >> "$tmp"
done < "$STATE"
mv "$tmp" "$STATE"
lim=$(awk -F'|' -v p="$proto" -v u="$user" '$1==p&&$2==u{v=$3} END{print v+0}' "$LIM" 2>/dev/null)
now=$(date +%s)
# Une même IP compte pour un seul appareil même si elle ouvre plusieurs PPP.
if [ "${lim:-0}" -gt 0 ] 2>/dev/null; then
  exists=$(awk -F'|' -v p="$proto" -v u="$user" -v i="$ip" '$1==p&&$2==u&&$4==i{f=1} END{print f+0}' "$STATE")
  n=$(awk -F'|' -v p="$proto" -v u="$user" '$1==p&&$2==u{a[$4]=1} END{for(i in a)c++; print c+0}' "$STATE")
  if [ "$exists" -eq 0 ] && [ "$n" -ge "$lim" ]; then
    kill "$pid" 2>/dev/null
    exit 0
  fi
fi
# remplace l'éventuelle ancienne ligne de cette interface
awk -F'|' -v f="$iface" '$3!=f' "$STATE" > "$STATE.tmp" 2>/dev/null
printf '%s|%s|%s|%s|%s|%s\n' "$proto" "$user" "$iface" "${ip:--}" "$now" "$pid" >> "$STATE.tmp"
mv "$STATE.tmp" "$STATE"
exit 0
EOF
    chmod 755 "$up"
  fi
  if ! grep -q 'RHAFF_PPP_LIMIT_V2' "$down" 2>/dev/null; then
    cat > "$down" <<'EOF'
#!/bin/sh
# RHAFF_PPP_LIMIT_V2
STATE=/run/nvpanel-ppp-sessions
iface=${IFNAME:-$1}
[ -f "$STATE" ] || exit 0
awk -F'|' -v f="$iface" '$3!=f' "$STATE" > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE"
exit 0
EOF
    chmod 755 "$down"
  fi
}

_prune_sessions(){
  [ -f "$PSTATE" ] || { touch "$PSTATE" 2>/dev/null; return; }
  local t p u f ip first pid
  t=$(mktemp) || return
  while IFS='|' read -r p u f ip first pid; do
    [ -n "$f" ] && [ -d "/sys/class/net/$f" ] && printf '%s|%s|%s|%s|%s|%s\n' "$p" "$u" "$f" "$ip" "$first" "$pid" >> "$t"
  done < "$PSTATE"
  mv "$t" "$PSTATE"
}
_drop_user_sessions(){
  local proto="$1" user="$2" p u f ip first pid
  _prune_sessions
  while IFS='|' read -r p u f ip first pid; do
    [ "$p" = "$proto" ] && [ "$u" = "$user" ] || continue
    kill "$pid" 2>/dev/null || ip link set "$f" down 2>/dev/null
  done < "$PSTATE"
  _prune_sessions
}

_box(){ # proto user pass created exp
  local proto="$1" u="$2" p="$3" cr="$4" ex="$5" ip host port lim
  ip=$(cat /etc/nvpanel/ip 2>/dev/null)
  lim=$(_limit_get "$proto" "$u"); [ "$lim" -gt 0 ] 2>/dev/null || lim="illimité"
  host=$(cat /etc/nvpanel/domain 2>/dev/null); [ -z "$host" ] && host="$ip"
  case "$proto" in
    l2tp) port="UDP 500 / 4500 / 1701" ;;
    pptp) port="TCP 1723 (+ GRE)" ;;
    sstp) port="TCP $(cat /etc/nvpanel/sstp_port 2>/dev/null || echo 4443)" ;;
  esac
  cat <<EOF
========== 🔐 COMPTE ${proto^^} ==========
🖥️ IP serveur  : $ip
🌐 Hôte        : $host
👤 Utilisateur : $u
🔑 Mot de passe: $p
📱 Appareils   : $lim
🔌 Ports       : $port
EOF
  [ "$proto" = l2tp ] && printf '🗝️ Clé partagée: %s\n' "$(cat /etc/nvpanel/l2tp_psk 2>/dev/null)"
  cat <<EOF
📅 Créé le     : $(_fmtd "$cr")
⏳ Expire le   : $(_fmtd "$ex")
==================================
EOF
}

cmd="$1"; shift 2>/dev/null
case "$cmd" in
  add)
    proto=$(_clean "$1"); user=$(_clean "$2"); pass=$(_clean "$3"); days="$4"; lim="${5:-0}"
    srv=$(_srv "$proto") || { echo "ERR proto"; exit 1; }
    [ -z "$user" ] || [ -z "$pass" ] && { echo "ERR args"; exit 1; }
    [[ "$days" =~ ^[0-9]+$ ]] || days=30
    [[ "$lim" =~ ^[0-9]+$ ]] || lim=0
    _ensure_hooks
    db=$(_db "$proto"); touch "$db"
    grep -q "^### $user " "$db" && { echo "ERR exists"; exit 1; }
    exp=$(date -d "+$days days" +"%Y-%m-%d"); cr=$(date +"%Y-%m-%d")
    printf '%s %s %s *\n' "$user" "$srv" "$pass" >> "$SECRETS"
    echo "### $user $pass $exp" >> "$db"
    _limit_set "$proto" "$user" "$lim"
    echo "OK $user $exp"
    _box "$proto" "$user" "$pass" "$cr" "$exp" ;;
  list)
    proto=$(_clean "$1"); db=$(_db "$proto"); today=$(date +%F)
    awk -v d="$today" '/^### /{ st=($5=="L")?"verrou":(($4!="" && $4<=d)?"expiré":"actif"); print $2"|"$4"|"st }' "$db" 2>/dev/null ;;
  lock)
    proto=$(_clean "$1"); user=$(_clean "$2"); srv=$(_srv "$proto") || { echo "ERR proto"; exit 1; }
    db=$(_db "$proto")
    grep -q "^### $user " "$db" 2>/dev/null || { echo "ERR nouser"; exit 1; }
    # La ligne d'authentification est mise en commentaire : le compte ne peut
    # plus se connecter, mais ses identifiants sont conservés.
    sed -i "s|^$user[[:space:]]\+$srv[[:space:]]|#RHAFFLOCK $user $srv |" "$SECRETS"
    sed -i "s|^### $user \([^ ]*\) \([^ ]*\).*|### $user \1 \2 L|" "$db"
    _drop_user_sessions "$proto" "$user"
    echo "OK locked" ;;
  unlock)
    proto=$(_clean "$1"); user=$(_clean "$2"); srv=$(_srv "$proto") || { echo "ERR proto"; exit 1; }
    db=$(_db "$proto")
    grep -q "^### $user " "$db" 2>/dev/null || { echo "ERR nouser"; exit 1; }
    sed -i "s|^#RHAFFLOCK $user $srv |$user $srv |" "$SECRETS"
    sed -i "s|^### $user \([^ ]*\) \([^ ]*\).*|### $user \1 \2|" "$db"
    echo "OK unlocked" ;;
  info)
    proto=$(_clean "$1"); user=$(_clean "$2"); db=$(_db "$proto")
    row=$(grep "^### $user " "$db" 2>/dev/null | head -1)
    [ -z "$row" ] && { echo "ERR nouser"; exit 1; }
    echo "OK $user"
    _box "$proto" "$user" "$(echo "$row" | awk '{print $3}')" "-" "$(echo "$row" | awk '{print $4}')" ;;
  del)
    proto=$(_clean "$1"); user=$(_clean "$2"); srv=$(_srv "$proto") || { echo "ERR proto"; exit 1; }
    db=$(_db "$proto")
    grep -q "^### $user " "$db" 2>/dev/null || { echo "ERR nouser"; exit 1; }
    sed -i "/^$user[[:space:]]\+$srv[[:space:]]/d" "$SECRETS"
    sed -i "/^### $user /d" "$db"
    _limit_del "$proto" "$user"
    _drop_user_sessions "$proto" "$user"
    echo "OK deleted" ;;
  renew)
    proto=$(_clean "$1"); user=$(_clean "$2"); days="$3"; db=$(_db "$proto")
    grep -q "^### $user " "$db" 2>/dev/null || { echo "ERR nouser"; exit 1; }
    [[ "$days" =~ ^[0-9]+$ ]] || { echo "ERR days"; exit 1; }
    exp=$(date -d "+$days days" +"%Y-%m-%d")
    sed -i "s|^### $user \([^ ]*\) .*|### $user \1 $exp|" "$db"
    echo "OK $user $exp" ;;
  purge)
    proto=$(_clean "$1"); mode=$(_clean "$2"); srv=$(_srv "$proto") || { echo "ERR proto"; exit 1; }
    db=$(_db "$proto"); today=$(date +%F); n=0
    list=$(awk -v d="$today" -v m="$mode" '/^### /{ if (m=="all" || ($4!="" && $4<=d)) print $2 }' "$db" 2>/dev/null)
    for u in $list; do
      [ -z "$u" ] && continue
      sed -i "/^$u[[:space:]]\+$srv[[:space:]]/d" "$SECRETS"
      sed -i "/^### $u /d" "$db"
      _limit_del "$proto" "$u"
      _drop_user_sessions "$proto" "$u"
      n=$((n+1))
    done
    echo "OK $n" ;;
  sessions)
    proto=$(_clean "$1"); user=$(_clean "$2"); _ensure_hooks; _prune_sessions
    now=$(date +%s)
    awk -F'|' -v p="$proto" -v u="$user" -v n="$now" '
      $1==p&&$2==u{a[$4]=1; if(first==0||$5<first) first=$5}
      END{for(i in a)c++; print c+0 "|" first+0}' "$PSTATE" 2>/dev/null ;;
  online)
    proto=$(_clean "$1"); _ensure_hooks; _prune_sessions
    awk -F'|' -v p="$proto" '$1==p{a[$2 SUBSEP $4]=1} END{for(i in a)c++; print c+0}' "$PSTATE" 2>/dev/null ;;
  *) echo "usage: nvpanel-ppp add|list|info|del|renew|lock|unlock|purge|sessions|online <proto> ..."; exit 1 ;;
esac
exit 0
