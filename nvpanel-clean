#!/bin/bash
# ============================================================
#  nvpanel · nettoyage automatique des comptes expirés
#  (appelé par cron) — SSH + Xray/Shadowsocks + L2TP/PPTP/SSTP
# ============================================================
now=$(date +%s)
XCONF=/usr/local/etc/xray/config.json
changed=0

# --- Comptes SSH --------------------------------------------
# On délègue à « nvpanel-cli purge ssh expired » plutôt que de garder une
# logique maison ici. Deux raisons :
#   1) Cette version-ci lisait la date via `chage -l` (texte dépendant de la
#      langue du serveur) puis `date -d` : toute variation de format faisait
#      échouer silencieusement le parsing (compte alors jamais purgé).
#   2) Elle supprimait la fiche du panel (sed) JUSTE APRÈS `userdel`, SANS
#      vérifier que userdel avait réussi. Si userdel échouait pour une
#      raison quelconque (compte système bloqué, verrou...), la fiche
#      disparaissait quand même du panel — mais le compte Linux, lui,
#      restait bien réel, bloquant à jamais la recréation du même nom
#      (« Existe déjà » sans que le compte soit visible nulle part).
# nvpanel-cli purge ssh (déjà utilisée par le nettoyage manuel du menu)
# tue d'abord les sessions actives, vérifie réellement la suppression
# avant de toucher la fiche, et nettoie aussi META/LIMDB/QDB au passage.
[ -x /usr/local/bin/nvpanel-cli ] && /usr/local/bin/nvpanel-cli purge ssh expired >/dev/null 2>&1

# --- Clients Xray / Shadowsocks -----------------------------
purge_proto() {
  local db="$1" tag="$2" today
  [ -f "$db" ] || return
  today=$(date +%F)
  while read -r _ name uuid exp; do
    [ -z "$name" ] && continue
    # Comparaison de DATES, pas d'horodatages. Avec « date -d "$exp" +%s » on
    # obtenait minuit du jour d'expiration : le compte était donc supprimé dès
    # 00h00 CE jour-là, alors qu'il devait rester valable jusqu'à sa fin. Un
    # compte créé pour 1 jour mourait ainsi la nuit suivante, et le client
    # recevait « invalid request user id » alors que sa fiche semblait bonne.
    # nvpanel-cli et nvpanel-ppp utilisent déjà cette comparaison stricte :
    # les trois purges se comportent désormais à l'identique.
    # Un champ non conforme (compte verrouillé : « date L ») est ignoré.
    case "$exp" in ''|*[!0-9-]*) continue ;; esac
    if [ "$exp" \< "$today" ]; then
      local ok=1
      if [ -f "$XCONF" ]; then
        ok=0
        jq "(.inbounds[] | select(.tag==\"$tag\") | .settings.clients) |= map(select(.email!=\"$name\"))" \
          "$XCONF" > "$XCONF.tmp" && mv "$XCONF.tmp" "$XCONF" && ok=1
        [ "$ok" = 1 ] && changed=1
      fi
      # On ne retire la fiche du panel que si la config Xray a bien été mise
      # à jour (ou n'existe pas encore) : sinon un échec silencieux de jq
      # laisserait un client fantôme dans config.json tout en faisant
      # disparaître la fiche du panel, sans doublon détecté à la recréation.
      [ "$ok" = 1 ] && sed -i "/^### $name /d" "$db"
    fi
  done < "$db"
}

purge_proto /etc/nvpanel/db/vmess       vmess-in
purge_proto /etc/nvpanel/db/vless       vless-in
purge_proto /etc/nvpanel/db/trojan      trojan-in
purge_proto /etc/nvpanel/db/shadowsocks ss-in

# --- Comptes L2TP / PPTP / SSTP -----------------------------
# Sans cela, un compte expiré continuerait de fonctionner :
# le fichier chap-secrets ne gère aucune date d'expiration.
for p in l2tp pptp sstp; do
  [ -f "/etc/nvpanel/db/$p" ] || continue
  [ -x /usr/local/bin/nvpanel-ppp ] && /usr/local/bin/nvpanel-ppp purge "$p" expired >/dev/null 2>&1
done

[ "$changed" = "1" ] && systemctl restart xray >/dev/null 2>&1
# les règles de comptage sont établies par compte : on les reconstruit
[ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1
exit 0
