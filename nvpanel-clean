#!/bin/bash
# ============================================================
#  nvpanel · nettoyage automatique des comptes expirés
#  (appelé par cron) — SSH + Xray/Shadowsocks + L2TP/PPTP/SSTP
# ============================================================
now=$(date +%s)
XCONF=/usr/local/etc/xray/config.json
changed=0

# --- Comptes SSH --------------------------------------------
# Un compte SSH expiré (date passée sur "useradd -e") est DÉJÀ bloqué par le
# système lui-même : aucune connexion possible, sans le moindre code de
# notre part. Il n'y a donc plus de raison de le supprimer automatiquement.
# On laisse la fiche visible dans le panel : l'admin voit le compte, son
# état, et choisit lui-même de le prolonger ou de le supprimer — plus de
# disparition silencieuse d'un compte qu'il n'a pas explicitement retiré.
# La purge reste disponible à la demande via le menu « Nettoyage des
# comptes » (nvpanel-cli purge ssh expired), simplement plus en automatique.

# --- Clients Xray / Shadowsocks -----------------------------
# À la différence de SSH, Xray n'a aucun mécanisme natif d'expiration : sans
# action de notre part, un client expiré continuerait de se connecter
# normalement. On ne supprime donc plus la fiche — on la VERROUILLE (retrait
# du client de la config Xray active + marquage "L" en base), exactement
# comme le fait déjà le verrouillage manuel (menu Verrouiller). Le client ne
# peut plus se connecter, mais la fiche reste visible : l'admin la prolonge
# ou la supprime lui-même, plus de disparition automatique.
purge_proto() {
  local db="$1" tag="$2" today
  [ -f "$db" ] || return
  today=$(date +%F)
  while read -r _ name uuid exp fl; do
    [ -z "$name" ] && continue
    [ "$fl" = "L" ] && continue
    # Comparaison de DATES, pas d'horodatages. Avec « date -d "$exp" +%s » on
    # obtenait minuit du jour d'expiration : le compte était donc verrouillé
    # dès 00h00 CE jour-là, alors qu'il devait rester valable jusqu'à sa fin.
    case "$exp" in ''|*[!0-9-]*) continue ;; esac
    if [ "$exp" \< "$today" ]; then
      local ok=1
      if [ -f "$XCONF" ]; then
        ok=0
        jq "(.inbounds[] | select(.tag==\"$tag\") | .settings.clients) |= map(select(.email!=\"$name\"))" \
          "$XCONF" > "$XCONF.tmp" && mv "$XCONF.tmp" "$XCONF" && ok=1
        [ "$ok" = 1 ] && changed=1
      fi
      # On ne marque le verrou que si la config Xray a bien été mise à jour
      # (ou n'existe pas encore) : sinon un échec silencieux de jq laisserait
      # un client fantôme actif dans config.json tout en l'affichant verrouillé.
      [ "$ok" = 1 ] && sed -i "s|^### $name \([^ ]*\) \([^ ]*\).*|### $name \1 \2 L|" "$db"
    fi
  done < "$db"
}

purge_proto /etc/nvpanel/db/vmess       vmess-in
purge_proto /etc/nvpanel/db/vless       vless-in
purge_proto /etc/nvpanel/db/trojan      trojan-in
purge_proto /etc/nvpanel/db/shadowsocks ss-in

# --- Comptes L2TP / PPTP / SSTP -----------------------------
# Comme Xray, chap-secrets ne gère aucune expiration native : sans action de
# notre part, un compte expiré continuerait de fonctionner. On verrouille
# donc chaque compte expiré individuellement (commente sa ligne dans
# chap-secrets + marque "L" en base, exactement comme le verrouillage
# manuel) au lieu de purger — la fiche reste visible, l'admin décide lui-même
# de prolonger ou de supprimer.
today=$(date +%F)
for p in l2tp pptp sstp; do
  db="/etc/nvpanel/db/$p"
  [ -f "$db" ] || continue
  [ -x /usr/local/bin/nvpanel-ppp ] || continue
  while read -r _ user pass exp fl; do
    [ -z "$user" ] && continue
    [ "$fl" = "L" ] && continue
    case "$exp" in ''|*[!0-9-]*) continue ;; esac
    [ "$exp" \< "$today" ] && /usr/local/bin/nvpanel-ppp lock "$p" "$user" >/dev/null 2>&1
  done < "$db"
done

[ "$changed" = "1" ] && systemctl restart xray >/dev/null 2>&1
# les règles de comptage sont établies par compte : on les reconstruit
[ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1
exit 0
