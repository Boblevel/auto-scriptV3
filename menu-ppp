#!/bin/bash
# ============================================================
#  RHAFF SERVICE · gestion L2TP / PPTP / SSTP
#  Usage : menu-ppp l2tp|pptp|sstp
# ============================================================
source /etc/nvpanel/lib/ui.sh
ui_enter; trap ui_leave EXIT INT TERM HUP
[ "$EUID" -ne 0 ] && { err "Lance en root."; exit 1; }

PROTO="$1"
case "$PROTO" in
  l2tp) LABEL="L2TP"; INST=install-l2tp; SVC="xl2tpd" ;;
  pptp) LABEL="PPTP";         INST=install-pptp; SVC="pptpd" ;;
  sstp) LABEL="SSTP";         INST=install-sstp; SVC="nvpanel-sstp" ;;
  *) err "Protocole inconnu"; exit 1 ;;
esac
DB=/etc/nvpanel/db/$PROTO
umask 077
mkdir -p /etc/nvpanel/db; chmod 700 /etc/nvpanel/db 2>/dev/null
touch "$DB"; chmod 600 "$DB" 2>/dev/null

dash(){
  proto_dash "$PROTO" "ppp:$PROTO" ppp
  if systemctl is-active --quiet "$SVC" 2>/dev/null; then
    printf "${CYN}┃${NC} ${GRY}⚙️  Service :${NC} ${GRN}actif${NC}"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
  else
    printf "${CYN}┃${NC} ${GRY}⚙️  Service :${NC} ${RED}arrêté / non installé${NC}"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
  fi
}
header(){ banner; _edge "┏" "┓" "$LABEL"; dash; bot; }

ensure(){
  systemctl is-active --quiet "$SVC" 2>/dev/null && return 0
  header
  warn "$LABEL n'est pas encore installé sur ce serveur."
  printf "   ${YLW}L'installer maintenant ? (o/n) : ${NC}"; ask "" r
  confirm "$r" && { "$INST"; return 1; }
  return 1
}


_rand_name(){ printf 'test%s' "$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c4)"; }
_rand_pass(){ tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c8; }

trial(){
  banner; center " 🎁  COMPTE TEST 24 H " "${BOLD}${WHT}"; line
  printf "   ${GRY}Génération d'un compte $LABEL valable 24 heures…${NC}\n"
  create "$(_rand_name)" "$(_rand_pass)" 1 1
}

pick(){
  PICK=""
  mapfile -t _l < <(nvpanel-ppp list "$PROTO")
  [ "${#_l[@]}" -eq 0 ] && { err "Aucun compte."; pause; return 1; }
  local page=0 size=6 total=${#_l[@]} pages start end i nm ex st color n
  pages=$(( (total + size - 1) / size ))
  while true; do
    header; printf "   ${GRY}Comptes $LABEL · page %d/%d :${NC}\n" "$((page+1))" "$pages"
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r nm ex st <<< "${_l[$i]}"; case "$st" in verrou|expiré) color="$RED" ;; *) color="$GRN" ;; esac
      printf "   ${WHT}%2d${NC}) %-16s ${GRY}exp %s${NC}  ${color}%s${NC}\n" "$((i+1))" "$nm" "$(_fmtd "$ex")" "$st"
    done
    echo; if [ "$pages" -gt 1 ]; then ask "   ➤ N° | n suivante | p précédente | 0 retour : " n; else ask "   ➤ Numéro (0 = annuler) : " n; fi
    case "${n,,}" in n) [ "$pages" -gt 1 ] && [ "$page" -lt $((pages-1)) ] && page=$((page+1)); continue ;; p) [ "$pages" -gt 1 ] && [ "$page" -gt 0 ] && page=$((page-1)); continue ;; esac
    [[ "$n" =~ ^[0-9]+$ ]] || { err "Invalide"; sleep 1; continue; }; [ "$n" -eq 0 ] && return 1
    [ "$n" -ge 1 ] && [ "$n" -le "$total" ] || { err "Hors liste"; sleep 1; continue; }
    PICK="${_l[$((n-1))]%%|*}"; return 0
  done
}

# Activité PPP par compte, basée uniquement sur les processus pppd réels.
# Si le nom du compte n'est pas exposé dans la ligne de commande pppd, on
# n'invente rien et on renvoie « — ».
_ppp_session_info(){
  local u="$1" row n first now et lim cap
  row=$(printf '%s\n' "${PPP_SNAPSHOT:-}" | awk -F'|' -v p="$PROTO" -v u="$u" '$1==p&&$2==u{a[$3]=1; if(first==0||$4<first)first=$4} END{for(i in a)c++; print c+0"|"first+0}')
  n=${row%%|*}; first=${row#*|}
  lim=$(awk -F'|' -v p="$PROTO" -v u="$u" '$1==p&&$2==u{v=$3} END{print v+0}' /etc/nvpanel/db/ppp_limit 2>/dev/null)
  cap="$lim"; [ -z "$cap" ] || [ "$cap" = 0 ] && cap="∞"
  case "$n" in ''|0|*[!0-9]*) printf '%s' "— · 0/$cap IP"; return ;; esac
  case "$first" in ''|0|*[!0-9]*) printf '%s' "— · $n/$cap IP"; return ;; esac
  now=$(date +%s); et=$((now-first)); [ "$et" -lt 0 ] && et=0
  if [ "$et" -ge 3600 ] 2>/dev/null; then
    printf '%dh%02d · %s/%s IP' $((et/3600)) $(((et%3600)/60)) "$n" "$cap"
  else
    printf '%dmin · %s/%s IP' $((et/60)) "$n" "$cap"
  fi
}
create(){
  local u p d lim out
  if [ -n "$1" ]; then
    u="$1"; p="$2"; d="${3:-1}"; lim="${4:-1}"
  else
  header; ask " Nom d'utilisateur : " u
  [ -z "$u" ] && { err "Nom vide"; pause; return; }
  ask " Mot de passe : " p
  [ -z "$p" ] && { err "Mot de passe vide"; pause; return; }
  ask " Durée (jours) : " d; [[ "$d" =~ ^[0-9]+$ ]] || d=30
  ask " Limite d'appareils (0 = illimité) : " lim; [[ "$lim" =~ ^[0-9]+$ ]] || lim=0
  fi
  out=$(nvpanel-ppp add "$PROTO" "$u" "$p" "$d" "$lim")
  clear; header
  if echo "$out" | head -1 | grep -q '^OK'; then
    printf "${GRN}"; echo "$out" | tail -n +2; printf "${NC}"
  else
    case "$out" in *exists*) err "Ce nom existe déjà." ;; *) err "Échec : $out" ;; esac
  fi
  pause
}

list_all(){
  local page=0 size=4 total pages start end i n e s color choice ct
  mapfile -t _rows_ppp < <(nvpanel-ppp list "$PROTO")
  PPP_SNAPSHOT=$(nvpanel-ppp snapshot 2>/dev/null)
  total=${#_rows_ppp[@]}; [ "$total" -eq 0 ] && { header; warn "Aucun compte $LABEL."; pause; return; }
  pages=$(( (total + size - 1) / size ))
  while true; do
    header
    table_top
    printf "${CYN}┃${NC} ${WHT}%-16s %-12s %-8s %s${NC}" "COMPTE" "EXPIRE" "ÉTAT" "CONNECTÉ DEPUIS"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    table_sep
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r n e s <<< "${_rows_ppp[$i]}"; case "$s" in verrou|expiré) color="$RED" ;; *) color="$GRN" ;; esac
      ct="—"; [ "$s" = "actif" ] && ct=$(_ppp_session_info "$n")
      printf "${CYN}┃${NC} %-16s %-12s ${color}%-8s${NC} %s" "$n" "$(_fmtd "$e")" "$s" "$ct"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
      [ "$i" -lt $((end-1)) ] && table_sep
    done
    table_bot
    if [ "$pages" -le 1 ]; then pause; return; fi
    ask "   ➤ n suivante | p précédente | 0 retour : " choice
    case "${choice,,}" in n) [ "$page" -lt $((pages-1)) ] && page=$((page+1)) ;; p) [ "$page" -gt 0 ] && page=$((page-1)) ;; 0|'') return ;; *) warn "Invalide"; sleep 1 ;; esac
  done
}

view(){
  header; pick || return
  out=$(nvpanel-ppp info "$PROTO" "$PICK")
  clear; header
  if echo "$out" | head -1 | grep -q '^OK'; then printf "${GRN}"; echo "$out" | tail -n +2; printf "${NC}"
  else err "Introuvable"; fi
  pause
}

renew(){
  header; pick || return
  ask " Ajouter (jours) : " d
  out=$(nvpanel-ppp renew "$PROTO" "$PICK" "$d")
  echo "$out" | grep -q '^OK' && ok "Prolongé jusqu'au $(_fmtd "$(echo "$out"|awk '{print $3}')")" || err "Échec"
  pause
}

del(){
  header; pick || return
  printf "   ${YLW}Supprimer '%s' ? (o/n) : ${NC}" "$PICK"; ask "" c
  confirm "$c" || { pause; return; }
  out=$(nvpanel-ppp del "$PROTO" "$PICK")
  echo "$out" | grep -q '^OK' && ok "$PICK supprimé" || err "Échec"
  pause
}

cleanup_menu(){
  while true; do
    banner; _edge "┏" "┓" "NETTOYAGE $LABEL"
    local tot exp today c r out
    today=$(date +%F)
    tot=$(grep -c '^### ' "$DB" 2>/dev/null); tot=${tot:-0}
    exp=$(awk -v d="$today" '/^### /{ if ($4!="" && $4<=d) c++ } END{print c+0}' "$DB" 2>/dev/null)
    printf "${CYN}┃${NC} ${GRY}Comptes au total :${NC} ${WHT}%s${NC}    ${GRY}dont expirés :${NC} ${RED}%s${NC}" "$tot" "$exp"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    box_sep
    compact_menu_entry "1" "🧽" "Supprimer les comptes expirés"
    compact_menu_entry "2" "💥" "Supprimer TOUS les comptes"
    compact_menu_entry "0" "⬅️" "Retour"
    bot
    ask "$(printf " ${WHT}➤ Choix :${NC} ")" c
    case "$c" in
      1) [ "$exp" -eq 0 ] && { warn "Aucun compte expiré."; pause; continue; }
         printf "   ${YLW}Supprimer les %s compte(s) expiré(s) ? (o/n) : ${NC}" "$exp"; ask "" r
         confirm "$r" || continue
         out=$(nvpanel-ppp purge "$PROTO" expired)
         ok "$(echo "$out"|awk '{print $2+0}') compte(s) supprimé(s)."; pause ;;
      2) [ "$tot" -eq 0 ] && { warn "Aucun compte."; pause; continue; }
         warn "Cela supprimera les $tot comptes $LABEL. Action irréversible."
         printf "   ${RED}➤ Confirmer la suppression totale ? (o/n) : ${NC}"; ask "" r
         confirm "$r" || { warn "Annulé."; pause; continue; }
         out=$(nvpanel-ppp purge "$PROTO" all)
         ok "$(echo "$out"|awk '{print $2+0}') compte(s) supprimé(s)."; pause ;;
      0) break ;;
      *) warn "Invalide"; sleep 1 ;;
    esac
  done
}

uninstall_proto(){
  banner; center " 🗑️  DÉSINSTALLER $LABEL " "${BOLD}${RED}"; line
  warn "Cela supprime le service $LABEL et TOUS ses comptes."
  printf "   ${GRY}Les autres protocoles ne sont pas touchés.${NC}\n\n"
  printf "   ${RED}➤ Confirmer la désinstallation ? (o/n) : ${NC}"; ask "" r
  confirm "$r" || { warn "Annulé."; pause; return; }

  printf "\n${CYN}➜${NC} Suppression des comptes…\n"
  nvpanel-ppp purge "$PROTO" all >/dev/null 2>&1
  rm -f "/etc/nvpanel/db/$PROTO"

  printf "${CYN}➜${NC} Arrêt et retrait du service…\n"
  export DEBIAN_FRONTEND=noninteractive
  case "$PROTO" in
    l2tp)
      for u in xl2tpd strongswan-starter strongswan ipsec; do systemctl disable --now "$u" >/dev/null 2>&1; done
      apt-get purge -y xl2tpd strongswan >/dev/null 2>&1
      apt-get autoremove -y >/dev/null 2>&1
      rm -f /etc/xl2tpd/xl2tpd.conf /etc/ppp/options.xl2tpd /etc/ipsec.conf /etc/ipsec.secrets /etc/nvpanel/l2tp_psk
      for p in 500 4500 1701; do iptables -D INPUT -p udp --dport $p -j ACCEPT 2>/dev/null; done
      iptables -D INPUT -p esp -j ACCEPT 2>/dev/null
      iptables -t nat -D POSTROUTING -s 10.10.10.0/24 -o "$(ip route 2>/dev/null | awk '/default/{print $5; exit}')" -j MASQUERADE 2>/dev/null
      iptables -D FORWARD -s 10.10.10.0/24 -j ACCEPT 2>/dev/null
      iptables -D FORWARD -d 10.10.10.0/24 -j ACCEPT 2>/dev/null ;;
    pptp)
      systemctl disable --now pptpd >/dev/null 2>&1
      apt-get purge -y pptpd >/dev/null 2>&1
      apt-get autoremove -y >/dev/null 2>&1
      rm -f /etc/pptpd.conf /etc/ppp/pptpd-options
      iptables -D INPUT -p tcp --dport 1723 -j ACCEPT 2>/dev/null
      iptables -D INPUT -p gre -j ACCEPT 2>/dev/null
      iptables -D FORWARD -p tcp --syn -s 10.20.20.0/24 -j TCPMSS --set-mss 1356 2>/dev/null
      iptables -t nat -D POSTROUTING -s 10.20.20.0/24 -o "$(ip route 2>/dev/null | awk '/default/{print $5; exit}')" -j MASQUERADE 2>/dev/null
      iptables -D FORWARD -s 10.20.20.0/24 -j ACCEPT 2>/dev/null
      iptables -D FORWARD -d 10.20.20.0/24 -j ACCEPT 2>/dev/null ;;
    sstp)
      systemctl disable --now nvpanel-sstp >/dev/null 2>&1
      rm -f /etc/systemd/system/nvpanel-sstp.service /etc/ppp/options.sstpd
      local sp; sp=$(cat /etc/nvpanel/sstp_port 2>/dev/null)
      [ -n "$sp" ] && iptables -D INPUT -p tcp --dport "$sp" -j ACCEPT 2>/dev/null
      rm -rf /etc/nvpanel/sstp /etc/nvpanel/sstp_port /opt/nvpanel-sstp \
             /opt/nvpanel-sstp-tools /opt/nvpanel-sstp-python
      for _old in /opt/.nvpanel-sstp-old.*; do [ -d "$_old" ] && rm -rf "$_old"; done
      iptables -t nat -D POSTROUTING -s 10.30.30.0/24 -o "$(ip route 2>/dev/null | awk '/default/{print $5; exit}')" -j MASQUERADE 2>/dev/null
      iptables -D FORWARD -s 10.30.30.0/24 -j ACCEPT 2>/dev/null
      iptables -D FORWARD -d 10.30.30.0/24 -j ACCEPT 2>/dev/null ;;
  esac
  if command -v ufw >/dev/null 2>&1; then
    case "$PROTO" in
      l2tp)
        for _r in 500/udp 4500/udp 1701/udp; do ufw --force delete allow "$_r" >/dev/null 2>&1; done
        ufw --force delete allow proto esp from any >/dev/null 2>&1 ;;
      pptp) ufw --force delete allow 1723/tcp >/dev/null 2>&1; ufw --force delete allow proto gre from any >/dev/null 2>&1 ;;
      sstp) [ -n "${sp:-}" ] && ufw --force delete allow "$sp/tcp" >/dev/null 2>&1 ;;
    esac
  fi
  command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1
  systemctl daemon-reload >/dev/null 2>&1
  [ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1
  ok "$LABEL a été désinstallé."
  pause
}

setup_menu(){
  while true; do
    banner; _edge "┏" "┓" "INSTALLER / DÉSINSTALLER $LABEL"
    if systemctl is-active --quiet "$SVC" 2>/dev/null; then
      printf "${CYN}┃${NC} ${GRY}État actuel :${NC} ${GRN}installé et actif${NC}"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    else
      printf "${CYN}┃${NC} ${GRY}État actuel :${NC} ${RED}non installé${NC}"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    fi
    box_sep
    compact_menu_entry "1" "⬇️" "Installer / réinstaller"
    compact_menu_entry "2" "🗑️" "Désinstaller"
    compact_menu_entry "0" "⬅️" "Retour"
    bot
    ask "$(printf " ${WHT}➤ Choix :${NC} ")" c
    case "$c" in
      1) "$INST" ;;
      2) uninstall_proto ;;
      0) break ;;
      *) warn "Invalide"; sleep 1 ;;
    esac
  done
}

ensure || true
while true; do
  header
  menu_box_top
  compact_menu_entry "1" "➕" "Créer un compte"
  compact_menu_entry "2" "📋" "Lister les comptes"
  compact_menu_entry "3" "🔍" "Revoir un compte"
  compact_menu_entry "4" "♻️" "Prolonger un compte"
  compact_menu_entry "5" "🗑️" "Supprimer un compte"
  compact_menu_entry "6" "🧹" "Nettoyage des comptes"
  compact_menu_entry "7" "🎁" "Compte test 24 h"
  compact_menu_entry "8" "⚙️" "Installer / désinstaller"
  compact_menu_entry "0" "⬅️" "Retour"
  menu_box_bot
  ask "$(printf " ${WHT}➤ Choix :${NC} ")" o || break
  case "$o" in
    1) create ;; 2) list_all ;; 3) view ;; 4) renew ;; 5) del ;;
    6) cleanup_menu ;; 7) trial ;; 8) setup_menu ;; 0) break ;; *) warn "Invalide"; sleep 1 ;;
  esac
done
