#!/bin/bash
# ============================================================
#  RHAFF SERVICE · installation Hysteria2   (install-hysteria [auto])
# ============================================================
source /etc/nvpanel/lib/ui.sh
[ "$EUID" -ne 0 ] && { err "Lance en root."; exit 1; }
AUTO=0; [ "$1" = "auto" ] && AUTO=1
PORT=443
DOMAIN=$(cat /etc/nvpanel/domain 2>/dev/null)
CERT="/etc/letsencrypt/live/$DOMAIN"

[ "$AUTO" = 1 ] || { banner; center " INSTALLATION HYSTERIA2 " "${BOLD}${WHT}"; line; printf "${CYN}➜${NC} Installation (1 à 2 minutes)…\n"; }

# Hysteria a besoin d'un vrai certificat TLS : on réutilise celui déjà
# émis par install-tls, jamais une deuxième émission ACME séparée.
if [ -z "$DOMAIN" ] || [ ! -f "$CERT/fullchain.pem" ]; then
  if [ "$AUTO" = 1 ]; then printf "  ${YLW}!${NC} Hysteria nécessite un domaine + TLS (Paramètres 1 puis 2).\n"; exit 1; fi
  clear; banner; center " ✘  DOMAINE / TLS REQUIS " "${BOLD}${RED}"; line
  err "Configure d'abord un domaine (Paramètres → 1) puis active le TLS (Paramètres → 2)."
  pause; exit 1
fi

bash <(curl -fsSL https://get.hy2.sh/) > /var/log/nvpanel-hysteria-install.log 2>&1

# Sans cette vérification, un échec de l'installateur officiel (réseau,
# dépôt injoignable, apt en échec…) passait totalement inaperçu : le
# script continuait comme si de rien n'était, activait un service sans
# binaire, et finissait par un message générique « non activé » sans
# jamais dire pourquoi.
if ! command -v hysteria >/dev/null 2>&1; then
  if [ "$AUTO" = 1 ]; then
    printf "  ${RED}✘${NC} Installation de Hysteria2 échouée (voir /var/log/nvpanel-hysteria-install.log).\n"
    exit 1
  fi
  clear; banner; center " ✘  INSTALLATION HYSTERIA2 ÉCHOUÉE " "${BOLD}${RED}"; line
  err "Le binaire Hysteria2 n'a pas pu être installé."
  printf "\n   ${GRY}Détail : tail -20 /var/log/nvpanel-hysteria-install.log${NC}\n"
  pause; exit 1
fi

# Hysteria tourne sous un utilisateur dédié (pas root) : sans ceci, il ne
# peut pas lire le certificat Let's Encrypt (dossier root-only par défaut).
# Les ACL par défaut (-d) garantissent que ça survit aux renouvellements
# automatiques du certificat dans 90 jours.
apt-get install -y acl >/dev/null 2>&1
if id hysteria >/dev/null 2>&1 && command -v setfacl >/dev/null 2>&1; then
  setfacl -R -m u:hysteria:rX /etc/letsencrypt/live/ /etc/letsencrypt/archive/ 2>/dev/null
  setfacl -R -d -m u:hysteria:rX /etc/letsencrypt/live/ /etc/letsencrypt/archive/ 2>/dev/null
fi

mkdir -p /etc/nvpanel/db /etc/hysteria
touch /etc/nvpanel/db/hysteria

if command -v /usr/local/bin/nvpanel-hysteria >/dev/null 2>&1; then
  /usr/local/bin/nvpanel-hysteria rebuild >/dev/null 2>&1
else
  # config minimale si nvpanel-hysteria n'est pas encore en place
  cat > /etc/hysteria/config.yaml <<EOF
listen: :$PORT
tls:
  cert: $CERT/fullchain.pem
  key: $CERT/privkey.pem
auth:
  type: userpass
  userpass: {}
masquerade:
  type: proxy
  proxy:
    url: https://news.ycombinator.com/
    rewriteHost: true
EOF
fi

systemctl enable hysteria-server >/dev/null 2>&1

# Hysteria refuse de démarrer avec un auth.userpass vide (aucun compte) :
# on ne force le démarrage que s'il existe déjà au moins un compte.
HAS_ACCOUNT=0
grep -q '^### ' /etc/nvpanel/db/hysteria 2>/dev/null && HAS_ACCOUNT=1

if [ "$HAS_ACCOUNT" = 1 ]; then
  systemctl restart hysteria-server >/dev/null 2>&1
  sleep 2
fi

iptables -C INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null
command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi active && ufw allow $PORT/udp >/dev/null 2>&1
[ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1

OK=0; systemctl is-active --quiet hysteria-server && OK=1

if [ "$AUTO" = 1 ]; then
  if [ "$OK" = 1 ]; then printf "  ${GRN}✔${NC} Hysteria2 prêt.\n"
  elif [ "$HAS_ACCOUNT" = 0 ]; then printf "  ${CYN}i${NC} Hysteria2 installé, en attente d'un premier compte.\n"
  else printf "  ${YLW}!${NC} Hysteria2 non activé.\n"; fi
  exit 0
fi
clear; banner
if [ "$OK" = 1 ]; then
  center " ✔  HYSTERIA2 OPÉRATIONNEL " "${BOLD}${GRN}"; line
  ok "Service actif sur le port UDP $PORT."
  printf "\n   ${GRY}Crée un compte via le menu Hysteria pour obtenir un lien de connexion.${NC}\n"
elif [ "$HAS_ACCOUNT" = 0 ]; then
  center " ℹ️  HYSTERIA2 INSTALLÉ " "${BOLD}${CYN}"; line
  printf "   ${WHT}Binaire, certificat et configuration prêts.${NC}\n"
  printf "   ${GRY}Le service démarre automatiquement dès la création du premier compte.${NC}\n"
  printf "   ${GRY}Menu Hysteria2 → 1) Créer un compte.${NC}\n"
else
  center " ✘  HYSTERIA2 NON ACTIVÉ " "${BOLD}${RED}"; line
  err "Le service n'a pas démarré."
fi
pause
