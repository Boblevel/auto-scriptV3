from pathlib import Path

DBDIR = Path("/etc/nvpanel/db")
LIMIT_DB = DBDIR / "proto_limit"
STATE_FILE = DBDIR / "guard_state.json"
LOCK_FILE = DBDIR / ".guard.lock"
XCONF = Path("/usr/local/etc/xray/config.json")
XAPI = "127.0.0.1:10085"
GUARD_HOST = "127.0.0.1"
GUARD_PORT = 10086
HYST_DB = DBDIR / "hysteria"
HYST_SECRET_FILE = Path("/etc/nvpanel/hysteria_stats_secret")
HYST_STATS = "http://127.0.0.1:10087"
XRAY_TTL = 120

INBOUND_TO_PROTO = {
    "vmess-in": "vmess",
    "vless-in": "vless",
    "trojan-in": "trojan",
    "ss-in": "ss",
}
PROTO_TO_INBOUND = {v: k for k, v in INBOUND_TO_PROTO.items()}
PROTO_DB = {
    "vmess": DBDIR / "vmess",
    "vless": DBDIR / "vless",
    "trojan": DBDIR / "trojan",
    "ss": DBDIR / "shadowsocks",
    "hysteria": HYST_DB,
    "l2tp": DBDIR / "l2tp",
    "pptp": DBDIR / "pptp",
    "sstp": DBDIR / "sstp",
}


def _ensure_dirs():
    DBDIR.mkdir(parents=True, exist_ok=True)
    LIMIT_DB.touch(exist_ok=True)
    LOCK_FILE.touch(exist_ok=True)


def _locked_state(mutator=None):
    """Charge l'état sous verrou inter-processus; sauvegarde si mutator fourni."""
    _ensure_dirs()
    with LOCK_FILE.open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            try:
                state = json.loads(STATE_FILE.read_text()) if STATE_FILE.exists() else {}
                if not isinstance(state, dict):
                    state = {}
            except Exception:
                state = {}
            state.setdefault("xray", {})
            state.setdefault("ppp", {})
            state.setdefault("hysteria", {})
            result = mutator(state) if mutator else state
            if mutator:
                tmp = STATE_FILE.with_suffix(".tmp")
                tmp.write_text(json.dumps(state, separators=(",", ":"), sort_keys=True))
                os.chmod(tmp, 0o600)
                os.replace(tmp, STATE_FILE)
            return result
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def _norm_proto(proto):
    p = (proto or "").strip().lower()
    return "ss" if p in ("ss", "shadowsocks") else p


def _get_limit(proto, user):
    proto = _norm_proto(proto)
    try:
        for line in LIMIT_DB.read_text().splitlines():
            parts = line.split("|")
            if len(parts) == 3 and parts[0] == proto and parts[1] == user:
                try:
                    return max(0, int(parts[2]))
                except ValueError:
                    return 0
    except OSError:
        pass
    return 0


def _set_limit(proto, user, value):
    proto = _norm_proto(proto)
    try:
        value = max(0, int(value))
    except (TypeError, ValueError):
        value = 0
    _ensure_dirs()
    with LOCK_FILE.open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        rows = []
        try:
            rows = LIMIT_DB.read_text().splitlines()
        except OSError:
            pass
        rows = [r for r in rows if not r.startswith(f"{proto}|{user}|")]
        rows.append(f"{proto}|{user}|{value}")
        tmp = LIMIT_DB.with_suffix(".tmp")
        tmp.write_text("\n".join(rows) + ("\n" if rows else ""))
        os.chmod(tmp, 0o600)
        os.replace(tmp, LIMIT_DB)
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def _del_limit(proto, user):
    proto = _norm_proto(proto)
    _ensure_dirs()
    with LOCK_FILE.open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            rows = LIMIT_DB.read_text().splitlines()
        except OSError:
            rows = []
        rows = [r for r in rows if not r.startswith(f"{proto}|{user}|")]
        tmp = LIMIT_DB.with_suffix(".tmp")
        tmp.write_text("\n".join(rows) + ("\n" if rows else ""))
        os.chmod(tmp, 0o600)
        os.replace(tmp, LIMIT_DB)
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def _account_row(proto, user):
    path = PROTO_DB.get(_norm_proto(proto))
    if not path or not path.exists():
        return None
    try:
        for line in path.read_text(errors="ignore").splitlines():
            if not line.startswith("### "):
                continue
            parts = line.split()
            if len(parts) >= 4 and parts[1] == user:
                return parts
    except OSError:
        pass
    return None


def _active_account(proto, user):
    row = _account_row(proto, user)
    if not row:
        return False
    if len(row) >= 5 and row[4] == "L":
        return False
    exp = row[3]
    return not exp or exp > time.strftime("%Y-%m-%d")


def _parse_source(source):
    if not source:
        return ""
    s = str(source)
    if ":" in s and s.split(":", 1)[0] in ("tcp", "udp"):
        s = s.split(":", 1)[1]
    if s.startswith("[") and "]" in s:
        ip = s[1:s.index("]")]
    else:
        ip = s.rsplit(":", 1)[0] if ":" in s else s
    try:
        return str(ipaddress.ip_address(ip))
    except ValueError:
        return ""


def _fmt_since(ts):
    try:
        ts = int(ts)
    except (TypeError, ValueError):
        return "—"
    if ts <= 0:
        return "—"
    d = max(0, int(time.time()) - ts)
    if d < 60:
        return "< 1 min"
    if d < 3600:
        return f"{d // 60} min"
    if d < 86400:
        return f"{d // 3600} h {(d % 3600) // 60:02d}"
    return f"{d // 86400} j {(d % 86400) // 3600} h"


def _prune_xray_state(state, now=None):
    now = int(now or time.time())
    xray = state.setdefault("xray", {})
    for proto in list(xray):
        users = xray.get(proto, {})
        if not isinstance(users, dict):
            xray[proto] = {}
            continue
        for user in list(users):
            rec = users[user]
            ips = rec.get("ips", {}) if isinstance(rec, dict) else {}
            for ip in list(ips):
                try:
                    last = int(ips[ip].get("last", 0))
                except Exception:
                    last = 0
                if now - last > XRAY_TTL:
                    ips.pop(ip, None)
            if not ips:
                users.pop(user, None)
    return state


def _xray_allowed_and_blocked(proto, user, rec):
    ips = rec.get("ips", {}) if isinstance(rec, dict) else {}
    ordered = sorted(ips.items(), key=lambda item: (int(item[1].get("first", 0)), item[0]))
    lim = _get_limit(proto, user)
    if lim <= 0:
        return ordered, []
    return ordered[:lim], ordered[lim:]


def _xray_rule_snapshot():
    def read(state):
        _prune_xray_state(state)
        blocks = []
        for proto, users in state.get("xray", {}).items():
            inbound = PROTO_TO_INBOUND.get(proto)
            if not inbound:
                continue
            for user, rec in users.items():
                if not _active_account(proto, user):
                    continue
                _, denied = _xray_allowed_and_blocked(proto, user, rec)
                for ip, _meta in denied:
                    blocks.append((proto, user, inbound, ip))
        return sorted(blocks)
    # Pruning needs to be persisted.
    return _locked_state(lambda state: read(state))


_last_xray_signature = None
_xray_apply_lock = threading.Lock()
_xray_event_lock = threading.Lock()
_xray_event_seen = {}


def _apply_xray_rules(force=False):
    global _last_xray_signature
    if not XCONF.exists() or not shutil_which("xray"):
        return False
    blocks = _xray_rule_snapshot()
    signature = tuple(blocks)
    if not force and signature == _last_xray_signature:
        return True
    with _xray_apply_lock:
        try:
            conf = json.loads(XCONF.read_text())
            rules = list((conf.get("routing") or {}).get("rules") or [])
            base = [r for r in rules if not str(r.get("ruleTag", "")).startswith("nvguard-")]
            dyn = []
            for proto, user, inbound, ip in blocks:
                digest = hashlib.sha1(f"{proto}|{user}|{ip}".encode()).hexdigest()[:12]
                dyn.append({
                    "type": "field",
                    "inboundTag": [inbound],
                    "user": [user],
                    "sourceIP": [ip],
                    "outboundTag": "blocked",
                    "ruleTag": f"nvguard-block-{digest}",
                })
            track = {
                "type": "field",
                "inboundTag": ["vmess-in", "vless-in", "trojan-in", "ss-in"],
                "network": "tcp,udp",
                "outboundTag": "direct",
                "ruleTag": "nvguard-track",
                "webhook": {
                    "url": f"http://{GUARD_HOST}:{GUARD_PORT}/xray",
                    "deduplication": 1,
                    "headers": {"X-NVGuard": "1"},
                },
            }
            # Les règles de blocage doivent passer AVANT les éventuelles
            # règles de routage utilisateur. On conserve seulement la route
            # API en tête, puis les blocs dynamiques, puis tout le routage
            # existant dans son ordre d'origine.
            api_base = [r for r in base if "api" in (r.get("inboundTag") or []) and r.get("outboundTag") == "api"]
            other_base = [r for r in base if r not in api_base]
            payload = {"routing": {"rules": api_base + dyn + other_base + [track]}}
            with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as fp:
                json.dump(payload, fp, separators=(",", ":"))
                tmp = fp.name
            try:
                cp = subprocess.run(
                    ["xray", "api", "adrules", f"--server={XAPI}", tmp],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=5,
                )
                if cp.returncode == 0:
                    _last_xray_signature = signature
                    return True
            finally:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
        except Exception:
            pass
    return False


def _record_xray_event(payload):
    user = str(payload.get("email") or "").strip()
    inbound = str(payload.get("inboundTag") or "").strip()
    proto = INBOUND_TO_PROTO.get(inbound)
    ip = _parse_source(payload.get("source"))
    if not user or not proto or not ip or not _active_account(proto, user):
        return
    # Les WS doivent fournir une vraie IP via XFF. Si ce n'est pas le cas,
    # on refuse de fabriquer un appareil à partir de localhost.
    if proto != "ss" and ipaddress.ip_address(ip).is_loopback:
        return
    now = int(time.time())
    # Un même client peut ouvrir énormément de flux en quelques secondes.
    # Le webhook reste temps-réel, mais on n'écrit l'état disque qu'au plus
    # une fois toutes les 5 secondes pour le même compte/IP.
    key = (proto, user, ip)
    with _xray_event_lock:
        prev = int(_xray_event_seen.get(key, 0) or 0)
        if now - prev < 5:
            return
        _xray_event_seen[key] = now
        # Empêche le cache mémoire de grossir indéfiniment.
        if len(_xray_event_seen) > 4096:
            cutoff = now - XRAY_TTL
            for old_key, seen in list(_xray_event_seen.items()):
                if int(seen or 0) < cutoff:
                    _xray_event_seen.pop(old_key, None)

    def mutate(state):
        _prune_xray_state(state, now)
        users = state.setdefault("xray", {}).setdefault(proto, {})
        rec = users.setdefault(user, {"ips": {}})
        ips = rec.setdefault("ips", {})
        meta = ips.setdefault(ip, {"first": now, "last": now})
        meta["first"] = int(meta.get("first") or now)
        meta["last"] = now
    _locked_state(mutate)
    _apply_xray_rules()


def _xray_user(proto, user):
    proto = _norm_proto(proto)
    now = int(time.time())

    def read(state):
        _prune_xray_state(state, now)
        rec = state.get("xray", {}).get(proto, {}).get(user, {"ips": {}})
        allowed, _denied = _xray_allowed_and_blocked(proto, user, rec)
        first = min((int(m.get("first", 0)) for _ip, m in allowed), default=0)
        return len(allowed), first
    return _locked_state(lambda state: read(state))


def _xray_count_accounts(proto):
    proto = _norm_proto(proto)
    now = int(time.time())

    def read(state):
        _prune_xray_state(state, now)
        n = 0
        for user, rec in state.get("xray", {}).get(proto, {}).items():
            if not _active_account(proto, user):
                continue
            allowed, _denied = _xray_allowed_and_blocked(proto, user, rec)
            if allowed:
                n += 1
        return n
    return _locked_state(lambda state: read(state))


def _clear_xray(proto=None, user=None):
    proto = _norm_proto(proto) if proto else None

    def mutate(state):
        x = state.setdefault("xray", {})
        if proto is None:
            x.clear()
        elif user is None:
            x.pop(proto, None)
        else:
            x.get(proto, {}).pop(user, None)
    _locked_state(mutate)
    _apply_xray_rules(force=True)


def _hyst_secret():
    try:
        return HYST_SECRET_FILE.read_text().strip()
    except OSError:
        return ""


def _hyst_request(path, method="GET", data=None):
    secret = _hyst_secret()
    if not secret:
        return None
    headers = {"Authorization": secret}
    body = None
    if data is not None:
        body = json.dumps(data).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(HYST_STATS + path, data=body, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=2) as res:
            raw = res.read()
        return json.loads(raw.decode() or "{}")
    except Exception:
        return None


def _hyst_online_map():
    data = _hyst_request("/online")
    return data if isinstance(data, dict) else {}


def _hyst_kick(user):
    return _hyst_request("/kick", method="POST", data=[user]) is not None


def _verify_hysteria_auth(addr, auth):
    auth = str(auth or "")
    if ":" not in auth:
        return False, ""
    user, password = auth.split(":", 1)
    user = user.strip()
    row = _account_row("hysteria", user)
    if not row or not _active_account("hysteria", user):
        return False, ""
    expected = row[2]
    if not hmac.compare_digest(str(password), str(expected)):
        return False, ""
    lim = _get_limit("hysteria", user)
    current = 0
    if lim > 0:
        online = _hyst_online_map()
        try:
            current = int(online.get(user, 0))
        except (TypeError, ValueError):
            current = 0
        if current >= lim:
            return False, user
    now = int(time.time())
    ip = _parse_source(addr)

    def mutate(state):
        h = state.setdefault("hysteria", {}).setdefault(user, {})
        if not h.get("first"):
            h["first"] = now
        h["last_auth"] = now
        if ip:
            h["last_ip"] = ip
    _locked_state(mutate)
    return True, user


def _hyst_user(user):
    online = _hyst_online_map()
    try:
        count = int(online.get(user, 0))
    except (TypeError, ValueError):
        count = 0
    lim = _get_limit("hysteria", user)

    def mutate(state):
        rec = state.setdefault("hysteria", {}).setdefault(user, {})
        if count <= 0:
            rec.pop("first", None)
            rec.pop("last_auth", None)
            return 0
        return int(rec.get("first", 0) or 0)
    first = _locked_state(mutate)
    return count, lim, first


def _ppp_up(proto, user, iface, remote):
    proto = _norm_proto(proto)
    if proto not in ("l2tp", "pptp", "sstp") or not user or not iface:
        return 0
    if not _active_account(proto, user):
        _kill_ppp_iface(iface)
        return 1
    now = int(time.time())
    lim = _get_limit(proto, user)
    exceeded = False

    def mutate(state):
        nonlocal exceeded
        users = state.setdefault("ppp", {}).setdefault(proto, {})
        rec = users.setdefault(user, {"sessions": {}})
        sessions = rec.setdefault("sessions", {})
        sessions[iface] = {"remote": remote or "", "first": now, "last": now}
        # Retire les interfaces qui n'existent plus, sans inventer de session.
        for old in list(sessions):
            if old == iface:
                continue
            if not Path(f"/sys/class/net/{old}").exists():
                sessions.pop(old, None)
        exceeded = lim > 0 and len(sessions) > lim
        if exceeded:
            sessions.pop(iface, None)
    _locked_state(mutate)
    if exceeded:
        _kill_ppp_iface(iface)
        return 1
    return 0


def _ppp_down(proto, user, iface):
    proto = _norm_proto(proto)

    def mutate(state):
        users = state.setdefault("ppp", {}).get(proto, {})
        rec = users.get(user, {})
        rec.get("sessions", {}).pop(iface, None)
        if rec and not rec.get("sessions"):
            users.pop(user, None)
    _locked_state(mutate)


def _kill_ppp_iface(iface):
    if not iface.startswith("ppp"):
        return False
    unit = iface[3:]
    for path in (Path(f"/var/run/ppp{unit}.pid"), Path(f"/run/ppp{unit}.pid")):
        try:
            pid = int(path.read_text().strip())
            os.kill(pid, signal.SIGTERM)
            return True
        except Exception:
            pass
    return False


def _ppp_user(proto, user):
    proto = _norm_proto(proto)

    def mutate(state):
        rec = state.setdefault("ppp", {}).setdefault(proto, {}).setdefault(user, {"sessions": {}})
        sessions = rec.setdefault("sessions", {})
        for iface in list(sessions):
            if not Path(f"/sys/class/net/{iface}").exists():
                sessions.pop(iface, None)
        first = min((int(v.get("first", 0)) for v in sessions.values()), default=0)
        return len(sessions), _get_limit(proto, user), first
    return _locked_state(mutate)


def _ppp_online(proto):
    proto = _norm_proto(proto)

    def mutate(state):
        total = 0
        users = state.setdefault("ppp", {}).setdefault(proto, {})
        for user in list(users):
            sessions = users[user].setdefault("sessions", {})
            for iface in list(sessions):
                if not Path(f"/sys/class/net/{iface}").exists():
                    sessions.pop(iface, None)
            if not sessions:
                users.pop(user, None)
            else:
                total += len(sessions)
        return total
    return _locked_state(mutate)


def _ppp_kick(proto, user):
    proto = _norm_proto(proto)

    def read(state):
        return list(state.get("ppp", {}).get(proto, {}).get(user, {}).get("sessions", {}).keys())
    for iface in _locked_state(lambda state: read(state)):
        _kill_ppp_iface(iface)
    _ppp_clear(proto, user)


def _ppp_clear(proto, user=None):
    proto = _norm_proto(proto)

    def mutate(state):
        users = state.setdefault("ppp", {}).setdefault(proto, {})
        if user:
            users.pop(user, None)
        else:
            users.clear()
    _locked_state(mutate)


def shutil_which(name):
    for d in os.environ.get("PATH", "").split(os.pathsep):
        p = Path(d) / name
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    return None


def _xray_ready():
    if not XCONF.exists():
        return False
    try:
        conf = json.loads(XCONF.read_text())
        services = (conf.get("api") or {}).get("services") or []
        rules = (conf.get("routing") or {}).get("rules") or []
        configured = (
            "RoutingService" in services
            and any(r.get("ruleTag") == "nvguard-track" for r in rules)
        )
        if not configured:
            return False
        req = urllib.request.Request(f"http://{GUARD_HOST}:{GUARD_PORT}/health")
        with urllib.request.urlopen(req, timeout=1) as resp:
            return resp.status == 200
    except Exception:
        return False


def _xray_ensure():
    if not XCONF.exists():
        return False
    try:
        conf = json.loads(XCONF.read_text())
    except Exception:
        return False

    before_clients = {}
    for inbound in conf.get("inbounds", []):
        tag = inbound.get("tag")
        if tag:
            before_clients[tag] = json.dumps((inbound.get("settings") or {}).get("clients", []), sort_keys=True)

    conf.setdefault("stats", {})
    api = conf.setdefault("api", {})
    api["tag"] = "api"
    services = list(api.get("services") or [])
    for service in ("StatsService", "RoutingService"):
        if service not in services:
            services.append(service)
    api["services"] = services

    inbounds = conf.setdefault("inbounds", [])
    if not any(i.get("tag") == "api" for i in inbounds):
        inbounds.insert(0, {
            "tag": "api", "port": 10085, "listen": "127.0.0.1",
            "protocol": "dokodemo-door", "settings": {"address": "127.0.0.1"}
        })
    trusted_xff_tags = []
    for inbound in inbounds:
        tag = inbound.get("tag")
        if tag in ("vmess-in", "vless-in", "trojan-in"):
            inbound["listen"] = "127.0.0.1"
            stream = inbound.setdefault("streamSettings", {})
            sockopt = stream.setdefault("sockopt", {})
            # Les versions récentes de Xray utilisent cette option pour
            # autoriser explicitement l'en-tête X-Real-IP fourni par nginx.
            # Les anciennes versions ne connaissent pas la clé : on la teste
            # ci-dessous puis on la retire automatiquement si nécessaire.
            sockopt["trustedXForwardedFor"] = ["X-Real-IP"]
            trusted_xff_tags.append(tag)

    outbounds = conf.setdefault("outbounds", [])
    direct = next((o for o in outbounds if o.get("tag") == "direct"), None)
    if direct is None:
        untagged = next((o for o in outbounds if o.get("protocol") == "freedom" and not o.get("tag")), None)
        if untagged is not None:
            untagged["tag"] = "direct"
        else:
            outbounds.insert(0, {"protocol": "freedom", "tag": "direct"})
    if not any(o.get("tag") == "api" for o in outbounds):
        outbounds.append({"protocol": "freedom", "tag": "api"})
    if not any(o.get("tag") == "blocked" for o in outbounds):
        outbounds.append({"protocol": "blackhole", "tag": "blocked"})

    routing = conf.setdefault("routing", {})
    rules = list(routing.get("rules") or [])
    rules = [r for r in rules if not str(r.get("ruleTag", "")).startswith("nvguard-")]
    if not any("api" in (r.get("inboundTag") or []) and r.get("outboundTag") == "api" for r in rules):
        rules.insert(0, {"type": "field", "inboundTag": ["api"], "outboundTag": "api", "ruleTag": "nvpanel-api"})
    rules.append({
        "type": "field",
        "inboundTag": ["vmess-in", "vless-in", "trojan-in", "ss-in"],
        "network": "tcp,udp",
        "outboundTag": "direct",
        "ruleTag": "nvguard-track",
        "webhook": {
            "url": f"http://{GUARD_HOST}:{GUARD_PORT}/xray",
            "deduplication": 1,
            "headers": {"X-NVGuard": "1"},
        },
    })
    routing["rules"] = rules

    after_clients = {}
    for inbound in conf.get("inbounds", []):
        tag = inbound.get("tag")
        if tag in before_clients:
            after_clients[tag] = json.dumps((inbound.get("settings") or {}).get("clients", []), sort_keys=True)
    if before_clients != after_clients:
        return False

    backup = Path("/etc/nvpanel/xray/config.before-guard.json")
    backup.parent.mkdir(parents=True, exist_ok=True)
    if not backup.exists():
        try:
            backup.write_text(XCONF.read_text())
            os.chmod(backup, 0o600)
        except OSError:
            pass

    tmp = XCONF.with_suffix(".guard.tmp")

    def validate(candidate):
        tmp.write_text(json.dumps(candidate, indent=2) + "\n")
        try:
            cp = subprocess.run(
                ["xray", "run", "-test", "-config", str(tmp)],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8,
            )
            return cp.returncode == 0
        except Exception:
            return False

    if not validate(conf):
        # Compatibilité avec les versions Xray antérieures à l'option
        # trustedXForwardedFor : on retire UNIQUEMENT cette clé et on reteste.
        for inbound in conf.get("inbounds", []):
            if inbound.get("tag") not in trusted_xff_tags:
                continue
            stream = inbound.get("streamSettings") or {}
            sockopt = stream.get("sockopt") or {}
            sockopt.pop("trustedXForwardedFor", None)
            if not sockopt:
                stream.pop("sockopt", None)
        if not validate(conf):
            tmp.unlink(missing_ok=True)
            return False

    os.replace(tmp, XCONF)
    try:
        subprocess.run(["systemctl", "restart", "xray"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    except Exception:
        return False
    time.sleep(0.5)
    _apply_xray_rules(force=True)
    return True


def _install():
    _ensure_dirs()
    try:
        os.chmod(LIMIT_DB, 0o600)
    except OSError:
        pass
    # Hooks PPP : les scripts Debian reçoivent les 6 arguments d'ip-up/down.
    up = Path("/etc/ppp/ip-up.d/99-nvpanel-guard")
    down = Path("/etc/ppp/ip-down.d/99-nvpanel-guard")
    up.parent.mkdir(parents=True, exist_ok=True)
    down.parent.mkdir(parents=True, exist_ok=True)
    up.write_text("""#!/bin/sh\n[ -x /usr/local/bin/nvpanel-guard ] || exit 0\n/usr/local/bin/nvpanel-guard ppp-up \"${6:-${IPPARAM:-}}\" \"${PEERNAME:-}\" \"${1:-${IFNAME:-}}\" \"${5:-${IPREMOTE:-}}\" >/dev/null 2>&1\nexit 0\n""")
    down.write_text("""#!/bin/sh\n[ -x /usr/local/bin/nvpanel-guard ] || exit 0\n/usr/local/bin/nvpanel-guard ppp-down \"${6:-${IPPARAM:-}}\" \"${PEERNAME:-}\" \"${1:-${IFNAME:-}}\" >/dev/null 2>&1\nexit 0\n""")
    os.chmod(up, 0o755); os.chmod(down, 0o755)
    # Migration des fichiers PPP déjà présents. Les installateurs sources
    # écrivent aussi ipparam afin que les futures installations soient prêtes.
    for path, proto in ((Path("/etc/ppp/options.xl2tpd"), "l2tp"), (Path("/etc/ppp/pptpd-options"), "pptp"), (Path("/etc/ppp/options.sstpd"), "sstp")):
        try:
            text = path.read_text()
        except OSError:
            continue
        lines = [ln for ln in text.splitlines() if not ln.strip().startswith("ipparam ")]
        lines.append(f"ipparam {proto}")
        path.write_text("\n".join(lines) + "\n")

    unit = Path("/etc/systemd/system/nvpanel-guard.service")
    unit.write_text("""[Unit]\nDescription=RHAFF SERVICE Multi-Protocol Guard\nAfter=network.target\n\n[Service]\nType=simple\nExecStart=/usr/local/bin/nvpanel-guard serve\nRestart=always\nRestartSec=2\n\n[Install]\nWantedBy=multi-user.target\n""")
    subprocess.run(["systemctl", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "enable", "--now", "nvpanel-guard"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if XCONF.exists():
        _xray_ensure()
    return 0


class Handler(BaseHTTPRequestHandler):
    server_version = "RHAFFGuard/1"

    def log_message(self, fmt, *args):
        return

    def _json(self, code, data):
        raw = json.dumps(data, separators=(",", ":")).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        if self.path == "/health":
            self._json(200, {"ok": True})
        else:
            self._json(404, {"ok": False})

    def do_POST(self):
        try:
            length = min(int(self.headers.get("Content-Length", "0") or 0), 65536)
            payload = json.loads(self.rfile.read(length) or b"{}")
        except Exception:
            self._json(400, {"ok": False})
            return
        if self.path == "/xray":
            if self.headers.get("X-NVGuard") != "1":
                self._json(403, {"ok": False})
                return
            _record_xray_event(payload)
            self._json(200, {"ok": True})
            return
        if self.path == "/hysteria/auth":
            ok, user = _verify_hysteria_auth(payload.get("addr"), payload.get("auth"))
            self._json(200, {"ok": bool(ok), "id": user if ok else ""})
            return
        self._json(404, {"ok": False})


def _maintenance():
    while True:
        time.sleep(10)
        try:
            _apply_xray_rules()
        except Exception:
            pass
        # Si un compte Hysteria est verrouillé/expiré alors qu'une session
        # existe encore, on la coupe; l'auth backend empêchera la reconnexion.
        try:
            for user, count in _hyst_online_map().items():
                if int(count or 0) > 0 and not _active_account("hysteria", user):
                    _hyst_kick(user)
        except Exception:
            pass


def _serve():
    _ensure_dirs()
    th = threading.Thread(target=_maintenance, daemon=True)
    th.start()
    srv = ThreadingHTTPServer((GUARD_HOST, GUARD_PORT), Handler)
    srv.serve_forever()


def main(argv):
    if len(argv) < 2:
        print("usage: nvpanel-guard serve|install|xray-ensure|xray-ready|limit-get|limit-set|limit-del|xray-user|xray-online|xray-clear|ppp-up|ppp-down|ppp-user|ppp-online|ppp-kick|ppp-clear|hysteria-user|hysteria-online|hysteria-kick")
        return 1
    cmd = argv[1]
    if cmd == "serve":
        _serve(); return 0
    if cmd == "install":
        return _install()
    if cmd == "xray-ensure":
        return 0 if _xray_ensure() else 1
    if cmd == "xray-ready":
        return 0 if _xray_ready() else 1
    if cmd == "limit-get" and len(argv) >= 4:
        print(_get_limit(argv[2], argv[3])); return 0
    if cmd == "limit-set" and len(argv) >= 5:
        _set_limit(argv[2], argv[3], argv[4])
        if _norm_proto(argv[2]) in PROTO_TO_INBOUND:
            _apply_xray_rules(force=True)
        return 0
    if cmd == "limit-del" and len(argv) >= 4:
        proto = _norm_proto(argv[2])
        _del_limit(proto, argv[3])
        if proto in PROTO_TO_INBOUND:
            _apply_xray_rules(force=True)
        return 0
    if cmd == "xray-user" and len(argv) >= 4:
        n, first = _xray_user(argv[2], argv[3]); print(f"{n}|{first}"); return 0
    if cmd == "xray-online" and len(argv) >= 3:
        print(_xray_count_accounts(argv[2])); return 0
    if cmd == "xray-clear":
        _clear_xray(argv[2] if len(argv) >= 3 else None, argv[3] if len(argv) >= 4 else None); return 0
    if cmd == "ppp-up" and len(argv) >= 6:
        return _ppp_up(argv[2], argv[3], argv[4], argv[5])
    if cmd == "ppp-down" and len(argv) >= 5:
        _ppp_down(argv[2], argv[3], argv[4]); return 0
    if cmd == "ppp-user" and len(argv) >= 4:
        n, lim, first = _ppp_user(argv[2], argv[3]); print(f"{n}|{lim}|{first}"); return 0
    if cmd == "ppp-online" and len(argv) >= 3:
        print(_ppp_online(argv[2])); return 0
    if cmd == "ppp-kick" and len(argv) >= 4:
        _ppp_kick(argv[2], argv[3]); return 0
    if cmd == "ppp-clear" and len(argv) >= 3:
        _ppp_clear(argv[2], argv[3] if len(argv) >= 4 else None); return 0
    if cmd == "hysteria-user" and len(argv) >= 3:
        n, lim, first = _hyst_user(argv[2]); print(f"{n}|{lim}|{first}"); return 0
    if cmd == "hysteria-online":
        total = 0
        for v in _hyst_online_map().values():
            try: total += int(v)
            except (TypeError, ValueError): pass
        print(total); return 0
    if cmd == "hysteria-kick" and len(argv) >= 3:
        return 0 if _hyst_kick(argv[2]) else 1
    print("ERR args", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
