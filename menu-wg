#!/bin/bash
# ============================================================
#  RHAFF SERVICE · WireGuard   (commande : menu-wg)
# ============================================================
source /etc/nvpanel/lib/ui.sh
ui_enter; trap ui_leave EXIT INT TERM HUP
[ "$EUID" -ne 0 ] && { err "Lance en root."; exit 1; }

WGCONF=/etc/wireguard/wg0.conf
DB=/etc/nvpanel/db/wireguard
NDIR=/etc/nvpanel/wg
SRV_IP=$(cat /etc/nvpanel/ip 2>/dev/null)
NET="10.66.66"
PORT=51820
umask 077
mkdir -p /etc/nvpanel/db "$NDIR"
chmod 700 /etc/nvpanel/db "$NDIR" 2>/dev/null
touch "$DB"; chmod 600 "$DB" 2>/dev/null

valid_peer_name(){ [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]; }
valid_days(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 3650 ]; }
with_wg_lock(){
  (
    exec 8>/run/nvpanel-wg.lock
    flock -w 30 8 || { err "WireGuard est déjà en cours de modification."; pause; return 1; }
    "$@"
  )
}

wg_remove_conf_peer(){ # nom exact, sans interprétation regex
  local tmp
  tmp=$(mktemp /etc/wireguard/.wg0.conf.XXXXXX) || return 1
  awk -v n="$1" '
    function flush(){ if (buf!="" && !drop) printf "%s",buf; buf=""; drop=0 }
    /^\[Peer\]$/ { flush(); peer=1; buf=$0 ORS; next }
    { if (peer) { buf=buf $0 ORS; if ($0=="# " n) drop=1 } else print }
    END { flush() }
  ' "$WGCONF" > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null
  mv "$tmp" "$WGCONF"
}

wg_add_conf_peer(){ # nom clé_publique IP
  awk -v n="$1" '$0=="# " n{f=1} END{exit f?0:1}' "$WGCONF" 2>/dev/null && return 0
  printf '\n[Peer]\n# %s\nPublicKey = %s\nAllowedIPs = %s/32\n' "$1" "$2" "$3" >> "$WGCONF"
  chmod 600 "$WGCONF" 2>/dev/null
}

wg_db_delete(){
  local tmp
  tmp=$(mktemp "${DB}.XXXXXX") || return 1
  awk -v n="$1" '!($1=="###" && $2==n)' "$DB" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$DB"
}

header(){ banner; _edge "┏" "┓" "GESTION WIREGUARD"; proto_dash wireguard wg wg; bot; }

install_wg() {
  header; printf "${CYN}➜${NC} Installation de WireGuard…\n"
  export DEBIAN_FRONTEND=noninteractive
  apt-get install -y wireguard wireguard-tools qrencode iptables >/dev/null 2>&1 \
    || { err "Installation des paquets WireGuard échouée."; pause; return 1; }
  command -v wg >/dev/null 2>&1 || { err "Commande wg introuvable après installation."; pause; return 1; }
  mkdir -p /etc/wireguard
  local spriv spub ifc
  ifc=$(ip route | awk '/default/{print $5; exit}')
  [ -n "$ifc" ] || { err "Interface réseau par défaut introuvable."; pause; return 1; }
  if [ ! -s "$WGCONF" ]; then
    spriv=$(wg genkey) || { err "Génération de clé WireGuard échouée."; pause; return 1; }
    spub=$(printf '%s' "$spriv" | wg pubkey) || { err "Clé publique WireGuard invalide."; pause; return 1; }
    echo "$spub" > "$NDIR/server.pub"
    cat > "$WGCONF" <<EOF
[Interface]
Address = $NET.1/24
ListenPort = $PORT
PrivateKey = $spriv
PostUp = iptables -C INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null || iptables -I INPUT -p udp --dport $PORT -j ACCEPT; iptables -C FORWARD -i wg0 -j ACCEPT 2>/dev/null || iptables -A FORWARD -i wg0 -j ACCEPT; iptables -C FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -A FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -C POSTROUTING -s $NET.0/24 -o $ifc -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s $NET.0/24 -o $ifc -j MASQUERADE
PostDown = iptables -D INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null; iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -s $NET.0/24 -o $ifc -j MASQUERADE
EOF
  else
    # Une réinstallation conserve la clé serveur et tous les peers existants.
    awk -F' *= *' '$1=="Address" && $2=="10.66.66.1/24"{f=1} END{exit !f}' "$WGCONF" \
      || { err "$WGCONF existe mais n'appartient pas à RHAFF SERVICE."; pause; return 1; }
    spriv=$(awk -F' *= *' '$1=="PrivateKey"{print $2; exit}' "$WGCONF")
    [ -n "$spriv" ] || { err "Clé privée absente de $WGCONF."; pause; return 1; }
    spub=$(printf '%s' "$spriv" | wg pubkey 2>/dev/null) || { err "Clé serveur WireGuard invalide."; pause; return 1; }
    echo "$spub" > "$NDIR/server.pub"
    if grep -q '^PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o [^ ]* -j MASQUERADE$' "$WGCONF"; then
      iptables -t nat -D POSTROUTING -o "$ifc" -j MASQUERADE 2>/dev/null
    fi
    sed -i "s|^PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o [^ ]* -j MASQUERADE$|PostUp = iptables -C INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null \\|\\| iptables -I INPUT -p udp --dport $PORT -j ACCEPT; iptables -C FORWARD -i wg0 -j ACCEPT 2>/dev/null \\|\\| iptables -A FORWARD -i wg0 -j ACCEPT; iptables -C FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \\|\\| iptables -A FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -C POSTROUTING -s $NET.0/24 -o $ifc -j MASQUERADE 2>/dev/null \\|\\| iptables -t nat -A POSTROUTING -s $NET.0/24 -o $ifc -j MASQUERADE|" "$WGCONF"
    sed -i "s|^PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o [^ ]* -j MASQUERADE$|PostDown = iptables -D INPUT -p udp --dport $PORT -j ACCEPT 2>/dev/null; iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -s $NET.0/24 -o $ifc -j MASQUERADE|" "$WGCONF"
  fi
  chmod 600 "$WGCONF" "$NDIR/server.pub" 2>/dev/null
  sed -i 's/^#\?net.ipv4.ip_forward.*/net.ipv4.ip_forward=1/' /etc/sysctl.conf
  grep -q '^net.ipv4.ip_forward=1' /etc/sysctl.conf || echo 'net.ipv4.ip_forward=1' >> /etc/sysctl.conf
  sysctl -p >/dev/null 2>&1
  [ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" = 1 ] \
    || { err "Le noyau de ce VPS refuse le routage IPv4 requis par WireGuard."; pause; return 1; }
  systemctl enable wg-quick@wg0 >/dev/null 2>&1
  systemctl restart wg-quick@wg0 >/dev/null 2>&1 \
    && systemctl is-active --quiet wg-quick@wg0 \
    || { err "WireGuard n'a pas pu démarrer. Consulte : journalctl -u wg-quick@wg0"; pause; return 1; }
  local fw_ok=1
  iptables -C INPUT -p udp --dport "$PORT" -j ACCEPT 2>/dev/null \
    || iptables -I INPUT -p udp --dport "$PORT" -j ACCEPT 2>/dev/null || fw_ok=0
  iptables -C FORWARD -i wg0 -j ACCEPT 2>/dev/null || fw_ok=0
  iptables -C FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || fw_ok=0
  iptables -t nat -C POSTROUTING -s $NET.0/24 -o "$ifc" -j MASQUERADE 2>/dev/null || fw_ok=0
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
    ufw allow "$PORT/udp" >/dev/null 2>&1 || fw_ok=0
  fi
  [ "$fw_ok" -eq 1 ] \
    || { err "Le pare-feu de ce VPS n'a pas appliqué toutes les règles WireGuard."; pause; return 1; }
  ok "WireGuard installé (port $PORT/udp)."; sleep 1
}

ensure_wg() {
  if ! command -v wg >/dev/null 2>&1 || [ ! -f "$WGCONF" ]; then
    ask " WireGuard n'est pas installé. L'installer ? (o/n) : " r
    confirm "$r" && install_wg || return 1
  elif ! systemctl is-active --quiet wg-quick@wg0 2>/dev/null; then
    systemctl restart wg-quick@wg0 >/dev/null 2>&1 || { err "WireGuard est installé mais ne démarre pas (journalctl -u wg-quick@wg0)."; pause; return 1; }
  fi
  if [ ! -s "$NDIR/server.pub" ]; then
    _spriv=$(awk -F' *= *' '$1=="PrivateKey"{print $2; exit}' "$WGCONF")
    [ -n "$_spriv" ] && printf '%s' "$_spriv" | wg pubkey > "$NDIR/server.pub" 2>/dev/null
  fi
  [ -s "$NDIR/server.pub" ] || { err "Clé publique serveur WireGuard introuvable."; pause; return 1; }
}

next_ip() {
  local n
  for n in $(seq 2 254); do
    if ! awk -v ip="$NET.$n" '$1=="###" && $4==ip{f=1} END{exit f?0:1}' "$DB" 2>/dev/null \
       && ! awk -F' *= *' -v ip="$NET.$n/32" '$1=="AllowedIPs" && $2==ip{f=1} END{exit f?0:1}' "$WGCONF" 2>/dev/null; then
      echo "$n"; return 0
    fi
  done
  return 1
}

add_peer() {
  if [ -n "$1" ]; then
    name="$1"; days="${2:-1}"
  else
  header; ask " Nom du client : " name
  [ -z "$name" ] && { err "Nom vide"; pause; return; }
  valid_peer_name "$name" || { err "Nom invalide (lettres, chiffres, _ et - uniquement)."; pause; return; }
  grep -q "^### $name " "$DB" && { err "Existe déjà"; pause; return; }
  ask " Durée (jours) : " days; valid_days "$days" || { err "Durée invalide (1 à 3650 jours)."; pause; return; }
  fi
  valid_peer_name "$name" || { err "Nom de client invalide."; pause; return; }
  valid_days "$days" || { err "Durée invalide."; pause; return; }
  grep -q "^### $name " "$DB" && { err "Existe déjà"; pause; return; }
  awk -v n="$name" '$0=="# " n{f=1} END{exit !f}' "$WGCONF" 2>/dev/null \
    && { err "Ce client existe déjà dans wg0.conf."; pause; return; }
  local ppriv ppub ip exp spub
  ppriv=$(wg genkey 2>/dev/null) || { err "Génération de la clé client échouée."; pause; return; }
  ppub=$(printf '%s' "$ppriv" | wg pubkey 2>/dev/null) || { err "Génération de la clé publique client échouée."; pause; return; }
  [ -n "$ppriv" ] && [ -n "$ppub" ] || { err "Clés WireGuard client invalides."; pause; return; }
  _octet=$(next_ip) || { err "Le réseau WireGuard est complet (253 clients maximum)."; pause; return; }
  ip="$NET.$_octet"; exp=$(date -d "+$days days" +"%Y-%m-%d")
  spub=$(cat "$NDIR/server.pub")

  if ! cat >> "$WGCONF" <<EOF

[Peer]
# $name
PublicKey = $ppub
AllowedIPs = $ip/32
EOF
  then
    err "Enregistrement du peer dans wg0.conf échoué."; pause; return
  fi
  chmod 600 "$WGCONF" 2>/dev/null
  wg set wg0 peer "$ppub" allowed-ips "$ip/32" 2>/dev/null || {
    wg_remove_conf_peer "$name" >/dev/null 2>&1
    err "Ajout du peer dans WireGuard échoué."; pause; return
  }

  local conf="$NDIR/$name.conf"
  local _bn; _bn=$(head -1 /etc/banner 2>/dev/null | tr -d '\r\n')
  if ! cat > "$conf" <<EOF
# ${_bn:-RHAFF SERVICE} - $name
[Interface]
PrivateKey = $ppriv
Address = $ip/32
DNS = 1.1.1.1

[Peer]
PublicKey = $spub
Endpoint = $SRV_IP:$PORT
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
EOF
  then
    wg set wg0 peer "$ppub" remove >/dev/null 2>&1; wg_remove_conf_peer "$name" >/dev/null 2>&1
    err "Création du fichier client échouée."; pause; return
  fi
  chmod 600 "$conf" 2>/dev/null
  if ! printf '### %s %s %s %s\n' "$name" "$ppub" "$ip" "$exp" >> "$DB"; then
    wg set wg0 peer "$ppub" remove >/dev/null 2>&1; wg_remove_conf_peer "$name" >/dev/null 2>&1; rm -f "$conf"
    err "Enregistrement du client échoué."; pause; return
  fi

  clear; header; ok "Client WireGuard créé (expire $(_fmtd "$exp"))"
  echo
  printf "${GRY}--- Config client (copie-la dans un fichier .conf) ---${NC}\n"
  cat "$conf"
  echo
  pause
}

list_peers() {
  local page=0 size=4 total pages start end i nm pub ip exp fl ct st color choice today
  mapfile -t _rows_wg < <(awk '/^### /{print $2"|"$3"|"$4"|"$5"|"$6}' "$DB" 2>/dev/null)
  total=${#_rows_wg[@]}; [ "$total" -eq 0 ] && { header; warn "Aucun client WireGuard."; pause; return; }
  pages=$(( (total + size - 1) / size )); today=$(date +%F)
  while true; do
    header
    table_top
    printf "${CYN}┃${NC} ${WHT}%-12s %-12s %-11s %-7s %s${NC}" "COMPTE" "IP" "EXPIRE" "ÉTAT" "CONNECTÉ DEPUIS"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    table_sep
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r nm pub ip exp fl <<< "${_rows_wg[$i]}"; ct=$(_wg_time "$pub")
      if [ "$fl" = "L" ]; then st="verrou"; color="$YLW"; ct="—"
      elif [ -n "$exp" ] && { [ "$exp" \< "$today" ] || [ "$exp" = "$today" ]; }; then st="expiré"; color="$RED"; ct="—"
      else st="actif"; color="$GRN"; fi
      if [ -n "$ct" ] && [ "$ct" != "—" ]; then
        ct=${ct// /}
        printf "${CYN}┃${NC} %-12.12s %-12.12s %-11s ${color}%-7s${NC} %s ${CYN}· 1/1 IP${NC}" "$nm" "${ip:-?}" "$(_fmtd "${exp:-?}")" "$st" "$ct"
      else
        printf "${CYN}┃${NC} %-12.12s %-12.12s %-11s ${color}%-7s${NC} %s ${CYN}· 0/1 IP${NC}" "$nm" "${ip:-?}" "$(_fmtd "${exp:-?}")" "$st" "${ct:-—}"
      fi
      printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
      [ "$i" -lt $((end-1)) ] && table_sep
    done
    table_bot
    if [ "$pages" -le 1 ]; then pause; return; fi
    ask "   ➤ n suivante | p précédente | 0 retour : " choice
    case "${choice,,}" in n) [ "$page" -lt $((pages-1)) ] && page=$((page+1)) ;; p) [ "$page" -gt 0 ] && page=$((page-1)) ;; 0|'') return ;; *) warn "Invalide"; sleep 1 ;; esac
  done
}


_rand_name(){ printf 'test%s' "$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c4)"; }
_rand_pass(){ tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c8; }

trial_peer() {
  banner; top; center " 🎁  COMPTE TEST 24 H " "${BOLD}${WHT}"; bot
  printf "   ${GRY}Génération d'un client WireGuard valable 24 heures…${NC}\n"
  add_peer "$(_rand_name)" 1
}

pick_peer() {
  PICK=""
  mapfile -t _pl < <(awk '/^### /{print $2"|"$4"|"$5"|"$6}' "$DB" 2>/dev/null)
  if [ "${#_pl[@]}" -eq 0 ]; then err "Aucun client WireGuard."; pause; return 1; fi
  local page=0 size=6 total=${#_pl[@]} pages start end i nm ip ex fl n today st color
  pages=$(( (total + size - 1) / size )); today=$(date +%F)
  while true; do
    header; printf "   ${GRY}Clients WireGuard · page %d/%d :${NC}\n" "$((page+1))" "$pages"
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r nm ip ex fl <<< "${_pl[$i]}"
      if [ "$fl" = "L" ]; then st="verrou"; color="$YLW"
      elif [ -n "$ex" ] && { [ "$ex" \< "$today" ] || [ "$ex" = "$today" ]; }; then st="expiré"; color="$RED"
      else st="actif"; color="$GRN"; fi
      printf "   ${WHT}%2d${NC}) %-16s ${GRY}%-14s exp %s${NC}  ${color}%s${NC}\n" "$((i+1))" "$nm" "$ip" "$(_fmtd "$ex")" "$st"
    done
    echo; if [ "$pages" -gt 1 ]; then ask "   ➤ N° | n suivante | p précédente | 0 retour : " n; else ask "   ➤ Numéro (0 = annuler) : " n; fi
    case "${n,,}" in n) [ "$pages" -gt 1 ] && [ "$page" -lt $((pages-1)) ] && page=$((page+1)); continue ;; p) [ "$pages" -gt 1 ] && [ "$page" -gt 0 ] && page=$((page-1)); continue ;; esac
    [[ "$n" =~ ^[0-9]+$ ]] || { err "Invalide"; sleep 1; continue; }; [ "$n" -eq 0 ] && return 1
    [ "$n" -ge 1 ] && [ "$n" -le "$total" ] || { err "Hors liste"; sleep 1; continue; }
    PICK="${_pl[$((n-1))]%%|*}"; return 0
  done
}

del_peer() {
  header; pick_peer || return; name="$PICK"
  printf "   ${YLW}Supprimer '%s' ? (o/n) : ${NC}" "$name"; ask "" c; confirm "$c" || { pause; return; }
  local pub ip had_conf=0 had_runtime=0
  pub=$(awk -v n="$name" '$2==n{print $3}' "$DB")
  ip=$(awk -v n="$name" '$2==n{print $4}' "$DB")
  awk -v n="$name" '$0=="# " n{f=1} END{exit !f}' "$WGCONF" 2>/dev/null && had_conf=1
  wg show wg0 peers 2>/dev/null | grep -Fxq "$pub" && had_runtime=1
  if [ "$had_runtime" = 1 ] && ! wg set wg0 peer "$pub" remove 2>/dev/null; then
    err "Retrait du peer actif échoué."; pause; return
  fi
  wg_remove_conf_peer "$name" || {
    [ "$had_runtime" = 1 ] && wg set wg0 peer "$pub" allowed-ips "$ip/32" >/dev/null 2>&1 || true
    err "Mise à jour de wg0.conf échouée."; pause; return
  }
  wg_db_delete "$name" || {
    [ "$had_conf" = 1 ] && wg_add_conf_peer "$name" "$pub" "$ip" >/dev/null 2>&1 || true
    [ "$had_runtime" = 1 ] && wg set wg0 peer "$pub" allowed-ips "$ip/32" >/dev/null 2>&1 || true
    err "Mise à jour de la base WireGuard échouée."; pause; return
  }
  rm -f "$NDIR/$name.conf"
  ok "$name supprimé"; pause
}

wg_lock_peer() {
  local name="$1" row pub ip fl tmp had_conf=0 had_runtime=0
  row=$(awk -v n="$name" '$1=="###"&&$2==n{print; exit}' "$DB")
  [ -n "$row" ] || { err "Client introuvable."; return 1; }
  pub=$(printf '%s\n' "$row" | awk '{print $3}')
  ip=$(printf '%s\n' "$row" | awk '{print $4}')
  fl=$(printf '%s\n' "$row" | awk '{print $6}')
  [ "$fl" != "L" ] || { err "$name est déjà verrouillé."; return 1; }
  awk -v n="$name" '$0=="# " n{f=1} END{exit !f}' "$WGCONF" 2>/dev/null && had_conf=1
  wg show wg0 peers 2>/dev/null | grep -Fxq "$pub" && had_runtime=1
  if [ "$had_runtime" = 1 ] && ! wg set wg0 peer "$pub" remove 2>/dev/null; then
    err "Verrouillage du peer actif échoué."; return 1
  fi
  if [ "$had_conf" = 1 ] && ! wg_remove_conf_peer "$name"; then
    [ "$had_runtime" = 1 ] && wg set wg0 peer "$pub" allowed-ips "$ip/32" >/dev/null 2>&1 || true
    err "Mise à jour de wg0.conf échouée."; return 1
  fi
  tmp=$(mktemp "${DB}.XXXXXX") || {
    [ "$had_conf" = 1 ] && wg_add_conf_peer "$name" "$pub" "$ip" >/dev/null 2>&1 || true
    [ "$had_runtime" = 1 ] && wg set wg0 peer "$pub" allowed-ips "$ip/32" >/dev/null 2>&1 || true
    err "Mise à jour de la base échouée."; return 1
  }
  awk -v n="$name" '{if($1=="###"&&$2==n){print $1,$2,$3,$4,$5,"L"}else print}' "$DB" > "$tmp" \
    && chmod 600 "$tmp" && mv "$tmp" "$DB" \
    || {
      rm -f "$tmp"
      [ "$had_conf" = 1 ] && wg_add_conf_peer "$name" "$pub" "$ip" >/dev/null 2>&1 || true
      [ "$had_runtime" = 1 ] && wg set wg0 peer "$pub" allowed-ips "$ip/32" >/dev/null 2>&1 || true
      err "Mise à jour de la base échouée."; return 1
    }
  return 0
}

wg_unlock_peer() {
  local name="$1" row pub ip exp fl tmp had_conf=0 had_runtime=0 today
  today=$(date +%F)
  row=$(awk -v n="$name" '$1=="###"&&$2==n{print; exit}' "$DB")
  [ -n "$row" ] || { err "Client introuvable."; return 1; }
  pub=$(printf '%s\n' "$row" | awk '{print $3}')
  ip=$(printf '%s\n' "$row" | awk '{print $4}')
  exp=$(printf '%s\n' "$row" | awk '{print $5}')
  fl=$(printf '%s\n' "$row" | awk '{print $6}')
  [ "$fl" = "L" ] || { err "$name n'est pas verrouillé."; return 1; }
  { [ -z "$exp" ] || [ "$exp" \> "$today" ]; } || { err "$name est expiré : prolonge-le avant réactivation."; return 1; }
  awk -v n="$name" '$0=="# " n{f=1} END{exit !f}' "$WGCONF" 2>/dev/null && had_conf=1
  wg show wg0 peers 2>/dev/null | grep -Fxq "$pub" && had_runtime=1
  wg_add_conf_peer "$name" "$pub" "$ip" || { err "Mise à jour de wg0.conf échouée."; return 1; }
  wg set wg0 peer "$pub" allowed-ips "$ip/32" 2>/dev/null || {
    [ "$had_conf" = 0 ] && wg_remove_conf_peer "$name" >/dev/null 2>&1
    err "Réactivation du peer échouée."; return 1
  }
  tmp=$(mktemp "${DB}.XXXXXX") || {
    [ "$had_runtime" = 0 ] && wg set wg0 peer "$pub" remove >/dev/null 2>&1
    [ "$had_conf" = 0 ] && wg_remove_conf_peer "$name" >/dev/null 2>&1
    err "Mise à jour de la base échouée."; return 1
  }
  awk -v n="$name" '{if($1=="###"&&$2==n){print $1,$2,$3,$4,$5}else print}' "$DB" > "$tmp" \
    && chmod 600 "$tmp" && mv "$tmp" "$DB" \
    || {
      rm -f "$tmp"
      [ "$had_runtime" = 0 ] && wg set wg0 peer "$pub" remove >/dev/null 2>&1
      [ "$had_conf" = 0 ] && wg_remove_conf_peer "$name" >/dev/null 2>&1
      err "Mise à jour de la base échouée."; return 1
    }
  return 0
}

blocked_peers() {
  local name fl
  header; pick_peer || return; name="$PICK"
  fl=$(awk -v n="$name" '$1=="###"&&$2==n{print $6; exit}' "$DB" 2>/dev/null)
  if [ "$fl" = "L" ]; then
    if wg_unlock_peer "$name"; then ok "$name déverrouillé"; fi
  else
    if wg_lock_peer "$name"; then ok "$name verrouillé"; fi
  fi
  pause
}

renew_peer() {
  header; pick_peer || return; name="$PICK"
  ask " Ajouter (jours) : " days
  valid_days "$days" || { err "Durée invalide (1 à 3650 jours)."; pause; return; }
  local exp row pub ip fl tmp had_conf=0 had_runtime=0
  row=$(awk -v n="$name" '$1=="###"&&$2==n{print; exit}' "$DB")
  pub=$(printf '%s\n' "$row" | awk '{print $3}'); ip=$(printf '%s\n' "$row" | awk '{print $4}'); fl=$(printf '%s\n' "$row" | awk '{print $6}')
  exp=$(date -d "+$days days" +"%Y-%m-%d")
  awk -v n="$name" '$0=="# " n{f=1} END{exit !f}' "$WGCONF" 2>/dev/null && had_conf=1
  wg show wg0 peers 2>/dev/null | grep -Fxq "$pub" && had_runtime=1
  wg_add_conf_peer "$name" "$pub" "$ip" || { err "Mise à jour de wg0.conf échouée."; pause; return; }
  wg set wg0 peer "$pub" allowed-ips "$ip/32" 2>/dev/null || {
    [ "$had_conf" = 0 ] && wg_remove_conf_peer "$name" >/dev/null 2>&1
    err "Réactivation du peer échouée."; pause; return
  }
  tmp=$(mktemp "${DB}.XXXXXX") || { err "Mise à jour de la base échouée."; pause; return; }
  awk -v n="$name" -v e="$exp" '{if($1=="###"&&$2==n){print $1,$2,$3,$4,e}else print}' "$DB" > "$tmp" \
    && chmod 600 "$tmp" && mv "$tmp" "$DB" \
    || {
      rm -f "$tmp"
      [ "$had_runtime" = 0 ] && wg set wg0 peer "$pub" remove >/dev/null 2>&1
      [ "$had_conf" = 0 ] && wg_remove_conf_peer "$name" >/dev/null 2>&1
      err "Mise à jour de la base échouée."; pause; return
    }
  ok "$name prolongé jusqu'au $(_fmtd "$exp")"; pause
}

uninstall_wg(){
  banner; center " 🗑️  DÉSINSTALLER WIREGUARD " "${BOLD}${RED}"; line
  warn "Cela supprime WireGuard et TOUS ses clients."
  printf "   ${GRY}Les autres protocoles ne sont pas touchés.${NC}\n\n"
  printf "   ${RED}➤ Confirmer la désinstallation ? (o/n) : ${NC}"; ask "" r
  confirm "$r" || { warn "Annulé."; pause; return; }

  printf "\n${CYN}➜${NC} Arrêt du service…\n"
  systemctl disable --now wg-quick@wg0 >/dev/null 2>&1
  printf "${CYN}➜${NC} Suppression des clients et de la configuration…\n"
  local ifc; ifc=$(ip route 2>/dev/null | awk '/default/{print $5; exit}')
  iptables -t nat -D POSTROUTING -s 10.66.66.0/24 -o "$ifc" -j MASQUERADE 2>/dev/null
  iptables -D INPUT -p udp --dport 51820 -j ACCEPT 2>/dev/null
  iptables -D FORWARD -i wg0 -j ACCEPT 2>/dev/null
  iptables -D FORWARD -o wg0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null
  command -v ufw >/dev/null 2>&1 && ufw --force delete allow 51820/udp >/dev/null 2>&1
  command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1
  rm -f "$WGCONF" "$DB"
  rm -rf "$NDIR"
  export DEBIAN_FRONTEND=noninteractive
  if rmdir /etc/wireguard 2>/dev/null; then
    apt-get purge -y wireguard wireguard-tools >/dev/null 2>&1
    apt-get autoremove -y >/dev/null 2>&1
  else
    warn "D'autres fichiers WireGuard ont été conservés dans /etc/wireguard."
  fi
  systemctl daemon-reload >/dev/null 2>&1
  [ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1
  ok "WireGuard a été désinstallé."
  pause
}

setup_menu(){
  while true; do
    banner; _edge "┏" "┓" "INSTALLER / DÉSINSTALLER WIREGUARD"
    if systemctl is-active --quiet wg-quick@wg0 2>/dev/null; then
      printf "${CYN}┃${NC} ${GRY}État actuel :${NC} ${GRN}installé et actif${NC}"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    else
      printf "${CYN}┃${NC} ${GRY}État actuel :${NC} ${RED}non installé${NC}"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    fi
    box_sep
    compact_menu_entry "1" "⬇️" "Installer / réinstaller"
    compact_menu_entry "2" "🗑️" "Désinstaller"
    compact_menu_entry "0" "⬅️" "Retour"
    bot
    ask "$(printf " ${WHT}➤ Choix :${NC} ")" c
    case "$c" in
      1) with_wg_lock install_wg ;;
      2) with_wg_lock uninstall_wg ;;
      0) break ;;
      *) warn "Invalide"; sleep 1 ;;
    esac
  done
}

with_wg_lock ensure_wg || exit 0
view_peer() {
  header; pick_peer || return; name="$PICK"
  local conf="$NDIR/$name.conf"
  clear; header
  if [ -s "$conf" ]; then
    ok "Configuration de $name"
    echo; printf "${GRY}--- Config client (.conf) ---${NC}\n"
    printf "${WHT}"; cat "$conf"; printf "${NC}\n"
  else
    err "Fichier de configuration introuvable pour $name."
  fi
  pause
}

cleanup_menu() {
  while true; do
    banner; _edge "┏" "┓" "NETTOYAGE WIREGUARD"
    local tot exp today c r nm pub ip n had_conf had_runtime
    today=$(date +%F)
    tot=$(grep -c '^### ' "$DB" 2>/dev/null); tot=${tot:-0}
    exp=$(awk -v d="$today" '/^### /{ if ($5!="" && $5<=d) c++ } END{print c+0}' "$DB" 2>/dev/null)
    printf "${CYN}┃${NC} ${GRY}Clients au total :${NC} ${WHT}%s${NC}    ${GRY}dont expirés :${NC} ${RED}%s${NC}" "$tot" "$exp"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    box_sep
    compact_menu_entry "1" "🧽" "Supprimer les clients expirés"
    compact_menu_entry "2" "💥" "Supprimer TOUS les clients"
    compact_menu_entry "0" "⬅️" "Retour"
    bot
    ask "$(printf " ${WHT}➤ Choix :${NC} ")" c
    case "$c" in
      1|2)
        if [ "$c" = 1 ]; then
          [ "$exp" -eq 0 ] && { warn "Aucun client expiré."; pause; continue; }
          printf "   ${YLW}Supprimer les %s client(s) expiré(s) ? (o/n) : ${NC}" "$exp"; ask "" r
          confirm "$r" || continue
          list=$(awk -v d="$today" '/^### /{ if ($5!="" && $5<=d) print $2 }' "$DB")
        else
          [ "$tot" -eq 0 ] && { warn "Aucun client."; pause; continue; }
          warn "Cela supprimera les $tot clients WireGuard. Action irréversible."
          printf "   ${RED}➤ Confirmer la suppression totale ? (o/n) : ${NC}"; ask "" r
          confirm "$r" || { warn "Annulé."; pause; continue; }
          list=$(awk '/^### /{print $2}' "$DB")
        fi
        n=0
        for nm in $list; do
          [ -z "$nm" ] && continue
          pub=$(awk -v x="$nm" '$2==x{print $3}' "$DB")
          ip=$(awk -v x="$nm" '$2==x{print $4}' "$DB")
          had_conf=0; had_runtime=0
          awk -v x="$nm" '$0=="# " x{f=1} END{exit !f}' "$WGCONF" 2>/dev/null && had_conf=1
          wg show wg0 peers 2>/dev/null | grep -Fxq "$pub" && had_runtime=1
          if [ "$had_runtime" = 1 ] && ! wg set wg0 peer "$pub" remove 2>/dev/null; then
            continue
          fi
          if ! wg_remove_conf_peer "$nm" 2>/dev/null; then
            [ "$had_runtime" = 1 ] && [ -n "$pub" ] && [ -n "$ip" ] && wg set wg0 peer "$pub" allowed-ips "$ip/32" >/dev/null 2>&1
            continue
          fi
          if ! wg_db_delete "$nm" 2>/dev/null; then
            [ "$had_conf" = 1 ] && wg_add_conf_peer "$nm" "$pub" "$ip" >/dev/null 2>&1 || true
            [ "$had_runtime" = 1 ] && [ -n "$pub" ] && [ -n "$ip" ] && wg set wg0 peer "$pub" allowed-ips "$ip/32" >/dev/null 2>&1
            continue
          fi
          rm -f "$NDIR/$nm.conf"
          n=$((n+1))
        done
        ok "$n client(s) supprimé(s)."; pause ;;
      0) break ;;
      *) warn "Invalide"; sleep 1 ;;
    esac
  done
}

