#!/bin/bash
# ============================================================
#  RHAFF SERVICE · WireGuard   (commande : menu-wg)
# ============================================================
source /etc/nvpanel/lib/ui.sh
ui_enter; trap ui_leave EXIT INT TERM HUP
[ "$EUID" -ne 0 ] && { err "Lance en root."; exit 1; }

WGCONF=/etc/wireguard/wg0.conf
DB=/etc/nvpanel/db/wireguard
NDIR=/etc/nvpanel/wg
SRV_IP=$(cat /etc/nvpanel/ip 2>/dev/null)
NET="10.66.66"
PORT=51820
mkdir -p /etc/nvpanel/db "$NDIR"
touch "$DB"

header(){ banner; _edge "┏" "┓" "GESTION WIREGUARD"; proto_dash wireguard wg wg; bot; }

install_wg() {
  header; printf "${CYN}➜${NC} Installation de WireGuard…\n"
  export DEBIAN_FRONTEND=noninteractive
  apt-get install -y wireguard qrencode >/dev/null 2>&1
  mkdir -p /etc/wireguard
  local spriv spub ifc
  spriv=$(wg genkey); spub=$(printf '%s' "$spriv" | wg pubkey)
  echo "$spub" > "$NDIR/server.pub"
  ifc=$(ip route | awk '/default/{print $5; exit}')
  cat > "$WGCONF" <<EOF
[Interface]
Address = $NET.1/24
ListenPort = $PORT
PrivateKey = $spriv
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o $ifc -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o $ifc -j MASQUERADE
EOF
  sed -i 's/^#\?net.ipv4.ip_forward.*/net.ipv4.ip_forward=1/' /etc/sysctl.conf
  grep -q '^net.ipv4.ip_forward=1' /etc/sysctl.conf || echo 'net.ipv4.ip_forward=1' >> /etc/sysctl.conf
  sysctl -p >/dev/null 2>&1
  systemctl enable --now wg-quick@wg0 >/dev/null 2>&1
  ok "WireGuard installé (port $PORT/udp)."; sleep 1
}

ensure_wg() {
  if ! command -v wg >/dev/null 2>&1 || [ ! -f "$WGCONF" ]; then
    ask " WireGuard n'est pas installé. L'installer ? (o/n) : " r
    confirm "$r" && install_wg || return 1
  fi
}

next_ip() {
  local last
  last=$(awk '{print $4}' "$DB" | awk -F. '{print $4}' | sort -n | tail -1)
  echo $(( ${last:-1} + 1 ))
}

add_peer() {
  if [ -n "$1" ]; then
    name="$1"; days="${2:-1}"
  else
  header; ask " Nom du client : " name
  [ -z "$name" ] && { err "Nom vide"; pause; return; }
  grep -q "^### $name " "$DB" && { err "Existe déjà"; pause; return; }
  ask " Durée (jours) : " days; [[ "$days" =~ ^[0-9]+$ ]] || days=30
  fi
  grep -q "^### $name " "$DB" && { err "Existe déjà"; pause; return; }
  local ppriv ppub ip exp spub
  ppriv=$(wg genkey); ppub=$(printf '%s' "$ppriv" | wg pubkey)
  ip="$NET.$(next_ip)"; exp=$(date -d "+$days days" +"%Y-%m-%d")
  spub=$(cat "$NDIR/server.pub")

  cat >> "$WGCONF" <<EOF

[Peer]
# $name
PublicKey = $ppub
AllowedIPs = $ip/32
EOF
  wg set wg0 peer "$ppub" allowed-ips "$ip/32" 2>/dev/null
  echo "### $name $ppub $ip $exp" >> "$DB"

  local conf="$NDIR/$name.conf"
  local _bn; _bn=$(head -1 /etc/banner 2>/dev/null | tr -d '\r\n')
  cat > "$conf" <<EOF
# ${_bn:-RHAFF SERVICE} - $name
[Interface]
PrivateKey = $ppriv
Address = $ip/32
DNS = 1.1.1.1

[Peer]
PublicKey = $spub
Endpoint = $SRV_IP:$PORT
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
EOF

  clear; header; ok "Client WireGuard créé (expire $(_fmtd "$exp"))"
  echo
  printf "${GRY}--- Config client (copie-la dans un fichier .conf) ---${NC}\n"
  cat "$conf"
  echo
  pause
}

list_peers() {
  local page=0 size=4 total pages start end i nm pub ip exp ct st color choice today
  mapfile -t _rows_wg < <(awk '/^### /{print $2"|"$3"|"$4"|"$5}' "$DB" 2>/dev/null)
  total=${#_rows_wg[@]}; [ "$total" -eq 0 ] && { header; warn "Aucun client WireGuard."; pause; return; }
  pages=$(( (total + size - 1) / size )); today=$(date +%F)
  while true; do
    header
    table_top
    printf "${CYN}┃${NC} ${WHT}%-12s %-12s %-11s %-7s %s${NC}" "COMPTE" "IP" "EXPIRE" "ÉTAT" "CONNECTÉ DEPUIS"; printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
    table_sep
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r nm pub ip exp <<< "${_rows_wg[$i]}"; ct=$(_wg_time "$pub")
      if [ -n "$exp" ] && { [ "$exp" \< "$today" ] || [ "$exp" = "$today" ]; }; then st="expiré"; color="$RED"; ct="—"; else st="actif"; color="$GRN"; fi
      if [ -n "$ct" ] && [ "$ct" != "—" ]; then
        printf "${CYN}┃${NC} %-12.12s %-12.12s %-11s ${color}%-7s${NC} %s ${CYN}(1 IP)${NC}" "$nm" "${ip:-?}" "$(_fmtd "${exp:-?}")" "$st" "$ct"
      else
        printf "${CYN}┃${NC} %-12.12s %-12.12s %-11s ${color}%-7s${NC} %s" "$nm" "${ip:-?}" "$(_fmtd "${exp:-?}")" "$st" "${ct:-—}"
      fi
      printf "\033[%dG${CYN}┃${NC}\n" "$((W + 2))"
      [ "$i" -lt $((end-1)) ] && table_sep
    done
    table_bot
    if [ "$pages" -le 1 ]; then pause; return; fi
    ask "   ➤ n suivante | p précédente | 0 retour : " choice
    case "${choice,,}" in n) [ "$page" -lt $((pages-1)) ] && page=$((page+1)) ;; p) [ "$page" -gt 0 ] && page=$((page-1)) ;; 0|'') return ;; *) warn "Invalide"; sleep 1 ;; esac
  done
}


_rand_name(){ printf 'test%s' "$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c4)"; }
_rand_pass(){ tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c8; }

trial_peer() {
  banner; center " 🎁  COMPTE TEST 24 H " "${BOLD}${WHT}"; line
  printf "   ${GRY}Génération d'un client WireGuard valable 24 heures…${NC}\n"
  add_peer "$(_rand_name)" 1
}

pick_peer() {
  PICK=""
  mapfile -t _pl < <(awk '/^### /{print $2"|"$4"|"$5}' "$DB" 2>/dev/null)
  if [ "${#_pl[@]}" -eq 0 ]; then err "Aucun client WireGuard."; pause; return 1; fi
  local page=0 size=6 total=${#_pl[@]} pages start end i nm ip ex n today st color
  pages=$(( (total + size - 1) / size )); today=$(date +%F)
  while true; do
    header; printf "   ${GRY}Clients WireGuard · page %d/%d :${NC}\n" "$((page+1))" "$pages"
    start=$((page*size)); end=$((start+size)); [ "$end" -gt "$total" ] && end=$total
    for ((i=start; i<end; i++)); do
      IFS='|' read -r nm ip ex <<< "${_pl[$i]}"; if [ -n "$ex" ] && { [ "$ex" \< "$today" ] || [ "$ex" = "$today" ]; }; then st="expiré"; color="$RED"; else st="actif"; color="$GRN"; fi
      printf "   ${WHT}%2d${NC}) %-16s ${GRY}%-14s exp %s${NC}  ${color}%s${NC}\n" "$((i+1))" "$nm" "$ip" "$(_fmtd "$ex")" "$st"
    done
    echo; if [ "$pages" -gt 1 ]; then ask "   ➤ N° | n suivante | p précédente | 0 retour : " n; else ask "   ➤ Numéro (0 = annuler) : " n; fi
    case "${n,,}" in n) [ "$pages" -gt 1 ] && [ "$page" -lt $((pages-1)) ] && page=$((page+1)); continue ;; p) [ "$pages" -gt 1 ] && [ "$page" -gt 0 ] && page=$((page-1)); continue ;; esac
    [[ "$n" =~ ^[0-9]+$ ]] || { err "Invalide"; sleep 1; continue; }; [ "$n" -eq 0 ] && return 1
    [ "$n" -ge 1 ] && [ "$n" -le "$total" ] || { err "Hors liste"; sleep 1; continue; }
    PICK="${_pl[$((n-1))]%%|*}"; return 0
  done
}

del_peer() {
  header; pick_peer || return; name="$PICK"
  printf "   ${YLW}Supprimer '%s' ? (o/n) : ${NC}" "$name"; ask "" c; confirm "$c" || { pause; return; }
  local pub; pub=$(awk -v n="$name" '$2==n{print $3}' "$DB")
  wg set wg0 peer "$pub" remove 2>/dev/null
  sed -i "/^# $name$/,/^AllowedIPs/d" "$WGCONF"
  sed -i "/^### $name /d" "$DB"
  rm -f "$NDIR/$name.conf"
  ok "$name supprimé"; pause
}

renew_peer() {
  header; pick_peer || return; name="$PICK"
  ask " Ajouter (jours) : " days
  [[ "$days" =~ ^[0-9]+$ ]] || { err "Invalide"; pause; return; }
  local exp; exp=$(date -d "+$days days" +"%Y-%m-%d")
  sed -i "s|^### $name \([^ ]*\) \([^ ]*\) .*|### $name \1 \2 $exp|" "$DB"
  ok "$name prolongé jusqu'au $(_fmtd "$exp")"; pause
}

uninstall_wg(){
  banner; center " 🗑️  DÉSINSTALLER WIREGUARD " "${BOLD}${RED}"; line
  warn "Cela supprime WireGuard et TOUS ses clients."
  printf "   ${GRY}Les autres protocoles ne sont pas touchés.${NC}\n\n"
  printf "   ${RED}➤ Confirmer la désinstallation ? (o/n) : ${NC}"; ask "" r
  confirm "$r" || { warn "Annulé."; pause; return; }

  printf "\n${CYN}➜${NC} Arrêt du service…\n"
  systemctl disable --now wg-quick@wg0 >/dev/null 2>&1
  printf "${CYN}➜${NC} Suppression des clients et de la configuration…\n"
  local ifc; ifc=$(ip route 2>/dev/null | awk '/default/{print $5; exit}')
  iptables -t nat -D POSTROUTING -s 10.66.66.0/24 -o "$ifc" -j MASQUERADE 2>/dev/null
  iptables -D INPUT -p udp --dport 51820 -j ACCEPT 2>/dev/null
  rm -rf /etc/wireguard "$NDIR" "$DB"
  export DEBIAN_FRONTEND=noninteractive
  apt-get purge -y wireguard wireguard-tools >/dev/null 2>&1
  apt-get autoremove -y >/dev/null 2>&1
  systemctl daemon-reload >/dev/null 2>&1
  [ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1
  ok "WireGuard a été désinstallé."
  pause
}

setup_menu(){
  while true; do
    banner; center " ⚙️  INSTALLER / DÉSINSTALLER WIREGUARD " "${BOLD}${WHT}"; line
    if systemctl is-active --quiet wg-quick@wg0 2>/dev/null; then
      printf "   ${GRY}État actuel :${NC} ${GRN}installé et actif${NC}\n\n"
    else
      printf "   ${GRY}État actuel :${NC} ${RED}non installé${NC}\n\n"
    fi
    entry "1" "⬇️" "Installer / réinstaller"
    entry "2" "🗑️" "Désinstaller"
    entry "0" "⬅️" "Retour"
    line
    ask "$(printf " ${WHT}➤ Choix :${NC} ")" c
    case "$c" in
      1) install_wg ;;
      2) uninstall_wg ;;
      0) break ;;
      *) warn "Invalide"; sleep 1 ;;
    esac
  done
}

ensure_wg || exit 0
view_peer() {
  header; pick_peer || return; name="$PICK"
  local conf="$NDIR/$name.conf"
  clear; header
  if [ -s "$conf" ]; then
    ok "Configuration de $name"
    echo; printf "${GRY}--- Config client (.conf) ---${NC}\n"
    printf "${WHT}"; cat "$conf"; printf "${NC}\n"
  else
    err "Fichier de configuration introuvable pour $name."
  fi
  pause
}

cleanup_menu() {
  while true; do
    banner; center " 🧹  NETTOYAGE WIREGUARD " "${BOLD}${WHT}"; line
    local tot exp today c r nm pub n
    today=$(date +%F)
    tot=$(grep -c '^### ' "$DB" 2>/dev/null); tot=${tot:-0}
    exp=$(awk -v d="$today" '/^### /{ if ($5!="" && $5<=d) c++ } END{print c+0}' "$DB" 2>/dev/null)
    printf "   ${GRY}Clients au total :${NC} ${WHT}%s${NC}    ${GRY}dont expirés :${NC} ${RED}%s${NC}\n\n" "$tot" "$exp"
    entry "1" "🧽" "Supprimer les clients expirés"
    entry "2" "💥" "Supprimer TOUS les clients"
    entry "0" "⬅️" "Retour"
    line
    ask "$(printf " ${WHT}➤ Choix :${NC} ")" c
    case "$c" in
      1|2)
        if [ "$c" = 1 ]; then
          [ "$exp" -eq 0 ] && { warn "Aucun client expiré."; pause; continue; }
          printf "   ${YLW}Supprimer les %s client(s) expiré(s) ? (o/n) : ${NC}" "$exp"; ask "" r
          confirm "$r" || continue
          list=$(awk -v d="$today" '/^### /{ if ($5!="" && $5<=d) print $2 }' "$DB")
        else
          [ "$tot" -eq 0 ] && { warn "Aucun client."; pause; continue; }
          warn "Cela supprimera les $tot clients WireGuard. Action irréversible."
          printf "   ${RED}➤ Confirmer la suppression totale ? (o/n) : ${NC}"; ask "" r
          confirm "$r" || { warn "Annulé."; pause; continue; }
          list=$(awk '/^### /{print $2}' "$DB")
        fi
        n=0
        for nm in $list; do
          [ -z "$nm" ] && continue
          pub=$(awk -v x="$nm" '$2==x{print $3}' "$DB")
          [ -n "$pub" ] && wg set wg0 peer "$pub" remove 2>/dev/null
          sed -i "/^# $nm$/,/^AllowedIPs/d" "$WGCONF" 2>/dev/null
          sed -i "/^### $nm /d" "$DB" 2>/dev/null
          rm -f "$NDIR/$nm.conf"
          n=$((n+1))
        done
        ok "$n client(s) supprimé(s)."; pause ;;
      0) break ;;
      *) warn "Invalide"; sleep 1 ;;
    esac
  done
}

while true; do
  header
  menu_box_top
  compact_menu_entry "1" "➕" "Ajouter un client"
  compact_menu_entry "2" "📋" "Lister les clients"
  compact_menu_entry "3" "🔍" "Revoir un client"
  compact_menu_entry "4" "♻️" "Prolonger un client"
  compact_menu_entry "5" "🗑️" "Supprimer un client"
  compact_menu_entry "6" "🧹" "Nettoyage des comptes"
  compact_menu_entry "7" "🎁" "Compte test 24 h"
  compact_menu_entry "8" "⚙️" "Installer / désinstaller"
  compact_menu_entry "0" "⬅️" "Retour"
  menu_box_bot
  ask "$(printf " ${WHT}➤ Choix :${NC} ")" o || break
  case "$o" in
    1) add_peer ;; 2) list_peers ;; 3) view_peer ;;
    4) renew_peer ;; 5) del_peer ;; 6) cleanup_menu ;; 7) trial_peer ;; 8) setup_menu ;;
    0) break ;; *) warn "Invalide"; sleep 1 ;;
  esac
done
