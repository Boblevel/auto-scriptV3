#!/bin/bash
# ============================================================
#  RHAFF SERVICE · installation SSTP   (install-sstp [auto])
#  SSTP = PPP dans du TLS. Le port 443 est déjà pris par nginx,
#  on écoute donc sur 4443 (modifiable).
# ============================================================
source /etc/nvpanel/lib/ui.sh
[ "$EUID" -ne 0 ] && { err "Lance en root."; exit 1; }
umask 077
AUTO=0; [ "$1" = "auto" ] && AUTO=1
NET=10.30.30
PORT=$(cat /etc/nvpanel/sstp_port 2>/dev/null); PORT=${PORT:-4443}
[[ "$PORT" =~ ^[0-9]+$ ]] && [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || PORT=4443
echo "$PORT" > /etc/nvpanel/sstp_port
IFACE=$(ip route 2>/dev/null | awk '/default/{print $5; exit}')
DOMAIN=$(cat /etc/nvpanel/domain 2>/dev/null)
IP=$(cat /etc/nvpanel/ip 2>/dev/null)
DIR=/etc/nvpanel/sstp; mkdir -p "$DIR"
if [ -n "$DOMAIN" ]; then
  [[ "$DOMAIN" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]] \
    && [ "${#DOMAIN}" -le 253 ] || { [ "$AUTO" = 0 ] && { err "Domaine invalide dans /etc/nvpanel/domain."; pause; }; exit 1; }
fi
[ -n "$IFACE" ] || { [ "$AUTO" = 0 ] && { err "Interface réseau par défaut introuvable."; pause; }; exit 1; }

[ "$AUTO" = 1 ] || { banner; center " INSTALLATION SSTP " "${BOLD}${WHT}"; line; printf "${CYN}➜${NC} Installation (1 à 3 minutes)…\n"; }
export DEBIAN_FRONTEND=noninteractive
echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections 2>/dev/null
echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections 2>/dev/null
apt-get install -y ppp openssl iptables iptables-persistent iproute2 curl ca-certificates >/dev/null 2>&1 || {
  [ "$AUTO" = 0 ] && { err "Installation des paquets SSTP échouée."; pause; }
  exit 1
}
# Le greffon sstp-client renforce la liaison cryptographique quand le paquet
# est disponible, mais son absence ne doit pas bloquer le serveur SSTP.
apt-get install -y sstp-client >/dev/null 2>&1 || true

# sstp-server 0.7.x exige Python >= 3.12. Ubuntu 20.04/22.04 et Debian
# 11/12 fournissent une version système plus ancienne : on utilise donc un
# environnement Python isolé et géré par uv, sans modifier Python du système.
UV=/opt/nvpanel-sstp-tools/uv
SSTP_PYTHON_DIR=/opt/nvpanel-sstp-python
SSTP_VENV=/opt/nvpanel-sstp
SSTP_VERSION=0.7.2
SSTP_LOG=/var/log/nvpanel-sstp-install.log
touch "$SSTP_LOG" 2>/dev/null; chmod 600 "$SSTP_LOG" 2>/dev/null
if [ ! -x "$UV" ]; then
  _uv_tmp=$(mktemp /tmp/nvpanel-uv.XXXXXX) || { [ "$AUTO" = 0 ] && { err "Fichier temporaire uv impossible."; pause; }; exit 1; }
  if ! curl -fsSL --connect-timeout 15 --max-time 180 https://astral.sh/uv/install.sh -o "$_uv_tmp" \
      || ! env UV_UNMANAGED_INSTALL=/opt/nvpanel-sstp-tools sh "$_uv_tmp" >>"$SSTP_LOG" 2>&1; then
    rm -f "$_uv_tmp"
    [ "$AUTO" = 0 ] && { err "Installation de l'environnement Python SSTP échouée (voir $SSTP_LOG)."; pause; }
    exit 1
  fi
  rm -f "$_uv_tmp"
fi
[ -x "$UV" ] || { [ "$AUTO" = 0 ] && { err "Le gestionnaire Python SSTP est introuvable."; pause; }; exit 1; }

_sstp_ready(){
  [ -x "$SSTP_VENV/bin/python" ] && [ -x "$SSTP_VENV/bin/sstpd" ] \
    && "$SSTP_VENV/bin/python" -c 'import importlib.metadata as m,sys; sys.exit(m.version("sstp-server") != "0.7.2")' >/dev/null 2>&1
}
_sstp_install_env(){
  rm -rf "$SSTP_VENV"
  env UV_PYTHON_INSTALL_DIR="$SSTP_PYTHON_DIR" "$UV" venv --python 3.12 --managed-python "$SSTP_VENV" >>"$SSTP_LOG" 2>&1 \
    && env UV_PYTHON_INSTALL_DIR="$SSTP_PYTHON_DIR" "$UV" pip install --python "$SSTP_VENV/bin/python" "sstp-server==$SSTP_VERSION" >>"$SSTP_LOG" 2>&1
}
SSTP_OLD=""
if ! _sstp_ready; then
  if [ -d "$SSTP_VENV" ]; then
    SSTP_OLD=$(mktemp -d /opt/.nvpanel-sstp-old.XXXXXX) \
      || { [ "$AUTO" = 0 ] && { err "Sauvegarde SSTP temporaire impossible."; pause; }; exit 1; }
    rmdir "$SSTP_OLD"
    mv "$SSTP_VENV" "$SSTP_OLD" \
      || { [ "$AUTO" = 0 ] && { err "Sauvegarde de l'environnement SSTP échouée."; pause; }; exit 1; }
  fi
  if ! _sstp_install_env; then
    # Les roues ARM64 ne sont pas toujours publiées : compilation locale en
    # secours avec les outils de construction de Debian/Ubuntu.
    apt-get install -y build-essential >/dev/null 2>&1 || true
    if ! _sstp_install_env; then
      rm -rf "$SSTP_VENV"
      [ -n "$SSTP_OLD" ] && mv "$SSTP_OLD" "$SSTP_VENV"
      [ "$AUTO" = 0 ] && { err "Installation du serveur SSTP échouée (voir $SSTP_LOG)."; pause; }
      exit 1
    fi
  fi
  if ! _sstp_ready; then
    rm -rf "$SSTP_VENV"
    [ -n "$SSTP_OLD" ] && mv "$SSTP_OLD" "$SSTP_VENV"
    [ "$AUTO" = 0 ] && { err "Validation du serveur SSTP échouée (voir $SSTP_LOG)."; pause; }
    exit 1
  fi
fi
SSTPD="$SSTP_VENV/bin/sstpd"

# certificat : Let's Encrypt si disponible, sinon auto-signé
if [ -n "$DOMAIN" ] && [ -f "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" ] \
   && [ -f "/etc/letsencrypt/live/$DOMAIN/privkey.pem" ]; then
  CRT="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"; KEY="/etc/letsencrypt/live/$DOMAIN/privkey.pem"
else
  _self_cn=${DOMAIN:-${IP:-rhaffservice}}
  if [ ! -s "$DIR/self.crt" ] || [ ! -s "$DIR/self.key" ] || [ "$(cat "$DIR/self.cn" 2>/dev/null)" != "$_self_cn" ]; then
    _crt_tmp=$(mktemp "$DIR/.self.crt.XXXXXX") || { [ "$AUTO" = 0 ] && { err "Certificat temporaire impossible."; pause; }; exit 1; }
    _key_tmp=$(mktemp "$DIR/.self.key.XXXXXX") || { rm -f "$_crt_tmp"; [ "$AUTO" = 0 ] && { err "Clé temporaire impossible."; pause; }; exit 1; }
    if ! openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
        -keyout "$_key_tmp" -out "$_crt_tmp" -subj "/CN=$_self_cn" >/dev/null 2>&1; then
      rm -f "$_crt_tmp" "$_key_tmp"; [ "$AUTO" = 0 ] && { err "Génération du certificat SSTP échouée."; pause; }; exit 1
    fi
    mv "$_key_tmp" "$DIR/self.key" && mv "$_crt_tmp" "$DIR/self.crt" \
      || { rm -f "$_crt_tmp" "$_key_tmp"; [ "$AUTO" = 0 ] && { err "Installation du certificat SSTP échouée."; pause; }; exit 1; }
    printf '%s\n' "$_self_cn" > "$DIR/self.cn"
    chmod 600 "$DIR/self.key" "$DIR/self.crt" "$DIR/self.cn" 2>/dev/null
  fi
  CRT="$DIR/self.crt"; KEY="$DIR/self.key"
fi

cat > /etc/ppp/options.sstpd <<'EOF'
name sstpd
require-mschap-v2
refuse-pap
refuse-chap
refuse-mschap
nodefaultroute
ms-dns 1.1.1.1
ms-dns 8.8.8.8
noccp
auth
mtu 1400
mru 1400
lock
proxyarp
EOF

if [ -n "$SSTPD" ]; then
  cat > /etc/systemd/system/nvpanel-sstp.service <<EOF
[Unit]
Description=RHAFF SERVICE SSTP
After=network.target
[Service]
ExecStart=$SSTPD -l 0.0.0.0 -p $PORT -c $CRT -k $KEY --local $NET.1 --remote $NET.0/24 --pppd-config /etc/ppp/options.sstpd
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload >/dev/null 2>&1
  systemctl enable nvpanel-sstp >/dev/null 2>&1
  systemctl restart nvpanel-sstp >/dev/null 2>&1
  sleep 2
fi

# routage + NAT + port
sed -i '/^net.ipv4.ip_forward/d' /etc/sysctl.conf
echo 'net.ipv4.ip_forward=1' >> /etc/sysctl.conf
sysctl -p >/dev/null 2>&1
_fw_ok=1
[ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" = 1 ] || _fw_ok=0
if [ -n "$IFACE" ]; then
  iptables -t nat -C POSTROUTING -s $NET.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null || \
    iptables -t nat -A POSTROUTING -s $NET.0/24 -o "$IFACE" -j MASQUERADE 2>/dev/null || _fw_ok=0
fi
iptables -C FORWARD -s $NET.0/24 -j ACCEPT 2>/dev/null || iptables -I FORWARD -s $NET.0/24 -j ACCEPT 2>/dev/null || _fw_ok=0
iptables -C FORWARD -d $NET.0/24 -j ACCEPT 2>/dev/null || iptables -I FORWARD -d $NET.0/24 -j ACCEPT 2>/dev/null || _fw_ok=0
iptables -C INPUT -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null || _fw_ok=0
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi active; then
  ufw allow "$PORT"/tcp >/dev/null 2>&1 || _fw_ok=0
fi
if [ "$_fw_ok" -ne 1 ] \
   || ! command -v netfilter-persistent >/dev/null 2>&1 \
   || ! netfilter-persistent save >/dev/null 2>&1; then
  [ "$AUTO" = 0 ] && { err "Routage ou pare-feu SSTP non applicable sur ce VPS."; pause; }
  exit 1
fi

LIS=0
systemctl is-active --quiet nvpanel-sstp 2>/dev/null \
  && ss -H -lnt "sport = :$PORT" 2>/dev/null | grep -q . && LIS=1
ROLLBACK_OK=0
if [ "$LIS" != 1 ] && [ -n "$SSTP_OLD" ] && [ -d "$SSTP_OLD" ]; then
  _failed_env=$(mktemp -d /opt/.nvpanel-sstp-failed.XXXXXX) || _failed_env=""
  [ -z "$_failed_env" ] || rmdir "$_failed_env"
  if [ -n "$_failed_env" ] && mv "$SSTP_VENV" "$_failed_env"; then
    if mv "$SSTP_OLD" "$SSTP_VENV"; then
      SSTP_OLD=""
      systemctl restart nvpanel-sstp >/dev/null 2>&1
      sleep 1
      if systemctl is-active --quiet nvpanel-sstp 2>/dev/null \
         && ss -H -lnt "sport = :$PORT" 2>/dev/null | grep -q .; then
        ROLLBACK_OK=1
      fi
      rm -rf "$_failed_env"
    else
      mv "$_failed_env" "$SSTP_VENV" 2>/dev/null || true
    fi
  fi
fi
if [ "$LIS" = 1 ]; then
  [ -n "$SSTP_OLD" ] && rm -rf "$SSTP_OLD"
  for _old in /opt/.nvpanel-sstp-old.*; do [ -d "$_old" ] && rm -rf "$_old"; done
fi
[ -x /usr/local/bin/nvpanel-conso ] && /usr/local/bin/nvpanel-conso setup >/dev/null 2>&1

if [ "$AUTO" = 1 ]; then
  if [ "$LIS" = 1 ]; then printf "  ${GRN}✔${NC} SSTP prêt (port %s).\n" "$PORT"; exit 0; fi
  if [ "$ROLLBACK_OK" = 1 ]; then printf "  ${YLW}!${NC} Mise à niveau SSTP échouée ; version précédente conservée.\n"; exit 1; fi
  printf "  ${YLW}!${NC} SSTP non activé.\n"; exit 1
fi
clear; banner
if [ "$LIS" = 1 ]; then
  center " ✔  SSTP OPÉRATIONNEL " "${BOLD}${GRN}"; line
  ok "Service actif, port $PORT en écoute."
  printf "\n   ${WHT}Réglages à donner au client :${NC}\n"
  printf "   ${GRY}• Serveur :${NC} ${WHT}%s:%s${NC}\n" "${DOMAIN:-$IP}" "$PORT"
  printf "   ${GRY}• Identifiants : ceux du compte créé dans le menu SSTP${NC}\n"
  [ "$CRT" = "$DIR/self.crt" ] && printf "   ${YLW}Certificat auto-signé : coche « ignorer le certificat » côté client.${NC}\n"
else
  center " ✘  SSTP NON ACTIVÉ " "${BOLD}${RED}"; line
  if [ "$ROLLBACK_OK" = 1 ]; then
    err "La mise à niveau a échoué ; la version SSTP précédente a été restaurée."
  else
    err "Le service SSTP n'a pas démarré (port $PORT non ouvert)."
  fi
  printf "   ${GRY}Diagnostic : journalctl -u nvpanel-sstp --no-pager -n 50${NC}\n"
  printf "   ${GRY}Tu peux utiliser L2TP à la place.${NC}\n"
fi
pause
